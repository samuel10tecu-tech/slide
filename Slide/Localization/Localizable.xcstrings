            "state": "translated",
            "value": "Přidej nebo odeber vymyšlenou stopu a podívej se na historii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erfundene Spur hinzufügen oder entfernen, damit du den Verlauf siehst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
