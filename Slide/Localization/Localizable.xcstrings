    "history.jumps.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accelerometer estimate. Useful for comparing, not a lab measurement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation à partir de l'accéléromètre. Pratique pour comparer, pas une mesure exacte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad z akcelerometru. Na porovnání, ne laboratorní měření."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzung vom Beschleunigungssensor. Gut zum Vergleichen, keine Labormessung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación del acelerómetro. Sirve para comparar, no es una medida de laboratorio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima dall'accelerometro. Utile per confrontare, non una misura di laboratorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "加速度センサーの推定。比べるには使えるが、実験室の測定ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가속도계 추정이야. 비교용이지, 실험실 측정은 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslag fra akselerometeret. Greit å sammenligne, ikke et laboratoriemål."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schatting van de versnellingsmeter. Handig om te vergelijken, geen labmeting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunek z akcelerometru. Do porównań, nie pomiar laboratoryjny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativa do acelerómetro. Serve para comparar, não é medida de laboratório."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattning från accelerometern. Bra att jämföra, inte ett labbvärde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自加速度计的估计。用来比较可以，不是实验室测量。"
          }
        }
      }
    },
    "history.sample.banner": {
      "extractionState": "manual",
