    "tracking.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at the bottom of the lift. Slide splits descents, lifts and rests on its own. The phone can stay in a pocket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre en bas de la remontée. Slide sépare les descentes, les remontées et les pauses. Le téléphone peut rester dans la poche."
          }
        }
      }
    },
    "tracking.baro.on": {
      "extractionState": "manual",
      "localizations": {
