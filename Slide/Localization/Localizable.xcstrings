    "history.map.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The basemap can stay blank until tiles are cached. Stats, the replay and the shared image do not need it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond de carte peut rester vide tant que les tuiles ne sont pas en cache. Les stats, le replay et l'image partagée n'en ont pas besoin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa může zůstat prázdná, dokud dlaždice nejsou v mezipaměti. Čísla, přehrání a obrázek je nepotřebují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte kann leer bleiben, bis Kacheln im Cache sind. Zahlen, Wiedergabe und das geteilte Bild brauchen sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa puede quedar en blanco hasta que haya teselas en caché. Las cifras, la repetición y la imagen no las necesitan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mappa può restare vuota finché le tessere non sono in cache. Numeri, replay e immagine condivisa non ne hanno bisogno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイルがキャッシュされるまで地図は真っ白でもいい。数字・再生・共有画像には不要。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일이 캐시되기 전에는 지도가 비어도 돼. 숫자, 재생, 공유 이미지는 필요 없어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartet kan være tomt til flisene er bufret. Tall, avspilling og det delte bildet trenger dem ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart kan leeg blijven tot de tegels in de cache staan. Cijfers, herhaling en het gedeelde beeld hebben ze niet nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa może być pusta, póki kafelki nie są w pamięci. Liczby, odtwarzanie i obraz ich nie potrzebują."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa pode ficar em branco até as peças estarem em cache. Os números, a repetição e a imagem não precisam delas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartan kan vara tom tills rutorna är cachade. Siffror, uppspelning och den delade bilden behöver dem inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底图在缓存之前可以是空白。数字、回放和分享图都不依赖它。"
          }
        }
      }
    },
    "history.map.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough GPS points to draw the track. The stats still count."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de points GPS pour dessiner la trace. Les stats restent valables."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Málo GPS bodů na stopu. Čísla se stejně počítají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig GPS-Punkte für die Spur. Die Zahlen zählen trotzdem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficientes puntos GPS para dibujar el track. Las cifras cuentan igual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi pochi punti GPS per il tracciato. I numeri contano lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線を描くGPS点が足りない。数字は有効。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선을 그릴 GPS 점이 부족해. 숫자는 그대로 유효해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For få GPS-punkter til sporet. Tallene teller likevel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te weinig gps-punten voor het spoor. De cijfers tellen toch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało punktów GPS na ślad. Liczby i tak się liczą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há pontos GPS suficientes para o traçado. Os números contam na mesma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För få GPS-punkter för spåret. Siffrorna räknas ändå."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS点不够画线。数字仍然算数。"
          }
        }
      }
    },
