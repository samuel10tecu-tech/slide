    "trick.cork-360.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An off-axis 360: the body tilts so the head passes below the feet for a moment. It is not a full flip, and it is still an inversion. Basics of the axis only, with a coach, after clean 360s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 360 désaxé : le corps s'incline et la tête passe un instant sous les pieds. Ce n'est pas un flip complet, et c'est quand même un inversé. Seulement les bases de l'axe, avec un coach, après des 360 propres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "360 mimo osu: tělo se nakloní a hlava na okamžik projde pod chodidly. Není to celý flip a pořád je to inverze. Jen základy osy, s trenérem, po čistých 360."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine 360 aus der Achse: der Körper neigt sich, und der Kopf geht einen Moment unter die Füße. Das ist kein voller Flip, und es ist trotzdem eine Inversion. Nur die Grundlagen der Achse, mit einem Coach, nach sauberen 360ern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 360 fuera de eje: el cuerpo se inclina y la cabeza pasa un momento bajo los pies. No es un flip completo y sigue siendo un invertido. Solo las bases del eje, con un coach, después de 360 limpios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 360 fuori asse: il corpo si inclina e la testa passa un momento sotto i piedi. Non è un flip intero, ed è comunque un invertito. Solo le basi dell'asse, con un coach, dopo 360 puliti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸の外れた360。体が傾き、頭が一瞬足より下を通る。完全なフリップではないが、それでもインバート。きれいな360のあと、コーチと、軸の基礎だけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축이 기운 360. 몸이 기울고 머리가 잠깐 발 아래로 지나가. 완전한 플립은 아니지만 그래도 인버트야. 깨끗한 360 다음, 코치와, 축의 기초만."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En 360 ute av aksen: kroppen heller og hodet går et øyeblikk under føttene. Det er ingen hel flip, og det er likevel en inversjon. Bare grunnlaget i aksen, med en trener, etter rene 360."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een 360 uit de as: het lichaam helt en het hoofd gaat even onder de voeten. Het is geen volle flip, en het is toch een inversie. Alleen de basis van de as, met een coach, na schone 360s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "360 poza osią: ciało się przechyla, a głowa na chwilę schodzi pod stopy. To nie pełny flip, a i tak inwersja. Tylko podstawy osi, z trenerem, po czystych 360."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 360 fora de eixo: o corpo inclina-se e a cabeça passa um momento por baixo dos pés. Não é um flip completo e continua a ser um invertido. Só as bases do eixo, com um treinador, depois de 360 limpos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En 360 ur axel: kroppen lutar och huvudet går ett ögonblick under fötterna. Det är ingen hel flip, och det är ändå en inversion. Bara grunderna i axeln, med en coach, efter rena 360."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏离轴线的 360：身体倾斜，头有一瞬间低于脚。这不是完整的空翻，但它仍然是翻转。干净的 360 之后，和教练一起，只学轴线的基础。"
          }
        }
      }
    },
    "trick.cork-360.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cork is not a style you add because a clip looked good. Off-axis plus too little rotation is a shoulder or a neck. Doubles, cork 720s and rodeos are not in this app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cork n'est pas un style que tu ajoutes parce qu'un clip était beau. Désaxé plus pas assez de rotation, c'est une épaule ou une nuque. Les doubles, cork 720 et rodeos ne sont pas dans cette app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cork není styl, který přidáš, protože klip vypadal dobře. Mimo osu plus málo rotace je rameno nebo krk. Dvojité, cork 720 a rodeo v téhle aplikaci nejsou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Cork ist kein Stil, den du dazunimmst, weil ein Clip gut aussah. Aus der Achse plus zu wenig Drehung ist eine Schulter oder ein Nacken. Doubles, Cork-720 und Rodeos sind nicht in dieser App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cork no es un estilo que añades porque un clip se veía bien. Fuera de eje más poca rotación es un hombro o un cuello. Los dobles, los cork 720 y los rodeos no están en esta app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cork non è uno stile che aggiungi perché un clip era bello. Fuori asse più poca rotazione è una spalla o una nuca. I doppi, i cork 720 e i rodeo non sono in questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップがきれいに見えたから足すスタイルではない。軸が外れて回転が足りないと、肩か首。ダブル、コーク720、ロデオはこのアプリにない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립이 멋져 보여서 더하는 스타일이 아니야. 축이 빠지고 회전이 부족하면 어깨나 목이야. 더블, 코크 720, 로데오는 이 앱에 없어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En cork er ingen stil du legger til fordi et klipp så fint ut. Ute av aksen pluss for lite rotasjon er en skulder eller en nakke. Doubles, cork 720 og rodeos er ikke i denne appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een cork is geen stijl die je toevoegt omdat een clip er goed uitzag. Uit de as plus te weinig draai is een schouder of een nek. Doubles, cork 720s en rodeo’s staan niet in deze app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cork nie jest stylem, który dodajesz, bo klip wyglądał dobrze. Poza osią plus za mało obrotu to ramię albo kark. Podwójne, cork 720 i rodeo nie są w tej aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cork não é um estilo que acrescentas porque um clip parecia bonito. Fora de eixo mais pouca rotação é um ombro ou um pescoço. Os duplos, os cork 720 e os rodeos não estão nesta app."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En cork är ingen stil du lägger till för att ett klipp såg bra ut. Ur axel plus för lite rotation är en axel eller en nacke. Dubblar, cork 720 och rodeos finns inte i den här appen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cork 不是因为一段视频好看就加上的风格。偏离轴线再加上转得不够，是肩膀或脖子。双周、cork 720 和 rodeo 不在这个应用里。"
          }
        }
      }
    },
    "trick.cork-360.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prerequisite: 360s you land without fighting, both directions, plus a stable grab. If the 360 is still a throw, you do not add cork."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-requis : des 360 que tu poses sans te battre, des deux côtés, plus un grab stable. Si le 360 est encore un jeté, tu n'ajoutes pas de cork."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podmínka: 360, které dopadáš bez boje, obě strany, plus stabilní grab. Je-li 360 pořád hod, cork nepřidáváš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voraussetzung: 360er, die du ohne Kampf landest, beide Richtungen, plus ein stabiler Grab. Wenn die 360 noch ein Wurf ist, fügst du keinen Cork hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requisito: 360 que aterrizas sin pelear, en ambos sentidos, más un grab estable. Si el 360 sigue siendo un lanzamiento, no añades cork."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Requisito: 360 che atterri senza lottare, da entrambi i lati, più un grab stabile. Se il 360 è ancora un lancio, non aggiungi cork."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件は、戦わずに着ける両方向の360と、安定したグラブ。360がまだ投げなら、コークは足さない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조건은 싸우지 않고 착지하는 양쪽 360, 그리고 안정된 그랩. 360이 아직 던지기면 코크를 더하지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forutsetning: 360 du lander uten å slåss, begge veier, pluss en stabil grab. Er 360 fortsatt et kast, legger du ikke til cork."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorwaarde: 360s die je landt zonder te vechten, beide kanten, plus een stabiele grab. Is de 360 nog een worp, dan voeg je geen cork toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warunek: 360, które lądujesz bez walki, obie strony, plus stabilny grab. Jeśli 360 wciąż jest rzutem, nie dodajesz corka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-requisito: 360 que aterras sem luta, nos dois sentidos, mais um grab estável. Se o 360 ainda é um lançamento, não acrescentas cork."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förutsättning: 360 du landar utan att kämpa, båda hållen, plus en stabil grab. Är 360 fortfarande ett kast lägger du inte till cork."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前提：两个方向的 360 你都能不挣扎地落地，再加上一个稳定的抓板。如果 360 还是一次甩，就不要加 cork。"
          }
        }
      }
    },
    "trick.cork-360.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The axis is learned on a trampoline or an airbag with a coach, not by 'leaning back' on an XL in the park."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'axe s'apprend sur un trampoline ou un airbag avec un coach, pas en « se penchant en arrière » sur un XL du park."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osu se učíš na trampolíně nebo airbagu s trenérem, ne „záklonem” na XL v parku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Achse lernst du auf einem Trampolin oder einem Airbag mit einem Coach, nicht indem du dich auf einem XL im Park „nach hinten lehnst“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El eje se aprende en un trampolín o un airbag con un coach, no «echándote atrás» en un XL del park."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'asse si impara su un trampolino o un airbag con un coach, non «inclinandoti indietro» su un XL del park."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸はコーチとトランポリンかエアバッグで覚える。パークのXLで「後ろに倒れる」ことではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축은 코치와 트램펄린이나 에어백에서 배워. 파크 XL에서 ‘뒤로 기울이는’ 게 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksen lærer du på en trampoline eller en airbag med en trener, ikke ved å lene deg bakover på en XL i parken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De as leer je op een trampoline of een airbag met een coach, niet door achterover te leunen op een XL in het park."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osi uczysz się na trampolinie albo airbagu z trenerem, nie „odchylając się” na XL w parku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O eixo aprende-se num trampolim ou num airbag com um treinador, não «inclinando-te para trás» num XL do park."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Axeln lär du dig på en studsmatta eller en airbag med en coach, inte genom att luta dig bakåt på en XL i parken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轴线在蹦床或气垫上和教练学，不是在公园的 XL 上“往后靠”。"
          }
        }
      }
    },
    "trick.cork-360.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pop up first, like a 360. The tilt is small and set by the coach. More axis is not the goal of the first reps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pop vers le haut d'abord, comme un 360. L'inclinaison est petite et placée par le coach. Plus d'axe n'est pas le but des premières répétitions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív pop nahoru, jako u 360. Náklon je malý a nastavený trenérem. Víc osy není cíl prvních opakování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du poppst zuerst nach oben, wie bei einer 360. Die Neigung ist klein und vom Coach gesetzt. Mehr Achse ist nicht das Ziel der ersten Wiederholungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haces pop hacia arriba primero, como un 360. La inclinación es pequeña y la pone el coach. Más eje no es el objetivo de las primeras repeticiones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai pop in alto prima, come un 360. L'inclinazione è piccola e messa dal coach. Più asse non è lo scopo delle prime ripetizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず360のように上へポップ。傾きは小さく、コーチが置く。最初の繰り返しで軸を増やすのが目的ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 360처럼 위로 팝해. 기울기는 작고 코치가 놓아. 첫 반복에서 축을 더하는 게 목표가 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du popper først opp, som en 360. Helningen er liten og satt av treneren. Mer akse er ikke målet med de første repetisjonene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je popt eerst omhoog, zoals een 360. De helling is klein en gezet door de coach. Meer as is niet het doel van de eerste herhalingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw pop w górę, jak przy 360. Nachylenie jest małe i ustawione przez trenera. Więcej osi nie jest celem pierwszych powtórzeń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazes pop para cima primeiro, como um 360. A inclinação é pequena e colocada pelo treinador. Mais eixo não é o objetivo das primeiras repetições."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du poppar först uppåt, som en 360. Lutningen är liten och satt av coachen. Mer axel är inte målet med de första repetitionerna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先像 360 一样向上起跳。倾斜很小，由教练来定。前几次的目标不是更多轴线。"
          }
        }
      }
    },
    "trick.cork-360.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot the landing. Under-rotation is the common injury: you come down on a shoulder or the upper back, sideways."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vois la réception. La sous-rotation est la blessure fréquente : tu arrives sur une épaule ou le haut du dos, de travers."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidíš dopad. Nedotočení je časté zranění: přijdeš na rameno nebo horní záda, bokem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh die Landung. Unterdrehen ist die häufige Verletzung: du kommst auf eine Schulter oder den oberen Rücken, seitlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve la recepción. Quedarte corto es la lesión frecuente: llegas sobre un hombro o la parte alta de la espalda, de lado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi la ricezione. La sotto-rotazione è l'infortunio frequente: arrivi su una spalla o sulla parte alta della schiena, di traverso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着地を見る。回転不足がよくある怪我。肩か背中の上に、横向きで落ちる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착지를 봐. 덜 도는 게 흔한 부상이야. 어깨나 등 위쪽으로, 옆으로 떨어져."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se landingen. Underrotasjon er den vanlige skaden: du kommer ned på en skulder eller øvre rygg, sidelengs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie de landing. Onderroteren is de gewone blessure: je komt op een schouder of de bovenrug, zijwaarts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widzisz lądowanie. Niedokręcenie to częsta kontuzja: lądujesz na ramieniu albo górze pleców, bokiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê a receção. Ficar curto é a lesão frequente: chegas sobre um ombro ou a parte de cima das costas, de lado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se landningen. Underrotation är den vanliga skadan: du kommer ner på en axel eller övre ryggen, snett."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看见落地区。转不够是常见的伤：侧着落到肩膀或上背。"
          }
        }
      }
    },
    "trick.cork-360.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bail: if you are not around, don't post an arm. Chin in, try to slide on the back, get off the line. If you felt late on the lip, you should have ridden straight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandon : si tu n'es pas autour, tu ne poses pas un bras. Menton rentré, tu essaies de glisser sur le dos, tu sors de la ligne. Si tu te sentais en retard sur la lèvre, tu aurais dû passer droit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdání: nejsi-li kolem, nestav ruku. Brada dovnitř, zkus klouzat na zádech, sjeď z linie. Cítil-li ses na hraně pozdě, měl jsi jet rovně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbruch: wenn du nicht herum bist, stell keinen Arm auf. Kinn rein, versuch auf dem Rücken zu rutschen, verlass die Linie. Wenn du dich an der Lippe spät gefühlt hast, hättest du geradeaus fahren sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abortar: si no estás alrededor, no plantes un brazo. Barbilla dentro, intenta deslizar sobre la espalda, sal de la línea. Si en el labio te sentías tarde, deberías haber pasado recto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinuncia: se non sei intorno, non pianti un braccio. Mento dentro, prova a scivolare sulla schiena, esci dalla linea. Se sul lip ti sentivi in ritardo, avresti dovuto passare dritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄：回りきっていなければ腕をつかない。あごを引き、背中で滑ろうとし、ラインを出る。リップで遅いと感じたなら、まっすぐ抜くべきだった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포기: 다 돌지 않았으면 팔을 짚지 마. 턱을 넣고 등으로 미끄러지려 하고, 라인에서 나와. 립에서 늦다고 느꼈다면 곧게 넘겼어야 해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt: er du ikke rundt, ikke sett ned en arm. Haken inn, prøv å skli på ryggen, forlat linjen. Kjente du deg sen på lippen, skulle du ha kjørt rett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbreken: als je niet rond bent, zet geen arm neer. Kin in, probeer op de rug te glijden, verlaat de lijn. Voelde je je laat op de lip, dan had je rechtdoor moeten rijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezygnacja: jeśli nie jesteś dookoła, nie stawiaj ręki. Broda w środku, spróbuj ślizgać się na plecach, zejdź z linii. Jeśli na krawędzi czułeś się późno, powinieneś był jechać prosto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desistir: se não estás à volta, não plantas um braço. Queixo para dentro, tenta deslizar nas costas, sai da linha. Se no lábio te sentias atrasado, devias ter passado a direito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt: är du inte runt, sätt inte i en arm. Hakan in, försök glida på ryggen, lämna linjen. Kände du dig sen på lippen skulle du ha åkt rakt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃：没转过来就不要撑出一只手臂。下巴收回，尽量用后背滑，离开线路。如果在唇沿上觉得晚了，你本来就该直着滑过去。"
          }
        }
      }
    },
    "trick.cork-360.step.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow only on a small jump you 360 cleanly, with the same coach who saw the airbag reps, and with the landing steep and empty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La neige seulement sur un petit saut que tu 360 proprement, avec le même coach qui a vu les répétitions sur airbag, et une réception pentue et vide."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sníh jen na malém skoku, který čistě 360, se stejným trenérem, který viděl opakování na airbagu, a se strmým prázdným dopadem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnee nur auf einem kleinen Sprung, den du sauber 360st, mit demselben Coach, der die Airbag-Wiederholungen gesehen hat, und mit steiler, leerer Landung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieve solo en un salto pequeño que haces en 360 limpio, con el mismo coach que vio las repeticiones en el airbag, y con una recepción empinada y vacía."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Neve solo su un salto piccolo che fai in 360 pulito, con lo stesso coach che ha visto le ripetizioni sull'airbag, e con una ricezione ripida e vuota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪は、きれいに360できる小さいジャンプだけ。エアバッグの繰り返しを見た同じコーチと。着地は急で、誰もいない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈은 깨끗하게 360하는 작은 점프에서만. 에어백 반복을 본 같은 코치와. 착지는 가파르고 비어 있어야 해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snø bare på et lite hopp du 360-er rent, med samme trener som så airbag-repetisjonene, og med en bratt, tom landing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneeuw alleen op een kleine jump die je schoon 360t, met dezelfde coach die de airbag-herhalingen zag, en met een steile, lege landing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śnieg tylko na małym skoku, który czysto 360-ujesz, z tym samym trenerem, który widział powtórzenia na airbagu, i ze stromym, pustym lądowaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neve só num salto pequeno que fazes em 360 limpo, com o mesmo treinador que viu as repetições no airbag, e com uma receção íngreme e vazia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snö bara på ett litet hopp du 360:ar rent, med samma coach som såg airbag-repetitionerna, och med en brant, tom landning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪上只在一个你能干净做 360 的小跳台上，和看过你气垫练习的同一位教练，落地区要陡、要空。"
          }
        }
      }
    },
    "trick.cork-360.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the straight 360 is your proudest trick, keep it. The cork can wait a season."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le 360 droit est ton trick le plus propre, garde-le. Le cork peut attendre une saison."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je-li rovná 360 tvůj nejčistší trik, nech ji. Cork může počkat sezonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die gerade 360 dein sauberster Trick ist, behalt sie. Der Cork kann eine Saison warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el 360 recto es tu trick más limpio, quédate con él. El cork puede esperar una temporada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il 360 dritto è il tuo trick più pulito, tienilo. Il cork può aspettare una stagione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐな360がいちばんきれいな技なら、それを残す。コークは一シーズン待てる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧은 360이 가장 깨끗한 트릭이면 그걸 둬. 코크는 한 시즌 기다릴 수 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis den rette 360-en er det reneste trikset ditt, behold den. Corken kan vente en sesong."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de rechte 360 je schoonste trick is, houd die. De cork kan een seizoen wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli proste 360 jest twoim najczystszym trikiem, zostań przy nim. Cork może poczekać sezon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o 360 a direito é o teu trick mais limpo, fica com ele. O cork pode esperar uma época."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om den raka 360:an är ditt renaste trick, behåll den. Corken kan vänta en säsong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果直的 360 是你最干净的动作，就留着它。Cork 可以等一个雪季。"
          }
        }
      }
    },
    "trick.cork-360.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helmet and back protector are on before the first off-axis attempt, including on an airbag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casque et dorsale sont mis avant le premier essai désaxé, y compris sur un airbag."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Helma a chránič zad jsou na hlavě a na zádech před prvním pokusem mimo osu, i na airbagu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm und Rückenprotektor sind an, bevor der erste Versuch aus der Achse kommt, auch auf einem Airbag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casco y espaldera puestos antes del primer intento fuera de eje, también en un airbag."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Casco e paraschiena sono messi prima del primo tentativo fuori asse, anche su un airbag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸を外す最初の一回の前に、エアバッグでもヘルメットとバックプロテクターを着ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축을 빼는 첫 시도 전에, 에어백에서도 헬멧과 등 보호대를 착용해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelm og ryggbeskytter er på før første forsøk ute av aksen, også på en airbag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm en rugbeschermer zitten vóór de eerste poging uit de as, ook op een airbag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kask i ochraniacz pleców są założone przed pierwszą próbą poza osią, także na airbagu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacete e proteção dorsal postos antes da primeira tentativa fora de eixo, também num airbag."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälm och ryggskydd är på innan första försöket ur axel, också på en airbag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次偏离轴线之前，包括在气垫上，头盔和护背都要戴上。"
          }
        }
      }
    }
  },
