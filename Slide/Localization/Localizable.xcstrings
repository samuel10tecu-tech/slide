    "history.share.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX for track apps, an image for Messages, a .slide file to keep every run. Older .glisse files still import."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX pour les apps de trace, image pour Messages, fichier .slide pour garder les descentes. Les anciens fichiers .glisse s'importent encore."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX pro aplikace stop, obrázek do Zpráv, soubor .slide s každým sjezdem. Staré soubory .glisse se pořád importují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX für Track-Apps, ein Bild für Nachrichten, eine .slide-Datei für jede Abfahrt. Alte .glisse-Dateien lassen sich weiter importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX para apps de tracks, una imagen para Mensajes, un archivo .slide para cada bajada. Los .glisse antiguos siguen importándose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX per le app di tracce, un'immagine per i messaggi, un file .slide per ogni discesa. I vecchi file .glisse si importano ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラック用にGPX、メッセージ用に画像、全本数は.slide。古い.glisseも読み込める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙 앱에는 GPX, 메시지에는 이미지, 활강 전체는 .slide. 예전 .glisse도 가져올 수 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX for spor-apper, et bilde for Meldinger, en .slide-fil for hver nedfart. Eldre .glisse-filer kan fortsatt importeres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX voor track-apps, een beeld voor Berichten, een .slide-bestand voor elke afdaling. Oude .glisse-bestanden importeren nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX do aplikacji śladów, obraz do Wiadomości, plik .slide z każdym zjazdem. Stare pliki .glisse nadal się importują."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX para apps de traçado, uma imagem para as Mensagens, um ficheiro .slide para cada descida. Os .glisse antigos ainda se importam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX för spår-appar, en bild för Meddelanden, en .slide-fil för varje åk. Äldre .glisse-filer går fortfarande att importera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轨迹用 GPX，消息用图片，每次滑降用 .slide。旧的 .glisse 仍能导入。"
          }
        }
      }
    },
