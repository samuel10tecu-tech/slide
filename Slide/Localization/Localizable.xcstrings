    "trick.nollie.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nollie pops from the tips. It is the ollie reversed, and it prepares switch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nollie pop depuis la spatule. C'est l'ollie à l'envers, et il prépare le switch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollie popuje ze špiček. Je to ollie obráceně a připravuje switch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Nollie poppt von den Spitzen. Er ist der Ollie umgekehrt und bereitet Switch vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nollie hace pop desde las puntas. Es el ollie al revés y prepara el switch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nollie poppa dalle punte. È l'ollie al contrario e prepara lo switch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノーリーは先からのポップ。オーリーの逆で、スイッチの準備になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "놀리는 앞끝에서 팝하는 거야. 올리의 반대이고, 스위치를 준비해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En nollie popper fra tuppene. Den er ollien bakvendt og forbereder switch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nollie popt vanaf de tips. Het is de ollie omgekeerd en het bereidt switch voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollie popuje z dziobów. To ollie na odwrót i przygotowuje switch."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nollie faz pop a partir das pontas. É o ollie ao contrário e prepara o switch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En nollie poppar från spetsarna. Den är ollien bakvänd och förbereder switch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollie 从板头起跳。它是反过来的 ollie，也是反脚的准备。"
          }
        }
      }
    },
    "trick.nollie.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much weight forward and you plant the tips. Keep the hands in front of the hips, not over your head."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de poids avant, et tu plantes les spatules. Garde les mains devant le bassin, pas au-dessus de la tête."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moc váhy vpředu a zapíchneš špičky. Ruce zůstanou před boky, ne nad hlavou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viel Gewicht vorn und du stichst die Spitzen ein. Die Hände bleiben vor den Hüften, nicht über dem Kopf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado peso delante y clavas las puntas. Las manos se quedan delante de las caderas, no sobre la cabeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo peso avanti e pianti le punte. Le mani restano davanti alle anche, non sopra la testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前に体重が多すぎると先を刺す。手は腰の前。頭の上ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞에 무게가 너무 많으면 앞끝을 박아. 손은 엉덩이 앞이지, 머리 위가 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mye vekt foran og du planter tuppene. Hendene blir foran hoftene, ikke over hodet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel gewicht voor en je plant de tips. De handen blijven voor de heupen, niet boven je hoofd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo ciężaru z przodu i wbijasz dzioby. Ręce zostają przed biodrami, nie nad głową."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso demais à frente e espetas as pontas. As mãos ficam à frente das ancas, não por cima da cabeça."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För mycket vikt framåt och du planterar spetsarna. Händerna stannar framför höfterna, inte över huvudet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重心太靠前就会插板头。手留在髋前面，不要举过头顶。"
          }
        }
      }
    },
    "trick.nollie.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a straight line, move the hips a little forward to load the front of the skis, without going over."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ligne droite, avance un peu le bassin pour charger l'avant des skis, sans passer par-dessus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V přímce posuň boky trochu dopředu, ať zatížíš předek, aniž přepadneš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer geraden Linie schiebst du die Hüften etwas nach vorn, um die Ski vorn zu laden, ohne drüberzukippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En línea recta mueves un poco las caderas adelante para cargar la parte delantera, sin pasarte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In linea retta sposti un po' le anche in avanti per caricare l'avanzo, senza passare oltre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐで腰を少し前に出し、先に荷重する。前に倒れすぎない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직선에서 엉덩이를 조금 앞으로 옮겨 앞쪽에 무게를 실어. 넘어가지 않게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I en rett linje flytter du hoftene litt frem for å lade fronten, uten å tippe over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In een rechte lijn schuif je de heupen iets naar voren om de voorkant te laden, zonder erover te kiepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W linii prostej przesuń biodra trochę do przodu, żeby obciążyć przód, bez przewrócenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em linha reta moves um pouco as ancas para a frente para carregar a frente, sem passar por cima."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I en rak linje flyttar du höfterna lite framåt för att ladda framskidorna, utan att tippa över."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直线上把髋稍往前移，给板头加压，但不要翻过去。"
          }
        }
      }
    },
    "trick.nollie.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop by extending the ankles. The tails rise first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop en dépliant les chevilles. La queue monte en premier."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popni natažením kotníků. Patky stoupají první."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Poppe, indem du die Knöchel streckst. Die Tails steigen zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz pop estirando los tobillos. Las colas suben primero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop estendendo le caviglie. Le code salgono per prime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足首を伸ばしてポップ。テールが先に上がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발목을 펴서 팝해. 테일이 먼저 올라와."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Popp ved å strekke anklene. Bakskiene stiger først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop door de enkels te strekken. De tails stijgen eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popnij, prostując kostki. Tyły idą w górę pierwsze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz pop estendendo os tornozelos. As caudas sobem primeiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Poppa genom att sträcka vrister. Bakskidorna stiger först."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展脚踝来起跳。板尾先起来。"
          }
        }
      }
    },
    "trick.nollie.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the knees up, skis flat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les genoux, skis à plat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvedni kolena, lyže naplocho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh die Knie hoch, Ski flach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las rodillas, esquís planos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta su le ginocchia, sci piatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝を上げ、スキーは平らに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎을 올리고 스키는 평평하게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk knærne opp, skiene flate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek de knieën op, ski’s vlak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnieś kolana, narty płasko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe os joelhos, esquis planos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra upp knäna, skidorna plana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提起膝盖，雪板放平。"
          }
        }
      }
    },
    "trick.nollie.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land in the middle of the ski."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose-toi au milieu du ski."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopadni na střed lyže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lande in der Mitte des Ski."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterriza en el centro del esquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterra al centro dello sci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーの真ん中で着く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스키 가운데로 착지해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Land i midten av skien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Land in het midden van de ski."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ląduj na środku narty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterra no meio do esqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Landa i mitten av skidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "落在雪板中间。"
          }
        }
      }
    },
    "trick.nollie.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate ollie and nollie on the flat until they are the same height."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne ollie et nollie sur le plat jusqu'à ce que les deux aient la même hauteur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Střídej ollie a nollie na rovině, dokud nejsou stejně vysoké."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle auf dem Flachen Ollie und Nollie, bis sie gleich hoch sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna ollie y nollie en el llano hasta que tengan la misma altura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna ollie e nollie sul piatto finché sono alti uguale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平らでオーリーとノーリーを交互に、同じ高さになるまで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평지에서 올리와 놀리를 번갈아, 높이가 같아질 때까지."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Veksle ollie og nollie på flaten til de er like høye."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel ollie en nollie op het vlakke tot ze even hoog zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zmianę ollie i nollie na płaskim, aż będą tej samej wysokości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna ollie e nollie no plano até terem a mesma altura."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växla ollie och nollie på flacket tills de är lika höga."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在平地上交替 ollie 和 nollie，直到一样高。"
          }
        }
      }
    },
    "trick.nollie.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nollie is easier to feel if you are already low before the pop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nollie est plus facile à sentir en étant très bas avant le pop."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollie se snáz cítí, když jsi před popem už nízko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Nollie ist leichter zu spüren, wenn du vor dem Pop schon tief bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nollie se siente mejor si ya estás bajo antes del pop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nollie si sente meglio se sei già basso prima del pop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップの前に低くいると、ノーリーは感じやすい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팝 전에 이미 낮으면 놀리가 더 잘 느껴져."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En nollie kjennes lettere hvis du allerede er lav før poppen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nollie voel je makkelijker als je al laag bent vóór de pop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollie łatwiej poczuć, gdy przed popem jesteś już nisko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nollie sente-se melhor se já estiveres baixo antes do pop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En nollie känns lättare om du redan är låg före poppen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起跳前已经蹲低，nollie 更容易感觉到。"
          }
        }
      }
    },
    "trick.nollie.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it leaves crooked, your shoulders turned. Keep them parallel to the skis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il part de travers, tes épaules ont tourné. Garde-les parallèles aux skis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když odjede nakřivo, ramena se otočila. Drž je rovnoběžně s lyžemi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn er schief abhebt, haben sich die Schultern gedreht. Halt sie parallel zu den Ski."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sale torcido, los hombros giraron. Mantenlos paralelos a los esquís."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se parte storto, le spalle hanno girato. Tienile parallele agli sci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "斜めに出るなら肩が回った。スキーと平行に保つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비뚤게 나가면 어깨가 돈 거야. 스키와 평행하게 둬."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis den drar skjevt, snudde skuldrene. Hold dem parallelle med skiene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als hij scheef weggaat, draaiden je schouders. Houd ze parallel aan de ski’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli odchodzi krzywo, ramiona się obróciły. Trzymaj je równolegle do nart."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sai torto, os ombros rodaram. Mantém-nos paralelos aos esquis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om den lämnar snett vreds axlarna. Håll dem parallella med skidorna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果歪着出去，是肩膀转了。让肩膀和雪板平行。"
          }
        }
      }
    },
