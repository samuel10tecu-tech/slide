          }
        }
      }
    },
    "trick.nose-butter.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nose butter slides on the tips and pivots the tails. Slow, on a soft bump."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nose butter : tu glisses sur la spatule et tu fais pivoter l'arrière. C'est lent, et ça se travaille sur une bosse douce."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nose butter klouže na špičkách a otáčí patky. Pomalu, na měkké bouli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Nose Butter gleitet auf den Spitzen und dreht die Tails. Langsam, auf einem weichen Buckel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nose butter desliza sobre las puntas y gira las colas. Lento, en un bache blando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nose butter scivola sulle punte e ruota le code. Lento, su una gobba morbida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノーズバターは先で滑り、テールを回す。ゆっくり、柔らかいコブで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노즈 버터는 앞끝으로 미끄러지며 테일을 돌려. 천천히, 부드러운 범프에서."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En nose butter sklir på tuppene og snur bakskiene. Sakte, på en myk hump."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nose butter glijdt op de tips en draait de tails. Langzaam, op een zachte bult."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nose butter ślizga się na dziobach i obraca tyły. Wolno, na miękkim garbie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nose butter desliza nas pontas e roda as caudas. Lento, numa lomba mole."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En nose butter glider på spetsarna och vrider bakskidorna. Långsamt, på en mjuk gupp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "板头黄油转是在板头上滑，让板尾转开。要慢，在柔软的雪包上。"
          }
        }
      }
    },
    "trick.nose-butter.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Butters happen away from other people. A sweeping tail hits someone's shins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les butters se font loin des autres. Une queue qui balaie accroche les tibias de quelqu'un."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttery děláš dál od ostatních. Mávající patka trefí něčí holeně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Butter macht man weg von anderen. Ein schwingender Tail trifft Schienbeine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los butters se hacen lejos de la gente. Una cola que barre golpea las espinillas de alguien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I butter si fanno lontano dagli altri. Una coda che spazza colpisce gli stinchi di qualcuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バターは人から離れて。振れたテールは誰かのすねに当たる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버터는 다른 사람 멀리서. 휩쓰는 테일은 누군가의 정강이를 친다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Butters gjøres unna andre. En feiende bakski treffer noens legg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Butters doe je weg van anderen. Een zwiepende tail raakt iemands schenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttery robisz z dala od innych. Miotający się tył trafia w czyjeś golenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os butters fazem-se longe das pessoas. Uma cauda que varre acerta nas canelas de alguém."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Butters görs bort från andra. En svepande bakskida träffar någons smalben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄油转要远离别人。甩开的板尾会打到别人的小腿。"
          }
        }
      }
    },
    "trick.nose-butter.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a small bump or a soft side of the piste, almost flat at the exit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve une petite bosse ou un côté de piste mou, presque plat en sortie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najdi malou bouli nebo měkký okraj sjezdovky, na výjezdu skoro rovný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such einen kleinen Buckel oder eine weiche Pistenseite, am Ausgang fast flach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca un bache pequeño o un lado blando de pista, casi plano a la salida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova una piccola gobba o un lato di pista morbido, quasi piatto in uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さいコブか、出口がほぼ平らな柔らかい斜面の端を探す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 범프나, 출구가 거의 평평한 부드러운 슬로프 가장자리를 찾아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn en liten hump eller en myk løypekant, nesten flat i utgangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek een kleine bult of een zachte pisterand, bijna vlak bij de uitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź mały garb albo miękki bok trasy, prawie płaski na wyjściu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra uma lomba pequena ou um lado mole da pista, quase plano à saída."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta en liten gupp eller en mjuk pistkant, nästan plan i utgången."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找一个小雪包，或者雪道边上软的地方，出口几乎是平的。"
          }
        }
      }
    },
    "trick.nose-butter.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move weight onto both tips, knees bent, back fairly upright."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance le poids sur les deux spatules, jambes fléchies, dos plutôt droit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přenese váhu na obě špičky, kolena pokrčená, záda dost rovně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlagere das Gewicht auf beide Spitzen, Knie gebeugt, Rücken ziemlich aufrecht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el peso a las dos puntas, rodillas flexionadas, espalda bastante recta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il peso su entrambe le punte, ginocchia piegate, schiena abbastanza dritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の先に体重を移す。膝は曲げ、背中はかなりまっすぐ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 앞끝에 무게를 옮겨. 무릎은 굽히고 등은 꽤 곧게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt vekten til begge tuppene, knær bøyd, ryggen ganske rett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het gewicht op beide tips, knieën gebogen, rug redelijk rechtop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś ciężar na oba dzioby, kolana ugięte, plecy dość prosto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa o peso para as duas pontas, joelhos fletidos, costas bastante direitas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta vikten till båda spetsarna, knän böjda, ryggen ganska rak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把重量移到两只板头上，膝盖弯曲，后背比较直。"
          }
        }
      }
    },
    "trick.nose-butter.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the tails break loose and turn. Guide with the feet and the eyes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse les queues décrocher et tourner. Tu guides avec les pieds et le regard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nech patky utrhnout a otočit. Vedeš chodidly a očima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Tails ausbrechen und drehen. Du führst mit den Füßen und den Augen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que las colas se suelten y giren. Guías con los pies y los ojos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che le code si stacchino e girino. Guidi con i piedi e gli occhi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テールを外して回す。足と目で導く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테일이 풀려 돌게 둬. 발과 눈으로 이끌어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La bakskiene slippe og snu. Du styrer med føttene og øynene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de tails losbreken en draaien. Je stuurt met de voeten en de ogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól tyłom puścić i obrócić się. Prowadzisz stopami i oczami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa as caudas soltarem-se e rodarem. Guias com os pés e os olhos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt bakskidorna släppa och vrida. Du styr med fötterna och ögonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让板尾松开并转动。用脚和眼睛引导。"
          }
        }
      }
    },
    "trick.nose-butter.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep enough speed that you don't stop in the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde assez de vitesse pour ne pas t'arrêter au milieu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drž dost rychlosti, ať se nezastavíš uprostřed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt genug Tempo, damit du in der Mitte nicht stehen bleibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén bastante velocidad para no pararte a la mitad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni abbastanza velocità da non fermarti a metà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途中で止まらない速さは残す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중간에 멈추지 않을 만큼 속도를 유지해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nok fart så du ikke stopper i midten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd genoeg snelheid zodat je niet middenin stilvalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostań przy prędkości, żeby nie stanąć w połowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém velocidade suficiente para não parares a meio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll tillräckligt med fart så du inte stannar i mitten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留够速度，不要停在中间。"
          }
        }
      }
    },
    "trick.nose-butter.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the tails back in line before the bump ends, and return the weight to the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les queues dans l'axe avant que la bosse finisse, et redescends le poids au milieu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrať patky do linie, než boule skončí, a váhu zpět doprostřed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring die Tails zurück in die Linie, bevor der Buckel endet, und das Gewicht wieder in die Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a poner las colas en línea antes de que acabe el bache y el peso al centro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta le code in linea prima che la gobba finisca e il peso di nuovo al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コブが終わる前にテールをラインへ戻し、体重を真ん中へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범프가 끝나기 전에 테일을 라인으로 되돌리고 무게는 가운데로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før bakskiene tilbake på linje før humpen tar slutt, og vekten til midten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng de tails terug in lijn voordat de bult eindigt, en het gewicht weer in het midden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź tyły z powrotem w linię, zanim garb się skończy, i ciężar na środek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz as caudas de volta à linha antes de a lomba acabar e o peso outra vez ao meio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För bakskidorna tillbaka i linje innan guppen tar slut och vikten till mitten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪包结束前把板尾收回来，重量回到中间。"
          }
        }
      }
    },
    "trick.nose-butter.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you go over the front, you were too far forward and too stiff. Stay low."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu passes par-dessus, tu étais trop avant ET trop raide. Reste bas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přepadneš přes špičku, byl jsi moc vpředu a moc tuhý. Zůstaň nízko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du über die Spitze gehst, warst du zu weit vorn und zu steif. Bleib tief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te vas por delante, estabas demasiado adelante y demasiado rígido. Quédate bajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se passi oltre la punta, eri troppo avanti e troppo rigido. Resta basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先を越えてしまうなら、前すぎて硬すぎた。低くいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞끝을 넘어가면 너무 앞이고 너무 뻣뻣한 거야. 낮게 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du går over tuppen, var du for langt fremme og for stiv. Bli lav."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je over de tip gaat, zat je te ver naar voren en te stijf. Blijf laag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli przechodzisz przez dziób, byłeś za daleko z przodu i za sztywny. Zostań nisko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se passas pela ponta, estavas longe demais à frente e rígido demais. Fica baixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du går över spetsen var du för långt fram och för stel. Stanna låg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果从前翻出去，是太靠前又太僵。保持低。"
          }
        }
      }
    },
    "trick.nose-butter.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for a small angle first, not a 360 butter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vise d'abord un petit angle, pas un 360 butter."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cil nejdřív malý úhel, ne butter 360."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel zuerst auf einen kleinen Winkel, nicht auf einen 360-Butter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta primero a un ángulo pequeño, no a un butter de 360."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta prima a un angolo piccolo, non a un butter da 360."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初は小さい角度。360バターではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음에는 작은 각도. 360 버터가 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikt først på en liten vinkel, ikke på en 360-butter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt eerst op een kleine hoek, niet op een 360-butter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Celuj najpierw w mały kąt, nie w butter 360."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta primeiro a um ângulo pequeno, não a um butter de 360."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikta först på en liten vinkel, inte på en 360-butter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先做一个小角度，不是 360 黄油转。"
          }
        }
      }
    },
    "trick.tail-butter.name": {
