    "profile.erase.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name and units stay. Nothing is copied online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prénom et les unités restent. Rien n'est copié en ligne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jméno a jednotky zůstanou. Nic se nekopíruje online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name und Einheiten bleiben. Nichts wird online kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre y las unidades se quedan. Nada se copia en línea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome e unità restano. Niente viene copiato online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と単位は残る。オンラインにはコピーしない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 단위는 남아. 온라인으로 복사되지 않아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navn og enheter blir. Ingenting kopieres på nett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naam en eenheden blijven. Niets wordt online gekopieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imię i jednostki zostają. Nic nie idzie do sieci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome e as unidades ficam. Nada é copiado online."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namn och enheter stannar. Ingenting kopieras online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字和单位会留下。不会复制到网上。"
          }
        }
      }
    },
    "profile.about.title": {
