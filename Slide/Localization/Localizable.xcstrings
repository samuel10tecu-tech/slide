    "notice.location.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is blocked. Turn it on in Settings to record a day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est bloquée. Active-la dans Réglages pour tracer une sortie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poloha je blokovaná. Zapni ji v Nastavení a nahraj den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ort ist blockiert. Schalte ihn in den Einstellungen ein, um einen Tag aufzuzeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación está bloqueada. Actívala en Ajustes para grabar un día."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è bloccata. Attivala in Impostazioni per registrare una giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報が拒否されている。一日を記録するなら設定でオンに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치가 막혀 있어. 하루를 기록하려면 설정에서 켜."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjon er blokkert. Slå den på i Innstillinger for å ta opp en dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie is geblokkeerd. Zet hem aan in Instellingen om een dag op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja jest zablokowana. Włącz ją w Ustawieniach, żeby nagrać dzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização está bloqueada. Liga-a nas Definições para registares um dia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plats är blockerad. Slå på den i Inställningar för att spela in en dag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位被拒绝了。要记录一天，就到设置里打开。"
          }
        }
      }
    },
    "notice.location.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without location, Slide can't measure speed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans la position, Slide ne peut pas mesurer la vitesse."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez polohy Slide nezměří rychlost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Ort kann Slide das Tempo nicht messen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ubicación Slide no mide la velocidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza posizione Slide non misura la velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報がないとSlideは速度を測れない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치가 없으면 Slide는 속도를 재지 못해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten posisjon kan ikke Slide måle farten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder locatie meet Slide geen snelheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez lokalizacji Slide nie zmierzy prędkości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem localização o Slide não mede a velocidade."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan plats kan Slide inte mäta farten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有定位，Slide 就测不了速度。"
          }
        }
      }
    },
