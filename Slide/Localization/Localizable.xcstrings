    "trick.rail-5050.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same idea as the box, but the rail is narrow. Only after a straight box feels easy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même idée que la box, mais le rail est étroit. Tu y vas seulement quand la box droite est devenue facile."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejný nápad jako box, ale rail je úzký. Až když je rovný box snadný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Idee wie die Box, aber das Rail ist schmal. Erst, wenn eine gerade Box leicht ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma idea que la box, pero el rail es estrecho. Solo cuando una box recta es fácil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stessa idea della box, ma il rail è stretto. Solo quando una box dritta è facile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボックスと同じ考え。ただしレールは細い。まっすぐなボックスが楽になってから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "박스와 같은 생각이야. 다만 레일은 좁아. 곧은 박스가 쉬워진 다음에."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme idé som boksen, men railen er smal. Først når en rett boks er lett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde idee als de box, maar de rail is smal. Pas als een rechte box makkelijk is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam pomysł co box, ale rail jest wąski. Dopiero gdy prosty box jest łatwy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma ideia da box, mas o carril é estreito. Só quando uma box direita é fácil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma idé som boxen, men railen är smal. Först när en rak box känns lätt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和盒子一样的想法，但杆更窄。等直的盒子觉得容易了再上。"
          }
        }
      }
    },
    "trick.rail-5050.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't learn on a tall round rail. A slip there cuts. Stay on a low tube or a narrow box."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de rail rond et haut pour apprendre. Une glissade dessus coupe. Reste sur un tube bas ou une box étroite."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuč se na vysokém kulatém railu. Skluz tam řeže. Zůstaň na nízké trubce nebo úzkém boxu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lern nicht auf einem hohen runden Rail. Ein Abrutschen dort schneidet. Bleib bei einem niedrigen Rohr oder einer schmalen Box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No aprendas en un rail redondo y alto. Un resbalón ahí corta. Quédate en un tubo bajo o una box estrecha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non imparare su un rail tondo e alto. Una scivolata lì taglia. Resta su un tubo basso o una box stretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高くて丸いレールで覚えない。そこでの滑りは切れる。低いチューブか細いボックスで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높고 둥근 레일에서 배우지 마. 거기서 미끄러지면 베인다. 낮은 튜브나 좁은 박스에 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke lær på en høy rund rail. En glidning der skjærer. Bli på et lavt rør eller en smal boks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer niet op een hoge ronde rail. Een slip daar snijdt. Blijf op een lage buis of een smalle box."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ucz się na wysokim okrągłym railu. Zjazd tam tnie. Zostań przy niskiej rurze albo wąskim boxie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não aprendas num carril redondo e alto. Um escorregão ali corta. Fica num tubo baixo ou numa box estreita."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär dig inte på en hög rund rail. En glidning där skär. Stanna på ett lågt rör eller en smal box."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要在又高又圆的杆上学习。在那里滑下去会割伤。留在低管子或窄盒子上。"
          }
        }
      }
    },
    "trick.rail-5050.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low rail, not too long, with an entry you can roll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail bas, pas trop long, avec un départ que tu peux rouler."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nízký rail, ne moc dlouhý, s nájezdem, který převalíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein niedriges Rail, nicht zu lang, mit einem Einstieg, den du rollen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rail bajo, no demasiado largo, con una entrada que puedas rodar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rail basso, non troppo lungo, con un ingresso che puoi rotolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低く、長すぎないレール。転がって入れる入口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮고 너무 길지 않은 레일. 굴려서 올라갈 수 있는 입구."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lav rail, ikke for lang, med en inngang du kan rulle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lage rail, niet te lang, met een instap die je kunt rollen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niski rail, niezbyt długi, z wjazdem, który możesz przetoczyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um carril baixo, não demasiado longo, com uma entrada que possas rolar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En låg rail, inte för lång, med ett insteg du kan rulla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一根低的、不太长的杆，入口可以滚上去。"
          }
        }
      }
    },
    "trick.rail-5050.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady speed. Aim the middle of both skis at the middle of the rail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitesse régulière. Tu vises le milieu du rail avec le milieu des deux skis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rovnoměrná rychlost. Miř středem obou lyží na střed railu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßiges Tempo. Ziel mit der Mitte beider Ski auf die Mitte des Rails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad constante. Apunta el centro de los dos esquís al centro del rail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità costante. Mira il centro di entrambi gli sci al centro del rail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速さは一定。両方のスキーの真ん中をレールの真ん中へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도는 일정하게. 두 스키의 가운데를 레일 가운데로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jevn fart. Sikt midten av begge skiene mot midten av railen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelijkmatige snelheid. Richt het midden van beide ski’s op het midden van de rail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Równa prędkość. Celuj środkiem obu nart w środek raila."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidade constante. Aponta o meio dos dois esquis ao meio do carril."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämn fart. Sikta mitten av båda skidorna mot mitten av railen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "速度均匀。用两只雪板的中间对准杆的中间。"
          }
        }
      }
    },
    "trick.rail-5050.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the exit. Feet flat, soft knees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde la sortie. Les pieds restent à plat, genoux souples."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívej se na výjezd. Chodidla naplocho, kolena měkce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau auf den Ausstieg. Füße flach, Knie weich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la salida. Pies planos, rodillas blandas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda l'uscita. Piedi piatti, ginocchia morbide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口を見る。足は平ら、膝は柔らかく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출구를 봐. 발은 평평하게, 무릎은 부드럽게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på utgangen. Føtter flate, knær myke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk naar de uitgang. Voeten plat, knieën zacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz na wyjście. Stopy płasko, kolana miękko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha a saída. Pés planos, joelhos moles."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta på utgången. Fötter plana, knän mjuka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看出口。脚放平，膝盖放松。"
          }
        }
      }
    },
    "trick.rail-5050.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you start to slip off, don't fight it: jump off to the side."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu commences à partir de côté, tu n'insistes pas : tu sautes dehors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když začneš sjíždět, nebojuj: seskoč stranou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du abrutschst, kämpfe nicht: spring zur Seite ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si empiezas a resbalar, no luches: salta hacia un lado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inizi a scivolare via, non insistere: salta di lato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外れ始めたら粘らない。横へ飛び降りる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미끄러지기 시작하면 버티지 마. 옆으로 뛰어내려."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du begynner å skli av, ikke kjemp: hopp av til siden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je begint weg te glijden, vecht niet: spring er zijwaarts af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zaczynasz zjeżdżać, nie walcz: zeskocz na bok."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se começas a escorregar, não lutas: saltas para o lado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du börjar glida av, kämpa inte: hoppa av åt sidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始滑下去就不要硬撑：往旁边跳下来。"
          }
        }
      }
    },
    "trick.rail-5050.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exit absorbs like a small landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie s'absorbe comme une petite réception."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výjezd pohltíš jako malý dopad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ausstieg federt wie eine kleine Landung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida se absorbe como una recepción pequeña."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'uscita si assorbe come una piccola ricezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口は小さい着地のように吸収する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출구는 작은 착지처럼 흡수해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgangen tas imot som en liten landing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgang absorbeer je als een kleine landing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjście amortyzujesz jak małe lądowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída absorve-se como uma receção pequena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgången dämpas som en liten landning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口像一次小落地一样缓冲。"
          }
        }
      }
    },
    "trick.rail-5050.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound should be continuous. A knock means a ski biting the edge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bruit doit être continu. Un à-coup = un ski qui mord le bord."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk má být souvislý. Rána znamená, že lyže kouše hranu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geräusch soll durchgehend sein. Ein Schlag heißt: ein Ski beißt die Kante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido debe ser continuo. Un golpe significa que un esquí muerde el canto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rumore deve essere continuo. Un colpo vuol dire che uno sci morde il bordo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音は途切れないほうがいい。コツンはスキーが縁を噛んだ音。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 이어져야 해. 탁 하면 스키가 가장자리를 문 거야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden skal være sammenhengende. Et dunk betyr at en ski biter kanten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluid moet doorlopend zijn. Een klap betekent dat een ski de rand bijt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk ma być ciągły. Uderzenie znaczy, że narta gryzie krawędź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O som deve ser contínuo. Um baque significa que um esqui morde a aresta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet ska vara sammanhängande. En stöt betyder att en skida biter i kanten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音应该连续。一下撞击说明雪板咬到了边。"
          }
        }
      }
    },
    "trick.rail-5050.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone if you are getting on crooked. You should not look at your skis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à quelqu'un de te dire si tu montes de travers. Toi, tu ne dois pas regarder tes skis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptej se někoho, jestli najíždíš nakřivo. Sám na lyže nekoukej."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag jemanden, ob du schief aufsteigst. Du selbst sollst nicht auf die Ski schauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a alguien si subes torcido. Tú no debes mirar los esquís."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a qualcuno se sali storto. Tu non devi guardare gli sci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "斜めに乗っていないか人に聞く。自分はスキーを見ない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비스듬히 올라가는지 다른 사람에게 물어. 너는 스키를 보지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør noen om du går på skjevt. Du skal ikke se på skiene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag iemand of je scheef opstapt. Zelf kijk je niet naar je ski’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj kogoś, czy wjeżdżasz krzywo. Sam nie patrz na narty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunta a alguém se sobes torto. Tu não deves olhar para os esquis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga någon om du går på snett. Du ska inte titta på skidorna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问别人你是不是歪着上去的。你自己不要看雪板。"
          }
        }
      }
    },
    "trick.absorb.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorb a hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorber un hit"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohltit hit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Hit abfedern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorber un hit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assorbire un hit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒットを吸収する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "히트 흡수하기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta imot et hopp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hit absorberen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamortyzować hit"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorver um hit"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta en hit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓冲一个起伏"
          }
        }
      }
    },
    "trick.absorb.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumps and lips are taken with the legs, not the back. Absorbing means staying on the snow when you want to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bosses et les lèvres se prennent avec les jambes, pas avec le dos. Absorber, c'est rester collé à la neige quand tu le veux."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Boule a hrany bereš nohama, ne zády. Pohltit znamená zůstat na sněhu, když chceš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buckel und Lippen nimmst du mit den Beinen, nicht mit dem Rücken. Abfedern heißt: auf dem Schnee bleiben, wenn du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baches y labios se toman con las piernas, no con la espalda. Absorber es quedarte en la nieve cuando quieres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gobbe e lip si prendono con le gambe, non con la schiena. Assorbire vuol dire restare sulla neve quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コブもリップも脚で取る。背中ではない。吸収は、いたいときに雪の上にいること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범프와 립은 다리로 받아. 등이 아니야. 흡수한다는 건 원할 때 눈 위에 남는 거야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Humper og lepper tar du med beina, ikke med ryggen. Å ta imot betyr å bli på snøen når du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulten en lippen neem je met de benen, niet met de rug. Absorberen betekent op de sneeuw blijven als je dat wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garby i krawędzie bierzesz nogami, nie plecami. Amortyzacja znaczy zostać na śniegu, kiedy chcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lombas e lábios tomam-se com as pernas, não com as costas. Absorver é ficares na neve quando queres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gupp och läppar tar du med benen, inte med ryggen. Att dämpa betyder att stanna på snön när du vill."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪包和唇沿用腿接，不用后背。缓冲就是：你想留在雪上的时候就留在雪上。"
          }
        }
      }
    },
    "trick.absorb.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Staying stiff through bumps tires the knees and ends sideways. Slow down if you can't keep up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester tendu sur une série de bosses fatigue les genoux et finit en travers. Ralentis si tu ne suis plus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuhá jízda přes boule unaví kolena a skončí bokem. Zpomal, když nestíháš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steif durch Buckel zu fahren ermüdet die Knie und endet seitlich. Werde langsamer, wenn du nicht mitkommst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir rígido por los baches cansa las rodillas y acaba de lado. Frena si no sigues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restare rigido sulle gobbe stanca le ginocchia e finisce di traverso. Rallenta se non tieni il ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コブを硬いまま通ると膝が疲れ、横向きで終わる。ついていけなければ遅くする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범프를 뻣뻣하게 지나면 무릎이 지치고 옆으로 끝나. 따라가지 못하면 속도를 줄여."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å være stiv gjennom humper sliter knærne og ender sidelengs. Senk farten hvis du ikke holder følge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stijf door bulten rijden vermoeit de knieën en eindigt zijwaarts. Word langzamer als je het niet bijhoudt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazda sztywno przez garby męczy kolana i kończy się bokiem. Zwolnij, jeśli nie nadążasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficar rígido nas lombas cansa os joelhos e acaba de lado. Abranda se não acompanhas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att vara stel genom gupp tröttar knäna och slutar snett. Sakta ner om du inte hänger med."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬着穿过雪包会累膝盖，最后变成侧着。跟不上就减速。"
          }
        }
      }
    },
    "trick.absorb.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the bump early."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère la bosse tôt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvidíš bouli brzy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh den Buckel früh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve el bache pronto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi la gobba presto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コブを早く見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범프를 일찍 봐."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se humpen tidlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie de bult vroeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz garb wcześnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê a lomba cedo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guppen tidigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早点看见雪包。"
          }
        }
      }
    },
    "trick.absorb.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just before it, you are already a little flexed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste avant, tu es déjà un peu fléchi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Těsně předtím už jsi trochu pokrčený."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz davor bist du schon etwas gebeugt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Justo antes ya estás un poco flexionado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco prima sei già un po' piegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その直前には、すでに少し曲げている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 전에는 이미 조금 굽혀 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett før er du allerede litt bøyd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Net ervoor ben je al een beetje gebogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuż przed jesteś już trochę ugięty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo antes já estás um pouco fletido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strax innan är du redan lite böjd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就在之前，你已经稍微弯曲了。"
          }
        }
      }
    },
    "trick.absorb.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the snow rises, bend and let the bump come into the legs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la neige monte, tu plies et tu laisses la bosse venir dans les jambes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když sníh stoupá, pokrčíš a necháš bouli vejít do nohou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Schnee steigt, beugst du und lässt den Buckel in die Beine kommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la nieve sube, flexionas y dejas que el bache entre en las piernas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la neve sale, pieghi e lasci la gobba entrare nelle gambe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪が上がったら曲げて、コブを脚の中に入れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈이 올라오면 굽히고, 범프가 다리 안으로 들어오게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når snøen stiger, bøyer du og lar humpen komme inn i beina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de sneeuw stijgt, buig je en laat je de bult in de benen komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy śnieg się wznosi, uginasz się i wpuszczasz garb w nogi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a neve sobe, fletes e deixas a lomba entrar nas pernas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När snön stiger böjer du och låter guppen komma in i benen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪面升高时弯曲，让雪包进入腿里。"
          }
        }
      }
    },
    "trick.absorb.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the top you can pop — or stay low if you don't want air."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut, tu peux pop — ou rester bas si tu ne veux pas décoller."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoře můžeš popnout — nebo zůstat nízko, když nechceš vzduch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben kannst du poppen — oder tief bleiben, wenn du keine Luft willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba puedes hacer pop, o quedarte bajo si no quieres aire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In cima puoi fare pop — o restare basso se non vuoi aria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頂上でポップできる。浮きたくなければ低いまま。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꼭대기에서 팝할 수 있어. 뜨고 싶지 않으면 낮게 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På toppen kan du poppe — eller bli lav hvis du ikke vil ha luft."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boven kun je poppen — of laag blijven als je geen lucht wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na górze możesz popnąć — albo zostać nisko, jeśli nie chcesz powietrza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No topo podes fazer pop — ou ficar baixo se não queres ar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På toppen kan du poppa — eller stanna låg om du inte vill ha luft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到顶你可以起跳，不想离雪就保持低。"
          }
        }
      }
    },
    "trick.absorb.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the trough, lengthen the legs to keep contact."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le creux, tu rallonges les jambes pour garder le contact."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V prohlubni natáhneš nohy, ať držíš kontakt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Mulde streckst du die Beine, um Kontakt zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el hoyo alargas las piernas para mantener el contacto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella conca allunghi le gambe per restare a contatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "くぼみでは脚を伸ばして接地を保つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "골에서는 다리를 늘려 접지를 유지해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I søkket strekker du beina for å holde kontakt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de kuil strek je de benen om contact te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W dołku wydłużasz nogi, żeby utrzymać kontakt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na cova alongas as pernas para manteres o contacto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I svackan sträcker du benen för att hålla kontakt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在凹处伸长腿，保持接触。"
          }
        }
      }
    },
    "trick.absorb.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think quiet. Less noise on the bumps means better absorption."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pense « silencieux ». Moins de bruit sur les bosses = mieux absorbé."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mysli na ticho. Méně hluku na boulích znamená lepší pohlcení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk an Ruhe. Weniger Lärm auf den Buckeln heißt bessere Absorption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piensa en silencio. Menos ruido en los baches significa mejor absorción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensa al silenzio. Meno rumore sulle gobbe vuol dire migliore assorbimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かさを考える。コブの音が少ないほど吸収がいい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용함을 생각해. 범프에서 소리가 적을수록 흡수가 좋아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenk stille. Mindre lyd på humpene betyr bedre demping."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk aan stilte. Minder lawaai op de bulten betekent beter absorberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Myśl o ciszy. Mniej hałasu na garbach to lepsza amortyzacja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensa em silêncio. Menos ruído nas lombas significa melhor absorção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänk tyst. Mindre ljud på guppen betyder bättre dämpning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想着安静。雪包上声音越小，缓冲越好。"
          }
        }
      }
    },
    "trick.absorb.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands stay in front of you. If they go back, the pop goes with them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mains restent devant toi. Si elles partent en arrière, le pop part avec."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruce zůstanou před tebou. Jdou-li dozadu, pop jde s nimi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hände bleiben vor dir. Gehen sie nach hinten, geht der Pop mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las manos se quedan delante. Si van atrás, el pop se va con ellas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mani restano davanti a te. Se vanno indietro, il pop va con loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手は前。後ろに行くとポップも一緒に行く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손은 앞에. 뒤로 가면 팝도 같이 가."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hendene blir foran deg. Går de bakover, følger poppen med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De handen blijven voor je. Gaan ze naar achteren, dan gaat de pop mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręce zostają przed tobą. Jeśli idą do tyłu, pop idzie z nimi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mãos ficam à tua frente. Se vão para trás, o pop vai com elas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Händerna stannar framför dig. Går de bakåt följer poppen med."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手留在你前面。手往后，起跳也跟着往后。"
          }
        }
      }
    },
    "trick.slide.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Box slide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide sur une box"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide na boxu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Box-Slide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide en una box"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide su una box"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボックススライド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "박스 슬라이드"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide på en boks"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide op een box"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide na boxie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide numa box"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide på en box"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "盒子横滑"
          }
        }
      }
    },
    "trick.slide.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The slide: skis across the box, like a skid set down on it. Almost flat at first, rotation very slow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le slide : les skis se mettent en travers de la box, comme un dérapage posé dessus. D'abord presque plat, très lent en rotation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide: lyže napříč boxem, jako smyk položený na něj. Nejdřív skoro naplocho, rotace velmi pomalá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Slide: die Ski quer auf der Box, wie ein darauf gesetzter Drift. Zuerst fast flach, die Drehung sehr langsam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El slide: los esquís de través en la box, como un derrape puesto encima. Primero casi plano, giro muy lento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo slide: gli sci di traverso sulla box, come una derapata posata sopra. Prima quasi piatto, rotazione lentissima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドはスキーをボックスに対して横に。その上に置いた横滑りのように。最初はほぼ平らで、回転はとても遅い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이드는 스키를 박스에 가로로. 위에 올려놓은 사이드슬립처럼. 처음에는 거의 평평하고 회전은 아주 천천히."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sliden: skiene på tvers av boksen, som en sladd satt ned på den. Først nesten flatt, rotasjonen veldig sakte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De slide: ski’s dwars op de box, als een drift die je erop zet. Eerst bijna vlak, de draai heel langzaam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide: narty w poprzek boxa, jak poślizg postawiony na nim. Najpierw prawie płasko, obrót bardzo wolny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O slide: os esquis de través na box, como uma derrapagem pousada em cima. Primeiro quase plano, rotação muito lenta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sliden: skidorna tvärs över boxen, som en sladd satt ner på den. Först nästan plant, rotationen mycket långsam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横滑：雪板横在盒子上，像把侧滑放上去。一开始几乎是平的，转动非常慢。"
          }
        }
      }
    },
    "trick.slide.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slide on a thin rail comes after weeks of boxes. A ski edge catches, and the fall is hard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un slide sur un rail fin vient après des semaines de box. Le bord de ski accroche, et la chute est sèche."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide na tenkém railu přijde po týdnech na boxech. Hrana chytne a pád je tvrdý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Slide auf einem dünnen Rail kommt nach Wochen auf Boxen. Eine Kante hakt, und der Sturz ist hart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un slide en un rail fino llega después de semanas de boxes. Un canto engancha y la caída es dura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno slide su un rail sottile arriva dopo settimane di box. Un bordo aggancia, e la caduta è secca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細いレールのスライドは、何週間もボックスをやってから。エッジが引っかかると落ち方は硬い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얇은 레일 슬라이드는 박스를 몇 주 한 다음이야. 에지가 걸리면 낙하는 딱딱해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En slide på en tynn rail kommer etter uker på bokser. En kant hugger, og fallet blir hardt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een slide op een dunne rail komt na weken op boxes. Een kant haakt, en de val is hard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide na cienkim railu przychodzi po tygodniach na boxach. Krawędź łapie, a upadek jest twardy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um slide num carril fino vem depois de semanas de boxes. Uma aresta agarra e a queda é seca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En slide på en tunn rail kommer efter veckor på boxar. En kant hugger och fallet blir hårt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "细杆上的横滑要在盒子上练好几周之后。雪板刃卡住，摔得很硬。"
          }
        }
      }
    },
    "trick.slide.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean 50-50 on this same box, both feet forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50 propre sur cette même box, dans les deux sens de pied avant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čistý 50-50 na stejném boxu, obě nohy vpředu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sauberer 50-50 auf derselben Box, beide Füße vorn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 50-50 limpio en la misma box, los dos pies delante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 50-50 pulito sulla stessa box, entrambi i piedi davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じボックスで、両足前のきれいな50-50。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 박스에서 두 발 모두 앞인 깨끗한 50-50."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ren 50-50 på samme boks, begge føttene foran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schone 50-50 op dezelfde box, beide voeten voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysty 50-50 na tym samym boxie, obie stopy z przodu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 50-50 limpo na mesma box, os dois pés à frente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ren 50-50 på samma box, båda fötterna fram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一个盒子上做干净的 50-50，两只脚都当过前脚。"
          }
        }
      }
    },
    "trick.slide.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get on in 50-50, then turn shoulders and hips together to about 90°."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte en 50-50, puis tourne les épaules et les hanches ensemble jusqu'à environ 90°."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najeď v 50-50 a otoč ramena a boky spolu asi na 90°."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steig im 50-50 auf, dann dreh Schultern und Hüften zusammen bis etwa 90°."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbete en 50-50 y gira hombros y caderas juntos hasta unos 90°."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali in 50-50, poi gira spalle e anche insieme fino a circa 90°."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50で乗ってから、肩と腰を一緒に約90°まで回す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50으로 올라간 다음 어깨와 엉덩이를 같이 약 90°까지 돌려."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå på i 50-50 og snu skuldre og hofter sammen til omtrent 90°."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stap op in 50-50 en draai schouders en heupen samen tot ongeveer 90°."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wjedź w 50-50, potem obróć ramiona i biodra razem do około 90°."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe em 50-50 e roda ombros e ancas juntos até cerca de 90°."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå på i 50-50 och vrid axlar och höfter tillsammans till ungefär 90°."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 50-50 上去，然后肩膀和髋一起转到大约 90°。"
          }
        }
      }
    },
    "trick.slide.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight stays in the middle of the skis. Don't sit downhill."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poids reste au milieu des skis. Tu ne t'assoies pas en aval."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váha zůstane uprostřed lyží. Nesedej si po svahu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gewicht bleibt in der Mitte der Ski. Setz dich nicht talwärts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El peso se queda en el centro de los esquís. No te sientes cuesta abajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peso resta al centro degli sci. Non sederti a valle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重はスキーの真ん中。谷側に座らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무게는 스키 가운데. 내리막 쪽으로 앉지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekten blir i midten av skiene. Ikke sett deg nedover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gewicht blijft in het midden van de ski’s. Ga niet bergafwaarts zitten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciężar zostaje na środku nart. Nie siadaj w dół stoku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O peso fica no meio dos esquis. Não te sentes para o vale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vikten stannar i mitten av skidorna. Sätt dig inte utför."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重量留在雪板中间。不要往山下坐。"
          }
        }
      }
    },
    "trick.slide.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the exit over the front shoulder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde la sortie par-dessus l'épaule avant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívej se na výjezd přes přední rameno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau über die vordere Schulter zum Ausstieg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la salida por encima del hombro delantero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda l'uscita sopra la spalla davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の肩ごしに出口を見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞 어깨 너머로 출구를 봐."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på utgangen over den fremre skulderen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk over de voorste schouder naar de uitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz na wyjście przez przednie ramię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha a saída por cima do ombro da frente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta på utgången över den främre axeln."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从前肩上方看出口。"
          }
        }
      }
    },
    "trick.slide.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the skis back in line before the end. A switch exit is later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les skis dans l'axe avant la fin. Sortir en switch, c'est pour plus tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrať lyže do linie před koncem. Výjezd switch přijde později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring die Ski zurück in die Linie, bevor es endet. Ein Switch-Ausstieg kommt später."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a poner los esquís en línea antes del final. Una salida en switch es para después."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta gli sci in linea prima della fine. Un'uscita in switch viene dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終わる前にスキーをラインへ戻す。スイッチでの出口はあと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝나기 전에 스키를 라인으로 되돌려. 스위치 출구는 나중이야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før skiene tilbake på linje før det tar slutt. En switch-utgang kommer senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng de ski’s terug in lijn vóór het einde. Een switch-uitgang komt later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź narty z powrotem w linię przed końcem. Wyjście switch jest na później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz os esquis de volta à linha antes do fim. Uma saída em switch fica para depois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För skidorna tillbaka i linje innan det tar slut. En switch-utgång kommer senare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束前把雪板转回顺向。反脚出去以后再说。"
          }
        }
      }
    },
    "trick.slide.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skid on the snow beside the box to feel 90° before you get on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dérape sur la neige à côté de la box pour sentir 90° avant de monter dessus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smykni na sněhu vedle boxu, ať cítíš 90°, než najedeš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifte auf dem Schnee neben der Box, um 90° zu spüren, bevor du aufsteigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Derrapa en la nieve junto a la box para sentir los 90° antes de subir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Derapa sulla neve accanto alla box per sentire i 90° prima di salirci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "乗る前に、ボックス横の雪で90°を感じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올라가기 전에 박스 옆 눈에서 90°를 느껴."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sladd på snøen ved siden av boksen for å kjenne 90° før du går på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drift op de sneeuw naast de box om 90° te voelen voordat je opstapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poślizgnij się na śniegu obok boxa, żeby poczuć 90°, zanim wjedziesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Derrapa na neve ao lado da box para sentires os 90° antes de subires."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sladda på snön bredvid boxen för att känna 90° innan du går på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上去之前，先在盒子旁边的雪上感觉 90°。"
          }
        }
      }
    },
    "trick.slide.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much rotation at the start puts you at 180 before the middle. Turn less, earlier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de rotation au départ te met à 180 avant le milieu. Tourne moins, plus tôt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moc rotace na začátku tě dá na 180 před středem. Toč míň, dřív."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viel Drehung am Anfang setzt dich vor der Mitte auf 180. Dreh weniger, früher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiada rotación al principio te pone a 180 antes del centro. Gira menos, antes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppa rotazione all'inizio ti mette a 180 prima del centro. Gira meno, prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に回しすぎると、真ん中の前に180になる。少なく、早く回す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음에 너무 돌면 가운데 전에 180이 돼. 덜, 더 일찍 돌려."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mye rotasjon i starten setter deg på 180 før midten. Snu mindre, tidligere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel draai aan het begin zet je op 180 vóór het midden. Draai minder, eerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo obrotu na starcie stawia cię na 180 przed środkiem. Kręć mniej, wcześniej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotação demais no início põe-te a 180 antes do meio. Roda menos, mais cedo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För mycket rotation i början sätter dig på 180 före mitten. Vrid mindre, tidigare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一开始转太多，到中间之前就变成 180。转少一点，早点转。"
          }
        }
      }
    },
