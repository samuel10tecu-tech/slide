        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day stays on this phone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La journée reste dans l'historique, sur ce téléphone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Den zůstane v tomto telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag bleibt auf diesem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día se queda en este teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La giornata resta su questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日のデータはこの電話に残る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이날 기록은 이 휴대폰에 남는다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen blir på denne telefonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dag blijft op deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień zostaje w tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia fica neste telemóvel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen stannar i den här telefonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天的记录留在这台手机上。"
          }
        }
      }
    },
    "tracking.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at the bottom of the lift. Slide splits descents, lifts and rests on its own. The phone can stay in a pocket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre en bas de la remontée. Slide sépare les descentes, les remontées et les pauses. Le téléphone peut rester dans la poche."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začni dole u vleku. Slide sám oddělí sjezdy, vleky a pauzy. Telefon může zůstat v kapse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte unten am Lift. Slide trennt Abfahrten, Lifte und Pausen von selbst. Das Telefon kann in der Tasche bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza abajo del remonte. Slide separa bajadas, remontes y pausas solo. El teléfono puede ir en el bolsillo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti in fondo all'impianto. Slide separa da solo discese, risalite e pause. Il telefono può stare in tasca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リフトの下で開始。Slideが滑走・リフト・休憩を自分で分ける。電話はポケットのままでいい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리프트 아래에서 시작해. Slide가 활강, 리프트, 휴식을 알아서 나눠. 휴대폰은 주머니에 둬도 돼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start nede ved heisen. Slide deler nedfarter, heiser og pauser selv. Telefonen kan ligge i lommen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start onderaan de lift. Slide splitst afdalingen, liften en rust zelf. De telefoon mag in je zak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij na dole wyciągu. Slide sam oddziela zjazdy, wyciągi i postoje. Telefon może zostać w kieszeni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa em baixo do teleférico. O Slide separa descidas, subidas e pausas sozinho. O telemóvel pode ficar no bolso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta nere vid liften. Slide delar åk, liftar och vila själv. Telefonen kan ligga i fickan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在缆车下方开始。Slide会自动分开滑降、缆车和休息。手机可以放在口袋里。"
          }
        }
      }
    },
