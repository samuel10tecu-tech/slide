    "trick.ollie.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ollie is a pop from the tails. It helps on a small hit, a bump, or leaving a box."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ollie est un pop depuis la queue des skis. Il sert sur un petit hit, une bosse, ou pour décoller une box."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollie je pop ze zadních částí. Pomůže na malém hitu, bouli nebo při sjezdu z boxu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ollie ist ein Pop von den Tails. Er hilft an einem kleinen Hit, einer Buckel oder beim Verlassen einer Box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ollie es un pop desde las colas. Sirve en un hit pequeño, un bache o al salir de una box."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ollie è un pop dalle code. Serve su un piccolo hit, una gobba o per uscire da una box."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーリーはテールからのポップ。小さいヒット、コブ、ボックスを出るときに使う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올리는 테일에서 하는 팝이야. 작은 히트, 범프, 박스에서 나올 때 써."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ollie er en pop fra bakskiene. Den hjelper på et lite hopp, en hump eller når du forlater en boks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ollie is een pop vanaf de tails. Hij helpt op een kleine hit, een bult of bij het verlaten van een box."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollie to pop z tyłów nart. Pomaga na małym hicie, garbiu albo przy zjeździe z boxa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ollie é um pop a partir das caudas. Ajuda num hit pequeno, numa lomba ou a sair de uma box."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ollie är en pop från bakskidorna. Den hjälper på ett litet hopp, en gupp eller när du lämnar en box."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollie 是从板尾起跳。小跳、雪包，或者离开盒子时用得上。"
          }
        }
      }
    },
    "trick.ollie.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn the ollie on the flat, away from people, before you take it to a lip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends l'ollie sur le plat, loin du monde, avant de l'emmener sur une lèvre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauč se ollie na rovině, dál od lidí, než ho vezmeš na hranu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lern den Ollie auf dem Flachen, weg von anderen, bevor du ihn an eine Lippe nimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende el ollie en el llano, lejos de la gente, antes de llevarlo a un labio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara l'ollie sul piatto, lontano dagli altri, prima di portarlo su un lip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リップに持っていく前に、人のいない平らでオーリーを覚える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "립으로 가져가기 전에, 사람 없는 평지에서 올리를 익혀."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lær ollien på flaten, unna folk, før du tar den til en lipp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer de ollie op het vlakke, weg van anderen, voordat je hem naar een lip meeneemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naucz się ollie na płaskim, z dala od ludzi, zanim zabierzesz go na krawędź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende o ollie no plano, longe das pessoas, antes de o levares a um lábio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär dig ollien på flacket, bort från folk, innan du tar den till en lipp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带到唇沿之前，先在没人的平地上学 ollie。"
          }
        }
      }
    },
    "trick.ollie.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a straight line, medium speed, flex a little."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ligne droite, à vitesse moyenne, fléchis un peu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V přímce, střední rychlost, trochu se pokrč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer geraden Linie, mittleres Tempo, beug dich etwas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En línea recta, a velocidad media, flexiona un poco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In linea retta, a velocità media, piegati un po'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まっすぐ、中くらいの速さで、少し曲げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직선으로, 중간 속도로, 조금 굽혀."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I en rett linje, middels fart, bøy litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In een rechte lijn, gemiddelde snelheid, buig een beetje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W linii prostej, średnia prędkość, ugnij się trochę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em linha reta, a velocidade média, flete um pouco."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I en rak linje, medelfart, böj lite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直线、中等速度，稍微弯曲。"
          }
        }
      }
    },
    "trick.ollie.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push the feet forward to load the tails, without sitting down."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse les pieds vers l'avant pour charger la queue, sans t'asseoir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuň chodidla dopředu, ať zatížíš patky, aniž si sedneš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieb die Füße nach vorn, um die Tails zu laden, ohne dich hinzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja los pies hacia delante para cargar las colas, sin sentarte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingi i piedi in avanti per caricare le code, senza sederti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座らずに足を前へ押し、テールに荷重する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앉지 말고 발을 앞으로 밀어 테일에 무게를 실어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyv føttene frem for å lade bakskiene, uten å sette deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duw de voeten naar voren om de tails te laden, zonder te gaan zitten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypchnij stopy do przodu, żeby obciążyć tyły, bez siadania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurra os pés para a frente para carregar as caudas, sem te sentares."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjut fötterna framåt för att ladda bakskidorna, utan att sätta dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把脚往前推，给板尾加压，但不要坐下。"
          }
        }
      }
    },
    "trick.ollie.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend ankles and knees at once. The tip rises, the tail follows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplie d'un coup chevilles et genoux. La spatule monte, la queue suit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Natáhni kotníky a kolena najednou. Špička stoupá, patka jde za ní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streck Knöchel und Knie auf einmal. Die Spitze steigt, der Tail folgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira tobillos y rodillas a la vez. La punta sube, la cola sigue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estendi caviglie e ginocchia insieme. La punta sale, la coda segue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足首と膝を一度に伸ばす。先が上がり、テールが続く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발목과 무릎을 한 번에 펴. 앞끝이 올라가고 테일이 따라와."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strekk ankler og knær samtidig. Tuppen stiger, bakskien følger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strek enkels en knieën tegelijk. De tip stijgt, de tail volgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyprostuj kostki i kolana naraz. Dziób idzie w górę, tył za nim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estende tornozelos e joelhos de uma vez. A ponta sobe, a cauda segue."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sträck vrister och knän på en gång. Spetsen stiger, bakskidan följer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时伸展脚踝和膝盖。板头升起，板尾跟上。"
          }
        }
      }
    },
    "trick.ollie.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the knees up so the skis stay with your feet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les genoux pour garder les skis collés aux pieds."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvedni kolena, ať lyže zůstanou u chodidel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh die Knie hoch, damit die Ski bei den Füßen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las rodillas para que los esquís se queden con los pies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta su le ginocchia così gli sci restano con i piedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝を上げて、スキーを足につけたままにする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎을 올려 스키가 발에 붙어 있게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk knærne opp så skiene blir hos føttene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek de knieën op zodat de ski’s bij je voeten blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnieś kolana, żeby narty zostały przy stopach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe os joelhos para os esquis ficarem com os pés."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra upp knäna så skidorna stannar vid fötterna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把膝盖提起来，让雪板跟着脚。"
          }
        }
      }
    },
    "trick.ollie.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land flat, both skis together, and absorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose-toi à plat, les deux skis ensemble, et absorbe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopadni naplocho, obě lyže spolu, a pohltí náraz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lande flach, beide Ski zusammen, und federe ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterriza plano, los dos esquís juntos, y absorbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterra piatto, entrambi gli sci insieme, e assorbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平らに、両方そろえて着き、吸収する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평평하게, 두 스키를 모아서 착지하고 흡수해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Land flatt, begge skiene sammen, og ta imot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Land vlak, beide ski’s samen, en absorbeer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ląduj płasko, obie narty razem, i zamortyzuj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterra plano, os dois esquis juntos, e absorve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Landa plant, båda skidorna tillsammans, och dämpa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平着落地，两只雪板在一起，再缓冲。"
          }
        }
      }
    },
    "trick.ollie.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If only the tip leaves the snow, you pulled with your back. The pop comes from the legs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si seule la spatule décolle, tu as tiré avec le dos. Le pop vient des jambes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se zvedne jen špička, táhl jsi zády. Pop jde z nohou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn nur die Spitze abhebt, hast du mit dem Rücken gezogen. Der Pop kommt aus den Beinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si solo despega la punta, tiraste con la espalda. El pop sale de las piernas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se decolla solo la punta, hai tirato con la schiena. Il pop viene dalle gambe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先だけ浮くなら、背中で引いている。ポップは脚から。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞끝만 뜨면 등으로 당긴 거야. 팝은 다리에서 나와."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis bare tuppen letter, dro du med ryggen. Poppen kommer fra beina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als alleen de tip loskomt, trok je met je rug. De pop komt uit de benen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli odrywa się tylko dziób, ciągnąłeś plecami. Pop idzie z nóg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se só a ponta levanta, puxaste com as costas. O pop vem das pernas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om bara spetsen lyfter drog du med ryggen. Poppen kommer från benen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果只有板头离雪，是用后背在拉。起跳来自腿。"
          }
        }
      }
    },
    "trick.ollie.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small clean ollie beats a big off-balance hop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit ollie propre bat un grand saut déséquilibré."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malý čistý ollie je lepší než velký nakloněný skok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner sauberer Ollie schlägt einen großen, schiefen Hopser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ollie pequeño y limpio vale más que un salto grande y desequilibrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo ollie pulito batte un grande salto sbilanciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さく決まったオーリーは、大きく崩れたホップに勝る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작고 깨끗한 올리가 크고 기운 홉보다 낫다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En liten ren ollie slår et stort skjevt hopp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kleine schone ollie verslaat een grote scheve hop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały czysty ollie jest lepszy niż duży, krzywy hop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ollie pequeno e limpo vale mais do que um salto grande e desequilibrado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En liten ren ollie slår ett stort ostadigt hopp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个小而干净的 ollie 胜过一个大而失衡的跳。"
          }
        }
      }
    },
    "trick.safety-grab.name": {
