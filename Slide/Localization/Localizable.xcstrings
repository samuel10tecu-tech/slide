    "trick.backflip.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backward flip. Expert, and only with supervision. Trampoline with a spotter, then water or an airbag, then snow with a coach. Never the first try on a resort kicker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flip vers l'arrière. Expert, et seulement avec quelqu'un qui surveille. Trampoline avec un pareur, puis eau ou airbag, puis neige avec un coach. Jamais le premier essai sur un kick de station."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto vzad. Pokročilé a jen pod dohledem. Trampolína se spotterem, pak voda nebo airbag, pak sníh s trenérem. Nikdy první pokus na kickeru ve středisku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Rückwärtssalto. Fortgeschritten, und nur unter Aufsicht. Trampolin mit Spotter, dann Wasser oder Airbag, dann Schnee mit einem Coach. Nie der erste Versuch auf einem Kicker im Skigebiet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salto hacia atrás. Avanzado, y solo con supervisión. Trampolín con spotter, luego agua o airbag, luego nieve con un coach. Nunca el primer intento en un kicker de estación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salto all'indietro. Avanzato, e solo con supervisione. Trampolino con un paratore, poi acqua o airbag, poi neve con un coach. Mai il primo tentativo su un kick di stazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろ向きのフリップ。上級で、見てくれる人がいるときだけ。スポッターとトランポリン、次に水かエアバッグ、それからコーチと雪。スキー場のキッカーで最初の一回は絶対にしない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤로 도는 플립. 고급이고, 감독이 있을 때만. 스포터와 트램펄린, 그다음 물이나 에어백, 그다음 코치와 눈. 스키장 키커에서 첫 시도는 절대 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et hopp bakover. Avansert, og bare med tilsyn. Trampoline med en spotter, så vann eller airbag, så snø med en trener. Aldri første forsøk på en kicker i anlegget."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een salto achterover. Gevorderd, en alleen onder toezicht. Trampoline met een spotter, dan water of airbag, dan sneeuw met een coach. Nooit de eerste poging op een kicker in het skigebied."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto w tył. Zaawansowane i tylko pod nadzorem. Trampolina ze spotterem, potem woda albo airbag, potem śnieg z trenerem. Nigdy pierwsza próba na kickerze w stacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um salto para trás. Avançado, e só com supervisão. Trampolim com um spotter, depois água ou airbag, depois neve com um treinador. Nunca a primeira tentativa num kick de estância."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett hopp bakåt. Avancerat, och bara med uppsikt. Studsmatta med en spotter, sedan vatten eller airbag, sedan snö med en coach. Aldrig första försöket på en kicker i anläggningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向后翻转。高级，而且只能有人看着。先和保护者上蹦床，然后水台或气垫，再有教练才上雪。绝不要在雪场跳台上第一次试。"
          }
        }
      }
    },
    "trick.backflip.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common mistakes: looking at the sky and never spotting, flipping late, reaching with the hands, under-rotating onto the neck, trying it tired or to impress someone. Bail-out: if you are not around, do not stick the arms. Chin in. Try to take it on the back and hips and slide, then get off the landing. If you are unsure before you leave the lip, do not pop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreurs fréquentes : regarder le ciel sans jamais voir la réception, flipper trop tard, tendre les mains, sous-rotater sur la nuque, le tenter fatigué ou pour impressionner. Abandon : si tu n'es pas autour, tu ne tends pas les bras. Menton rentré. Tu essaies de prendre ça sur le dos et les hanches et de glisser, puis tu sors de la réception. Si tu doutes avant de quitter la lèvre, tu ne pop pas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časté chyby: dívat se do nebe a nikdy nevidět dopad, flipovat pozdě, natahovat ruce, nedotočit na krk, zkoušet to unavený nebo aby někoho ohromil. Vzdání: nejsi-li kolem, nestrkej ruce. Brada dovnitř. Zkus to vzít na záda a boky a klouzat, pak sjeď z dopadu. Nejsi-li si jistý, než opustíš hranu, nepopuj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufige Fehler: in den Himmel schauen und nie die Landung sehen, zu spät flippen, mit den Händen greifen, unterdrehen auf den Nacken, es müde oder um jemanden zu beeindrucken versuchen. Abbruch: wenn du nicht herum bist, streck die Arme nicht. Kinn rein. Versuch, es auf Rücken und Hüften zu nehmen und zu rutschen, dann weg von der Landung. Wenn du unsicher bist, bevor du die Lippe verlässt, poppe nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Errores frecuentes: mirar el cielo y no ver nunca la recepción, voltear tarde, estirar las manos, quedarte corto sobre el cuello, intentarlo cansado o para impresionar. Abortar: si no estás alrededor, no estires los brazos. Barbilla dentro. Intenta tomarlo en la espalda y las caderas y deslizar, luego sal de la recepción. Si dudas antes de dejar el labio, no hagas pop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errori frequenti: guardare il cielo e non vedere mai la ricezione, flippare tardi, allungare le mani, sotto-ruotare sul collo, provarci stanco o per impressionare. Rinuncia: se non sei intorno, non tendi le braccia. Mento dentro. Prova a prenderlo su schiena e anche e a scivolare, poi esci dalla ricezione. Se hai un dubbio prima di lasciare il lip, non fai pop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よくある失敗：空を見て着地を見ない、遅くフリップする、手を出す、首に回転不足、疲れてやる、誰かに見せようとする。放棄：回りきっていなければ腕を出さない。あごを引く。背中と腰で受けて滑り、着地から出る。リップを離れる前に不安ならポップしない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔한 실수: 하늘만 보고 착지를 못 봄, 늦게 플립, 손을 뻗음, 목으로 덜 돌음, 피곤하거나 남에게 보이려고 시도. 포기: 다 돌지 않았으면 팔을 뻗지 마. 턱을 넣어. 등과 엉덩이로 받고 미끄러진 다음 착지에서 나와. 립을 떠나기 전에 불안하면 팝하지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanlige feil: se mot himmelen og aldri se landingen, flippe sent, strekke hendene, underrotere på nakken, prøve sliten eller for å imponere. Avbryt: er du ikke rundt, ikke stikk ut armene. Haken inn. Prøv å ta det på rygg og hofter og skli, så av landingen. Er du usikker før du forlater lippen, ikke popp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veelgemaakte fouten: naar de lucht kijken en de landing nooit zien, te laat flippen, met de handen reiken, onderroteren op de nek, het moe proberen of om iemand te imponeren. Afbreken: als je niet rond bent, steek de armen niet. Kin in. Probeer het op rug en heupen te nemen en te glijden, daarna van de landing af. Ben je onzeker voordat je de lip verlaat, pop dan niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Częste błędy: patrzenie w niebo i niewidzenie lądowania, zbyt późny flip, wyciąganie rąk, niedokręcenie na kark, próba zmęczonym albo żeby zaimponować. Rezygnacja: jeśli nie jesteś dookoła, nie wystawiaj rąk. Broda w środku. Spróbuj wziąć to na plecy i biodra i się ślizgać, potem zejdź z lądowania. Jeśli nie jesteś pewien, zanim opuścisz krawędź, nie rób popu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Erros frequentes: olhar o céu e nunca ver a receção, fazer flip tarde, esticar as mãos, ficar curto sobre o pescoço, tentar cansado ou para impressionar. Desistir: se não estás à volta, não esticas os braços. Queixo para dentro. Tenta levar isso nas costas e nas ancas e deslizar, depois sai da receção. Se tiveres dúvida antes de deixar o lábio, não faças pop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanliga misstag: titta mot himlen och aldrig se landningen, flippa sent, sträcka händerna, underrotera på nacken, försöka trött eller för att imponera. Avbryt: är du inte runt, stick inte ut armarna. Hakan in. Försök ta det på rygg och höfter och glida, lämna sedan landningen. Är du osäker innan du lämnar lippen, poppa inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常见错误：看天空、始终看不见落地区，翻得太晚，伸手去够，转不够落到脖子上，累了还试，或者为了给人看。放弃：如果没转过来，不要伸出手臂。下巴收回。尽量用后背和髋接住并滑出去，然后离开落地区。离开唇沿之前拿不准，就不要起跳。"
          }
        }
      }
    },
    "trick.backflip.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the trampoline, a coach sets the hips and teaches a layout or the tuck they want. You do not invent it from a video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le trampoline, un coach place les hanches et enseigne le layout ou le groupé qu'il veut. Tu ne l'inventes pas depuis une vidéo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na trampolíně trenér nastaví boky a učí layout nebo skrčení, které chce. Nevymýšlíš to z videa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Trampolin setzt ein Coach die Hüften und zeigt das Layout oder den Tuck, den er will. Du erfindest es nicht aus einem Video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el trampolín un coach coloca las caderas y enseña el layout o el agrupado que quiere. No lo inventas desde un vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul trampolino un coach mette le anche e insegna il layout o il tuck che vuole. Non lo inventi da un video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランポリンではコーチが腰を置き、欲しいレイアウトかタックを教える。動画から自分で作らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트램펄린에서 코치가 엉덩이를 놓고, 원하는 레이아웃이나 턱을 가르쳐. 영상으로 만들지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På trampolinen setter en trener hoftene og lærer bort layouten eller tucken de vil. Du finner den ikke opp fra en video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de trampoline zet een coach de heupen en leert de layout of de tuck die hij wil. Je verzint het niet uit een video."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na trampolinie trener ustawia biodra i uczy layoutu albo tucku, którego chce. Nie wymyślasz tego z filmu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No trampolim um treinador coloca as ancas e ensina o layout ou o agrupado que quer. Não o inventas a partir de um vídeo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På studsmattan sätter en coach höfterna och lär ut den layout eller tuck hen vill. Du hittar inte på den från en video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在蹦床上，教练摆好髋，教他要的直体或团身。不要从视频里自己编。"
          }
        }
      }
    },
    "trick.backflip.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn to spot: as you leave, the eyes find the landing over the shoulder early. If you only see sky, you are late."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends à spotter : au départ, les yeux trouvent la réception par-dessus l'épaule, tôt. Si tu ne vois que le ciel, tu es en retard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauč se dívat: při odrazu oči brzy najdou dopad přes rameno. Vidíš-li jen nebe, jsi pozdě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lern zu spotten: beim Absprung finden die Augen früh über die Schulter die Landung. Siehst du nur Himmel, bist du spät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende a mirar: al salir, los ojos encuentran pronto la recepción por encima del hombro. Si solo ves cielo, vas tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara a vedere: alla partenza gli occhi trovano presto la ricezione sopra la spalla. Se vedi solo cielo, sei in ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポットを覚える。出るとき、目が早く肩ごしに着地を見つける。空しか見えないなら遅い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스팟을 배워. 떠날 때 눈이 일찍 어깨 너머로 착지를 찾아. 하늘만 보이면 늦은 거야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lær å se: når du drar, finner øynene landingen tidlig over skulderen. Ser du bare himmel, er du sen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer spotten: bij het afzetten vinden de ogen vroeg de landing over de schouder. Zie je alleen lucht, dan ben je laat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naucz się patrzeć: przy odbiciu oczy wcześnie znajdują lądowanie przez ramię. Jeśli widzisz tylko niebo, jesteś za późno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende a ver: à saída os olhos encontram cedo a receção por cima do ombro. Se só vês céu, estás atrasado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär dig spana: när du lämnar hittar ögonen landningen tidigt över axeln. Ser du bara himmel är du sen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学看点：离开时，眼睛早点从肩膀上方找到落地区。如果只看见天空，你晚了。"
          }
        }
      }
    },
    "trick.backflip.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The set is up and slightly back, from the pop, not a desperate throw of the head on the lip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le set part vers le haut et un peu en arrière, depuis le pop, pas un jeté désespéré de la tête sur la lèvre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Set jde nahoru a mírně vzad, z popu, ne ze zoufalého hodu hlavou na hraně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Set geht nach oben und leicht nach hinten, aus dem Pop, nicht aus einem verzweifelten Kopfwurf an der Lippe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El set va hacia arriba y un poco atrás, desde el pop, no desde un lanzamiento desesperado de la cabeza en el labio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il set va in alto e un po' indietro, dal pop, non da un lancio disperato della testa sul lip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットはポップから上、少し後ろ。リップで頭を必死に投げることではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트는 팝에서 위로, 조금 뒤로. 립에서 머리를 필사적으로 던지는 게 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Settet går opp og litt bakover, fra poppen, ikke fra et desperat hodekast på lippen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De set gaat omhoog en een beetje achterover, uit de pop, niet uit een wanhopige kopworp op de lip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Set idzie w górę i lekko w tył, z popu, nie z rozpaczliwego rzutu głową na krawędzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O set vai para cima e um pouco para trás, a partir do pop, não de um lançamento desesperado da cabeça no lábio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Setten går upp och lite bakåt, från poppen, inte från ett desperat huvudkast på lippen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起跳姿态向上、略向后，来自 pop，不是在唇沿上绝望甩头。"
          }
        }
      }
    },
    "trick.backflip.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bail on the trampoline until it is boring: if the rotation is late, the spotter stops you, or you sit the rotation down. You practice the bail, not only the make."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu abandonnes sur le trampoline jusqu'à ce que ce soit ennuyeux : si la rotation est en retard, le pareur te stoppe, ou tu poses la rotation assis. Tu t'entraînes à abandonner, pas seulement à réussir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdávej to na trampolíně, dokud to není nuda: je-li rotace pozdě, spotter tě zastaví, nebo rotaci posadíš. Trénuješ vzdání, ne jen povedení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brich auf dem Trampolin ab, bis es langweilig ist: ist die Drehung spät, stoppt dich der Spotter, oder du setzt die Drehung sitzend ab. Du übst den Abbruch, nicht nur das Gelingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aborta en el trampolín hasta que aburra: si el giro va tarde, el spotter te para, o dejas el giro sentado. Practicas abortar, no solo acertar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinuncia sul trampolino finché è noioso: se la rotazione è in ritardo, il paratore ti ferma, oppure posi la rotazione da seduto. Ti alleni a rinunciare, non solo a riuscire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランポリンで、退屈になるまでやめる練習。回転が遅ければスポッターが止めるか、座って回転を下ろす。成功だけでなく、放棄を練習する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트램펄린에서 지루해질 때까지 포기를 연습해. 회전이 늦으면 스포터가 멈추거나, 앉아서 회전을 내려놔. 성공만이 아니라 포기를 연습하는 거야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt på trampolinen til det er kjedelig: er rotasjonen sen, stopper spotteren deg, eller du setter rotasjonen sittende. Du øver på avbruddet, ikke bare treffet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breek af op de trampoline tot het saai is: is de draai laat, dan stopt de spotter je, of je zet de draai zittend neer. Je oefent het afbreken, niet alleen het lukken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezygnuj na trampolinie, aż będzie nudno: jeśli obrót jest późny, spotter cię zatrzymuje albo siadasz z obrotem. Ćwiczysz rezygnację, nie tylko udanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desiste no trampolim até ser aborrecido: se a rotação vai tarde, o spotter para-te, ou pousas a rotação sentado. Treinas desistir, não só acertar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt på studsmattan tills det är tråkigt: är rotationen sen stoppar spottern dig, eller så sätter du ner rotationen sittande. Du övar avbrottet, inte bara träffen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在蹦床上练放弃，直到它变得无聊：旋转晚了，保护者拦住你，或者你坐着把旋转放下来。你练的是放弃，不只是做成。"
          }
        }
      }
    },
    "trick.backflip.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water ramp or airbag next, same coach, same cues. Count consistent landings there before anyone says the word snow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite tremplin d'eau ou airbag, même coach, mêmes repères. Compte des réceptions régulières là-bas avant que quelqu'un prononce le mot neige."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pak vodní rampa nebo airbag, stejný trenér, stejné pokyny. Počítej tam rovnoměrné dopady, než někdo řekne slovo sníh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes Wasserrampe oder Airbag, derselbe Coach, dieselben Hinweise. Zähl dort gleichmäßige Landungen, bevor irgendjemand das Wort Schnee sagt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después rampa de agua o airbag, el mismo coach, las mismas señales. Cuenta recepciones regulares allí antes de que alguien diga la palabra nieve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi rampa d'acqua o airbag, stesso coach, stessi riferimenti. Conta ricezioni regolari lì prima che qualcuno dica la parola neve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次はウォーターランプかエアバッグ。同じコーチ、同じ合図。誰かが「雪」と言う前に、そこでの安定した着地を数える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음은 워터 램프나 에어백. 같은 코치, 같은 신호. 누가 ‘눈’이라는 말을 하기 전에 거기에서 고른 착지를 세어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så vannrampe eller airbag, samme trener, samme tegn. Tell jevne landinger der før noen sier ordet snø."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna waterramp of airbag, dezelfde coach, dezelfde aanwijzingen. Tel daar gelijke landingen voordat iemand het woord sneeuw zegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem rampa wodna albo airbag, ten sam trener, te same wskazówki. Licz równe lądowania tam, zanim ktokolwiek powie słowo śnieg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A seguir rampa de água ou airbag, o mesmo treinador, as mesmas referências. Conta receções regulares ali antes de alguém dizer a palavra neve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan vattenramp eller airbag, samma coach, samma tecken. Räkna jämna landningar där innan någon säger ordet snö."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步是水台或气垫，同一位教练，同样的提示。在任何人说出“雪”之前，先数那里稳定的落地。"
          }
        }
      }
    },
    "trick.backflip.step.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On snow: helmet and back protector, a jump you straight-air without thinking, steep landing, coach on the side, one rider, speed from a marked start. If any of that is missing, you straight-air it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur neige : casque et dorsale, un saut que tu passes droit sans y penser, réception pentue, coach sur le côté, un seul rider, vitesse depuis un départ marqué. S'il manque un élément, tu passes droit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na sněhu: helma a chránič zad, skok, který jedeš rovně bez přemýšlení, strmý dopad, trenér stranou, jeden jezdec, rychlost ze značeného startu. Chybí-li cokoli, jedeš rovně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Schnee: Helm und Rückenprotektor, ein Sprung, den du ohne Nachdenken geradeaus fährst, steile Landung, Coach an der Seite, ein Fahrer, Tempo von einem markierten Start. Fehlt etwas davon, fährst du geradeaus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la nieve: casco y espaldera, un salto que haces recto sin pensarlo, recepción empinada, coach al lado, un rider, velocidad desde una salida marcada. Si falta algo, pasas recto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla neve: casco e paraschiena, un salto che fai dritto senza pensarci, ricezione ripida, coach di lato, un solo rider, velocità da una partenza segnata. Se manca un pezzo, passi dritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪ではヘルメットとバックプロテクター、考えずにまっすぐ通せるジャンプ、急な着地、横のコーチ、一人、印をつけたスタートからの速さ。一つでも欠けたらまっすぐ抜ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈에서는 헬멧과 등 보호대, 생각 없이 곧게 넘는 점프, 가파른 착지, 옆의 코치, 한 명, 표시한 출발의 속도. 하나라도 빠지면 곧게 넘어가."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På snø: hjelm og ryggbeskytter, et hopp du kjører rett uten å tenke, bratt landing, trener ved siden, én kjører, fart fra en merket start. Mangler noe av det, kjører du rett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op sneeuw: helm en rugbeschermer, een jump die je rechtdoor rijdt zonder nadenken, steile landing, coach aan de zijkant, één rijder, snelheid vanaf een gemarkeerde start. Ontbreekt daarvan iets, dan rijd je rechtdoor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na śniegu: kask i ochraniacz pleców, skok, który jedziesz prosto bez myślenia, strome lądowanie, trener z boku, jeden rider, prędkość z oznaczonego startu. Jeśli czegoś brakuje, jedziesz prosto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na neve: capacete e proteção dorsal, um salto que fazes a direito sem pensar, receção íngreme, treinador ao lado, um rider, velocidade a partir de uma partida marcada. Se falta alguma coisa, passas a direito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På snö: hjälm och ryggskydd, ett hopp du åker rakt utan att tänka, brant landning, coach vid sidan, en åkare, fart från en markerad start. Saknas något av det åker du rakt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在雪上：头盔和护背，一个你不用想就能直跳的跳台，陡的落地区，教练在旁边，只有一个人，速度来自标好的起点。缺任何一样，就直着滑过去。"
          }
        }
      }
    },
    "trick.backflip.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A coach who has never seen you straight-air that jump does not get to say go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coach qui ne t'a pas vu passer ce saut droit n'a pas à dire oui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenér, který tě nikdy neviděl jet tento skok rovně, nesmí říct ano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Coach, der dich diesen Sprung nie geradeaus hat fahren sehen, darf nicht ja sagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coach que nunca te ha visto hacer este salto recto no puede decir que sí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coach che non ti ha mai visto fare questo salto dritto non può dire sì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのジャンプをまっすぐ通すのを見たことがないコーチは、行っていいと言えない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 점프를 곧게 넘는 걸 본 적 없는 코치는 가도 된다고 하면 안 돼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En trener som aldri har sett deg kjøre dette hoppet rett, får ikke si ja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een coach die je deze jump nooit rechtdoor heeft zien rijden, mag geen ja zeggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener, który nigdy nie widział, jak jedziesz ten skok prosto, nie może powiedzieć tak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um treinador que nunca te viu fazer este salto a direito não pode dizer que sim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En coach som aldrig sett dig åka det här hoppet rakt får inte säga ja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没看过你在这个跳台上直跳的教练，不能说可以。"
          }
        }
      }
    },
    "trick.backflip.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop for the day after one scary attempt. The second one, rattled, is how people get hurt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu arrêtes la journée après un essai qui t'a fait peur. Le deuxième, secoué, c'est comme ça qu'on se blesse."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po pokusu, který tě vyděsil, pro ten den končíš. Druhý, otřesený, tak se lidé zraní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Versuch, der dir Angst gemacht hat, hörst du für den Tag auf. Der zweite, erschüttert, ist so, wie man sich verletzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de un intento que te asustó, paras por ese día. El segundo, alterado, es como se lesiona la gente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo un tentativo che ti ha fatto paura, ti fermi per la giornata. Il secondo, scosso, è così che ci si fa male."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "怖かった一回のあとは、その日はやめる。揺れた二回目で人は怪我をする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무서웠던 한 번 뒤에는 그날은 멈춰. 흔들린 두 번째가 사람이 다치는 방식이야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter et forsøk som skremte deg, stopper du for dagen. Det andre, ristet, er slik folk skader seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na een poging die je bang maakte, stop je voor die dag. De tweede, geschrokken, is hoe mensen zich blesseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po próbie, która cię przestraszyła, kończysz na ten dzień. Druga, roztrzęsiona, tak ludzie się krzywdzą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de uma tentativa que te assustou, paras nesse dia. A segunda, abalada, é assim que as pessoas se magoam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter ett försök som skrämde dig slutar du för dagen. Det andra, skakat, är så folk skadar sig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次让你害怕的尝试之后，这一天就停。第二次，心还在抖，人就是这样受伤的。"
          }
        }
      }
    },
    "trick.backflip.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age and a club's rules come before this page. If they say not yet, it is not yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'âge et le règlement du club passent avant cette page. S'ils disent pas encore, c'est pas encore."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věk a pravidla klubu jsou před touto stránkou. Řeknou-li ještě ne, ještě ne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alter und die Regeln eines Vereins stehen vor dieser Seite. Sagen sie noch nicht, ist es noch nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edad y las reglas de un club van antes de esta página. Si dicen que todavía no, todavía no."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'età e le regole di un club vengono prima di questa pagina. Se dicono non ancora, non è ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年齢とクラブの規則がこのページより先。まだだと言えば、まだだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나이와 클럽 규칙이 이 페이지보다 먼저야. 아직이라고 하면 아직이야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alder og en klubbs regler kommer før denne siden. Sier de ikke ennå, er det ikke ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeftijd en de regels van een club gaan vóór deze pagina. Zeggen ze nog niet, dan is het nog niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiek i zasady klubu są przed tą stroną. Jeśli mówią jeszcze nie, to jeszcze nie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A idade e as regras de um clube vêm antes desta página. Se dizem ainda não, ainda não."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ålder och en klubbs regler kommer före den här sidan. Säger de inte än, är det inte än."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "年龄和俱乐部的规定在这一页之前。他们说还不行，就是还不行。"
          }
        }
      }
    },
    "trick.frontflip.name": {
