    "profile.location.always": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed all the time. Tracking can continue with the screen locked, and it stops when you finish."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisée en permanence. Le suivi peut continuer écran verrouillé, et il s'arrête quand tu termines."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy povoleno. Záznam může běžet se zamčenou obrazovkou a skončí, když ukončíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer erlaubt. Die Aufzeichnung kann bei gesperrtem Bildschirm weiterlaufen und stoppt, wenn du beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitida siempre. El seguimiento puede seguir con la pantalla bloqueada y se para al terminar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentita sempre. Il tracciamento può continuare a schermo bloccato e si ferma quando termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に許可。画面ロック中も記録でき、終了すると止まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 허용. 화면이 잠겨도 기록이 이어지고, 끝내면 멈춰."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid tillatt. Sporingen kan fortsette med låst skjerm og stopper når du er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd toegestaan. Volgen kan door met een vergrendeld scherm en stopt als je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze dozwolona. Nagranie może iść przy zablokowanym ekranie i staje, gdy kończysz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitida sempre. O registo pode continuar com o ecrã bloqueado e pára quando terminas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid tillåten. Spårningen kan fortsätta med låst skärm och stannar när du slutar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终允许。锁屏后也能记录，结束就停。"
          }
        }
      }
    },
    "profile.location.wheninuse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed only while the app is open. For a pocket, choose Always."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisée seulement quand l'app est ouverte. Pour la poche, choisis Toujours."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen když je aplikace otevřená. Do kapsy zvol Vždy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur bei geöffneter App. Für die Tasche wähle „Immer“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con la app abierta. Para el bolsillo elige «Siempre»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con l'app aperta. Per la tasca scegli «Sempre»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ使用中だけ。ポケットなら「常に」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 열려 있을 때만. 주머니에는 ‘항상’."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare når appen er åpen. For lommen velger du Alltid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen als de app open is. Voor je zak kies je Altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko gdy aplikacja jest otwarta. Do kieszeni wybierz „Zawsze”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só com a app aberta. Para o bolso escolhe «Sempre»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara när appen är öppen. För fickan väljer du Alltid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在使用应用时。放口袋就选“始终”。"
          }
        }
      }
    },
    "profile.location.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked. Without it there is no speed and no track."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquée. Sans ça, pas de vitesse ni de trace."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokováno. Bez polohy není rychlost ani stopa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert. Ohne Ort gibt es kein Tempo und keine Spur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueada. Sin ubicación no hay velocidad ni track."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccata. Senza posizione niente velocità e niente traccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否されている。位置がないと速度も線もない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막혀 있어. 위치 없으면 속도도 선도 없어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkert. Uten posisjon ingen fart og ingen spor."
          }
        },
        "nl": {
