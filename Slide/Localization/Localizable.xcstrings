    "tracking.settings.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Always so tracking continues in a pocket with the screen locked. Slide stops GPS when you finish."
