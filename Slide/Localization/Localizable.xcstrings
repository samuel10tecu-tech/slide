    "tracking.baro.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude uses the barometer when the phone has one, otherwise GPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altitude utilise le baromètre du téléphone quand il est là, sinon le GPS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výška bere barometr, když ho telefon má, jinak GPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Höhe nutzt das Barometer, wenn das Telefon eines hat, sonst GPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La altitud usa el barómetro si el teléfono lo tiene; si no, el GPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altitudine usa il barometro se il telefono ce l'ha, altrimenti il GPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度は気圧計があればそれを使い、なければGPS。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고도는 기압계가 있으면 그걸 쓰고, 없으면 GPS."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyden bruker barometeret hvis telefonen har ett, ellers GPS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogte gebruikt de barometer als de telefoon die heeft, anders gps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysokość bierze barometr, jeśli telefon go ma, inaczej GPS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A altitude usa o barómetro se o telemóvel o tiver; senão, o GPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Höjden använder barometern om telefonen har en, annars GPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有气压计就用气压计测高度，否则用GPS。"
          }
        }
      }
    },
