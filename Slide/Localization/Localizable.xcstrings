    "trick.one-eighty.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A half turn in the air. You leave forward and land switch — the other way comes later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un demi-tour en l'air. Tu pars en avant, tu poses en switch — ou l'inverse plus tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Půl otáčky ve vzduchu. Odjíždíš dopředu a dopadáš switch — druhý směr přijde později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine halbe Drehung in der Luft. Du startest vorwärts und landest switch — die andere Richtung kommt später."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Media vuelta en el aire. Sales de frente y aterrizas en switch; el otro sentido viene después."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezzo giro in aria. Parti in avanti e atterri in switch — l'altro verso arriva dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空中で半回転。前向きで出て、スイッチで着く。逆はあと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공중에서 반 바퀴. 정방향으로 나가 스위치로 착지해. 반대는 나중이야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En halv omdreining i lufta. Du drar forover og lander switch — den andre veien kommer senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een halve draai in de lucht. Je vertrekt vooruit en landt switch — de andere kant komt later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pół obrotu w powietrzu. Wyjeżdżasz przodem i lądujesz switch — druga strona później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meia volta no ar. Sais para a frente e aterras em switch — o outro sentido vem depois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett halvt varv i luften. Du lämnar framåt och landar switch — andra hållet kommer senare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空中转半圈。正脚出去，反脚落地。另一个方向以后再说。"
          }
        }
      }
    },
    "trick.one-eighty.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 180 is first on an S jump, both directions, before a bigger feature."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 180 se fait d'abord sur un jump S, dans les deux sens, avant un module plus grand."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "180 nejdřív na skoku S, oběma směry, než větší prvek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 180 kommt zuerst auf einem S-Sprung, in beide Richtungen, bevor ein größeres Element."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 180 se hace primero en un salto S, en ambos sentidos, antes de un módulo más grande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 180 si fa prima su un salto S, in entrambi i sensi, prima di un modulo più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "180はまずSジャンプで、両方向。大きいキッカーはそのあと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "180은 먼저 S 점프에서, 양쪽 다. 더 큰 구조물은 그다음."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "180 gjøres først på et S-hopp, begge veier, før en større feature."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 180 doe je eerst op een S-jump, beide kanten op, vóór een grotere feature."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "180 najpierw na skoku S, w obie strony, zanim większa przeszkoda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O 180 faz-se primeiro num salto S, nos dois sentidos, antes de um módulo maior."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "180 görs först på ett S-hopp, åt båda hållen, innan en större feature."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "180 先在 S 跳台上、两个方向都做，再上更大的跳台。"
          }
        }
      }
    },
    "trick.one-eighty.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already ski a bit of switch, at least on a mellow blue, so the landing isn't a surprise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sache déjà skier un peu en switch, au moins sur une piste bleue douce, pour que la pose ne te fasse pas peur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už trochu jezdíš switch, aspoň na mírné modré, ať dopad není překvapení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du fährst schon ein bisschen switch, mindestens auf einer sanften blauen Piste, damit die Landung keine Überraschung ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya esquías un poco en switch, al menos en una azul suave, para que la recepción no sea una sorpresa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai già sciare un po' in switch, almeno su una blu morbida, così la ricezione non è una sorpresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも緩い青コースで、少しはスイッチを滑れる。着地が驚きにならないように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어도 완만한 블루에서 스위치를 조금은 탈 줄 알아야 해. 착지가 놀라움이 되지 않게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kjører allerede litt switch, minst på en myk blå, så landingen ikke blir en overraskelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je skiet al een beetje switch, minstens op een zachte blauwe piste, zodat de landing geen verrassing is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeździsz już trochę switch, przynajmniej na łagodnej niebieskiej, żeby lądowanie nie było niespodzianką."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já esquias um pouco em switch, pelo menos numa azul suave, para a receção não ser surpresa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du åker redan lite switch, åtminstone på en mjuk blå, så landningen inte blir en överraskning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经会一点反脚，至少在一条缓的蓝道上，这样落地不会吓到你。"
          }
        }
      }
    },
    "trick.one-eighty.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a small jump, pop straight, then turn the head and shoulders. The skis follow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un petit kick, pop droit, puis tourne la tête et les épaules dans le sens choisi. Les skis suivent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na malém skoku: pop rovně, pak otoč hlavu a ramena. Lyže jdou za nimi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem kleinen Sprung: gerade poppen, dann Kopf und Schultern drehen. Die Ski folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un salto pequeño: pop recto y luego gira cabeza y hombros. Los esquís siguen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un salto piccolo: pop dritto, poi gira testa e spalle. Gli sci seguono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さいジャンプでまっすぐポップしてから、頭と肩を回す。スキーはついてくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 점프에서 곧게 팝한 다음 머리와 어깨를 돌려. 스키가 따라와."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På et lite hopp: popp rett, så snu hodet og skuldrene. Skiene følger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een kleine jump: recht poppen, dan hoofd en schouders draaien. De ski’s volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na małym skoku: pop na wprost, potem obróć głowę i ramiona. Narty idą za nimi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Num salto pequeno: pop a direito e depois roda a cabeça e os ombros. Os esquis seguem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På ett litet hopp: poppa rakt, vrid sedan huvud och axlar. Skidorna följer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在小跳台上先直着起跳，再转头和肩膀。雪板会跟着。"
          }
        }
      }
    },
    "trick.one-eighty.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips turn with the shoulders. Not only the arms."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hanches tournent avec les épaules. Pas seulement les bras."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Boky se otáčejí s rameny. Nejen ruce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüften drehen mit den Schultern. Nicht nur die Arme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las caderas giran con los hombros. No solo los brazos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le anche girano con le spalle. Non solo le braccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰は肩と一緒に回る。腕だけではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엉덩이는 어깨와 같이 돌아. 팔만이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoftene snur med skuldrene. Ikke bare armene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De heupen draaien mee met de schouders. Niet alleen de armen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biodra obracają się z ramionami. Nie tylko ręce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ancas rodam com os ombros. Não só os braços."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Höfterna vrider med axlarna. Inte bara armarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "髋跟着肩膀转。不只是手臂。"
          }
        }
      }
    },
    "trick.one-eighty.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for 180, not 270. Lock the eyes on the landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vises 180, pas 270. Tu bloques le regard vers la réception."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cíl je 180, ne 270. Oči zůstanou na dopadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel ist 180, nicht 270. Die Augen bleiben auf der Landung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta a 180, no a 270. Los ojos se quedan en la recepción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira a 180, non a 270. Gli occhi restano sulla ricezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "狙いは180。270ではない。目は着地に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표는 180이지 270이 아니야. 눈은 착지에."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikt på 180, ikke 270. Øynene blir på landingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt op 180, niet op 270. De ogen blijven op de landing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel to 180, nie 270. Oczy zostają na lądowaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponta a 180, não a 270. Os olhos ficam na receção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikta på 180, inte 270. Ögonen stannar på landningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标是 180，不是 270。眼睛盯着落地区。"
          }
        }
      }
    },
    "trick.one-eighty.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land switch, weight in the middle, and ride straight for a few metres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose en switch, poids au milieu, et continue tout droit quelques mètres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopadni switch, váha uprostřed, a jeď pár metrů rovně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lande switch, Gewicht in der Mitte, und fahre ein paar Meter geradeaus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterriza en switch, peso en el centro, y sigue recto unos metros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterra in switch, peso al centro, e vai dritto per qualche metro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチで着き、体重は真ん中。数メートルまっすぐ滑る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치로 착지하고 무게는 가운데. 몇 미터 곧게 타."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Land switch, vekten i midten, og kjør rett noen meter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Land switch, gewicht in het midden, en rijd een paar meter recht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ląduj switch, ciężar w środku, i jedź prosto kilka metrów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterra em switch, peso no meio, e segue a direito uns metros."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Landa switch, vikten i mitten, och åk rakt några meter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反脚落地，重心在中间，再直着滑几米。"
          }
        }
      }
    },
    "trick.one-eighty.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an easy direction (often looking over the front shoulder) and clean it before the other way."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un sens « facile » (souvent celui où tu regardes par-dessus l'épaule avant) et propre-le avant l'autre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvol snadný směr (často přes přední rameno) a udělej ho čistě, než ten druhý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine leichte Richtung (oft über die vordere Schulter) und mach sie sauber, bevor die andere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un sentido fácil (a menudo por encima del hombro delantero) y límpialo antes del otro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un verso facile (spesso sopra la spalla davanti) e puliscilo prima dell'altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やりやすい向き（多くは前の肩ごし）を先に決めてから、逆をやる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬운 방향(대개 앞 어깨 너머)을 먼저 깨끗이 하고, 그다음 반대."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en lett retning (ofte over den fremre skulderen) og gjør den ren før den andre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een makkelijke kant (vaak over de voorste schouder) en maak die schoon vóór de andere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz łatwy kierunek (często przez przednie ramię) i zrób go czysto, zanim drugi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um sentido fácil (muitas vezes por cima do ombro da frente) e limpa-o antes do outro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett lätt håll (ofta över den främre axeln) och gör det rent innan det andra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选一个容易的方向（常常是看过前肩），做干净再换另一边。"
          }
        }
      }
    },
    "trick.one-eighty.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you under-rotate, the head left late, not the feet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu sous-tournes, c'est la tête qui est partie trop tard, pas les pieds."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když nedotočíš, hlava šla pozdě, ne nohy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du unterdrehst, ist der Kopf zu spät gegangen, nicht die Füße."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te quedas corto, la cabeza salió tarde, no los pies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sotto-ruoti, la testa è partita tardi, non i piedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転が足りないときは、足ではなく頭が遅れた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덜 돌면 발이 아니라 머리가 늦게 나간 거야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du underroterer, gikk hodet sent, ikke føttene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je onderroteert, ging het hoofd te laat, niet de voeten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli niedokręcasz, głowa ruszyła za późno, nie stopy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ficas curto, a cabeça saiu tarde, não os pés."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du underroterar gick huvudet sent, inte fötterna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果转不够，是头走晚了，不是脚。"
          }
        }
      }
    },
    "trick.switch-riding.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
