        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuntalo quando lo atterri pulito, non al primo tentativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の一発ではなく、きれいに着地できたらチェック。"
