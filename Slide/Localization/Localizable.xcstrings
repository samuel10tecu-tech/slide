    "profile.about.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide does not create an account and sends nothing to the internet. Tracks, tricks and your name stay on the phone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide ne crée pas de compte et n'envoie rien sur Internet. Les traces, les tricks et le prénom restent dans le téléphone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide nezakládá účet a nic neposílá na internet. Stopy, triky a jméno zůstanou v telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide legt kein Konto an und schickt nichts ins Internet. Spuren, Tricks und dein Name bleiben auf dem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide no crea una cuenta y no envía nada a internet. Tracks, tricks y tu nombre se quedan en el teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide non crea un account e non manda nulla su internet. Tracce, trick e il nome restano sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Slideはアカウントを作らず、インターネットにも送らない。トラック、トリック、名前は電話の中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide는 계정을 만들지 않고 인터넷으로 아무것도 안 보내. 트랙, 트릭, 이름은 휴대폰에 남아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide lager ingen konto og sender ingenting til internett. Spor, triks og navnet ditt blir på telefonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide maakt geen account en stuurt niets naar internet. Sporen, tricks en je naam blijven op de telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide nie zakłada konta i nic nie wysyła do internetu. Ślady, tricki i imię zostają w telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Slide não cria conta e não envia nada para a internet. Traçados, tricks e o nome ficam no telemóvel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide skapar inget konto och skickar inget till internet. Spår, trick och ditt namn stannar i telefonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide 不建账号，也不往网上发任何东西。轨迹、动作和名字都留在手机里。"
          }
        }
      }
    },
    "profile.about.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Airtime is an accelerometer estimate: useful for comparing jumps, not a lab measurement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'airtime est une estimation de l'accéléromètre : utile pour comparer tes sauts, pas une mesure de labo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Airtime je odhad z akcelerometru: na porovnání, ne laboratorní měření."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Luftzeit ist eine Schätzung des Beschleunigungssensors: gut zum Vergleichen, keine Labormessung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El airtime es una estimación del acelerómetro: sirve para comparar, no es una medida de laboratorio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'airtime è una stima dell'accelerometro: utile per confrontare, non una misura di laboratorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エアタイムは加速度センサーの推定。比べるには使えるが、実験室の測定ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에어타임은 가속도계 추정이야. 비교용이지 실험실 측정은 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Airtime er et anslag fra akselerometeret: greit å sammenligne, ikke et laboratoriemål."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Airtime is een schatting van de versnellingsmeter: handig om te vergelijken, geen labmeting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Airtime to szacunek z akcelerometru: do porównań, nie pomiar laboratoryjny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O airtime é uma estimativa do acelerómetro: serve para comparar, não é medida de laboratório."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Airtime är en uppskattning från accelerometern: bra att jämföra, inte ett labbvärde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滞空时间是加速度计的估计。用来比较可以，不是实验室测量。"
          }
        }
      }
    },
    "profile.about.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cold kills batteries in the mountains. Keep the phone warm, in an inside pocket, and start full. Low Power Mode can stall GPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En montagne le froid vide la batterie. Garde le téléphone au chaud, dans une poche intérieure, et pars chargé. Le mode économie d'énergie peut couper le GPS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima vybíjí baterku. Měj telefon v teple, ve vnitřní kapse, a vyjeď nabitý. Úsporný režim může zastavit GPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kälte leert Akkus im Gebirge. Halt das Telefon warm, in einer Innentasche, und starte voll. Der Stromsparmodus kann das GPS aussetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El frío vacía la batería en la montaña. Lleva el teléfono caliente, en un bolsillo interior, y sal con carga. El bajo consumo puede parar el GPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il freddo svuota le batterie in montagna. Tieni il telefono al caldo, in una tasca interna, e parti carico. Il risparmio energetico può fermare il GPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山の寒さは電池を空にする。内側のポケットで温かく、満充電で出る。低電力モードはGPSを止めることがある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "산의 추위가 배터리를 비워. 안쪽 주머니에 따뜻하게, 가득 충전해서 나가. 저전력 모드는 GPS를 멈출 수 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulde tømmer batterier i fjellet. Hold telefonen varm, i en innerlomme, og start full. Lavstrømmodus kan stoppe GPS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koude leegt batterijen in de bergen. Houd de telefoon warm, in een binnenzak, en start vol. Energiebesparing kan gps pauzeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mróz opróżnia baterię w górach. Trzymaj telefon w cieple, w wewnętrznej kieszeni, i wyjdź naładowany. Tryb oszczędzania może wstrzymać GPS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O frio esvazia a bateria na montanha. Mantém o telemóvel quente, num bolso interior, e sai carregado. A poupança pode parar o GPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyla tömmer batterier i bergen. Håll telefonen varm, i en innerficka, och starta full. Lågenergiläge kan stoppa GPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "山上的冷会掏空电量。把手机放在内袋里保暖，充满再出门。低电量模式可能让 GPS 停住。"
          }
        }
      }
    },
    "profile.about.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blue pill can show while tracking: iOS is saying GPS is on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pastille bleue peut s'afficher pendant le suivi : c'est iOS qui montre que le GPS tourne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při záznamu se může ukázat modrá kapsle: iOS říká, že GPS běží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Aufzeichnen kann eine blaue Kapsel erscheinen: iOS sagt, dass GPS an ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al grabar puede salir una pastilla azul: iOS dice que el GPS está encendido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante il tracciamento può comparire una capsula blu: iOS dice che il GPS è acceso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録中に青い表示が出ることがある。iOSがGPSオンを示している。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 중에 파란 알약이 나올 수 있어. iOS가 GPS가 켜져 있다고 말하는 거야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En blå kapsel kan vises under sporing: iOS sier at GPS er på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens volgen kan een blauwe pil verschijnen: iOS zegt dat gps aan staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas nagrania może pojawić się niebieska kapsułka: iOS mówi, że GPS działa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao registar pode aparecer uma cápsula azul: o iOS diz que o GPS está ligado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En blå kapsel kan synas under spårning: iOS säger att GPS är på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录时可能出现蓝色胶囊：那是 iOS 在说 GPS 开着。"
          }
        }
      }
    },
    "profile.about.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a free Apple ID, an app installed from Xcode must be reinstalled about every 7 days. Sending the app itself (TestFlight) needs a paid developer account in an adult's name. Live Activity on the Dynamic Island works without that paid account. A home-screen widget that reads your days does not: it would need App Groups, which a free Apple ID cannot use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un Apple ID gratuit, l'app installée depuis Xcode doit être réinstallée environ tous les 7 jours. Envoyer l'app elle-même (TestFlight) demande un compte développeur payant, au nom d'un adulte. L'activité en direct sur la Dynamic Island marche sans ce compte payant. Un widget d'écran d'accueil qui lit tes journées, non : il faudrait des App Groups, impossibles avec un Apple ID gratuit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S bezplatným Apple ID se aplikace z Xcode musí znovu nainstalovat zhruba každých 7 dní. Poslat samotnou aplikaci (TestFlight) chce placený vývojářský účet na jméno dospělého. Live Activity na Dynamic Island funguje bez toho placeného účtu. Widget na ploše, který čte tvé dny, ne: potřeboval by App Groups a ty bezplatné Apple ID nesmí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer kostenlosen Apple-ID muss eine aus Xcode installierte App etwa alle 7 Tage neu installiert werden. Die App selbst weitergeben (TestFlight) braucht ein kostenpflichtiges Entwicklerkonto auf den Namen eines Erwachsenen. Die Live Activity auf der Dynamic Island geht ohne dieses kostenpflichtige Konto. Ein Home-Bildschirm-Widget, das deine Tage liest, nicht: dafür bräuchte es App Groups, die eine kostenlose Apple-ID nicht darf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un Apple ID gratis, una app instalada desde Xcode hay que reinstalarla más o menos cada 7 días. Enviar la app (TestFlight) exige una cuenta de desarrollador de pago a nombre de un adulto. La Live Activity en la Dynamic Island funciona sin esa cuenta de pago. Un widget de inicio que lea tus días no: harían falta App Groups, y un Apple ID gratis no puede usarlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un Apple ID gratuito un'app installata da Xcode va reinstallata circa ogni 7 giorni. Inviare l'app stessa (TestFlight) richiede un account sviluppatore a pagamento a nome di un adulto. La Live Activity sulla Dynamic Island funziona senza quell'account a pagamento. Un widget della schermata Home che legge le giornate no: servirebbero gli App Group, che un Apple ID gratuito non può usare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のApple IDでは、Xcodeから入れたアプリはおよそ7日ごとに入れ直す。アプリ自体を配る（TestFlight）には、大人名義の有料開発者アカウントが要る。Dynamic Islandのライブアクティビティはその有料アカウントなしで動く。日を読むホーム画面ウィジェットは不可。App Groupsが必要で、無料のApple IDでは使えない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 Apple ID로는 Xcode에서 설치한 앱을 대략 7일마다 다시 넣어야 해. 앱 자체를 보내는 것(TestFlight)은 어른 이름의 유료 개발자 계정이 필요해. Dynamic Island의 라이브 액티비티는 그 유료 계정 없이 돼. 네 날을 읽는 홈 화면 위젯은 안 돼. App Groups가 필요한데 무료 Apple ID는 못 써."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en gratis Apple-ID må en app installert fra Xcode installeres på nytt omtrent hver 7. dag. Å sende selve appen (TestFlight) krever en betalt utviklerkonto i en voksens navn. Live Activity på Dynamic Island virker uten den betalte kontoen. En widget på hjemskjermen som leser dagene dine gjør det ikke: den ville trengt App Groups, som en gratis Apple-ID ikke kan bruke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een gratis Apple ID moet een app die via Xcode is geïnstalleerd ongeveer elke 7 dagen opnieuw. De app zelf doorsturen (TestFlight) vraagt een betaald ontwikkelaarsaccount op naam van een volwassene. Live Activity op het Dynamic Island werkt zonder dat betaalde account. Een widget op het beginscherm die je dagen leest niet: daarvoor zijn App Groups nodig, en die mag een gratis Apple ID niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy darmowym Apple ID aplikację z Xcode trzeba instalować ponownie mniej więcej co 7 dni. Wysłanie samej aplikacji (TestFlight) wymaga płatnego konta dewelopera na nazwisko osoby dorosłej. Live Activity na Dynamic Island działa bez tego płatnego konta. Widżet ekranu początkowego, który czyta twoje dni, nie: potrzebowałby App Groups, a darmowe Apple ID ich nie może."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um Apple ID gratuito, uma app instalada pelo Xcode tem de ser reinstalada cerca de 7 em 7 dias. Enviar a própria app (TestFlight) exige uma conta de programador paga em nome de um adulto. A Live Activity na Dynamic Island funciona sem essa conta paga. Um widget do ecrã principal que leia os teus dias não: precisaria de App Groups, que um Apple ID gratuito não pode usar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ett gratis Apple-ID måste en app installerad från Xcode installeras om ungefär var sjunde dag. Att skicka själva appen (TestFlight) kräver ett betalt utvecklarkonto i en vuxens namn. Live Activity på Dynamic Island fungerar utan det betalda kontot. En hemskärmswidget som läser dina dagar gör det inte: den skulle behöva App Groups, vilket ett gratis Apple-ID inte får använda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用免费 Apple ID 时，从 Xcode 装上的应用大约每 7 天要重装一次。把应用本身发给别人（TestFlight）需要一个成人名下的付费开发者账号。灵动岛上的实时活动不需要那个付费账号。能读你每天记录的主屏幕小组件不行：它需要 App Groups，免费 Apple ID 不能用。"
          }
        }
      }
    },
