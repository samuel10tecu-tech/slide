    "tracking.banner.lowpower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode can stall GPS. Turn it off for a full day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode économie d'énergie peut couper le GPS. Désactive-le pour une journée complète."
          }
        }
      }
    },
    "tracking.banner.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS has gone quiet. Pull the phone out for a second, or wait for open sky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS ne répond plus. Sors le téléphone une seconde, ou attends le ciel ouvert."
          }
        }
      }
    },
    "tracking.banner.accuracy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS weak (%d m). Inaccurate points are ignored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS faible (%d m). Les points trop imprécis sont ignorés."
          }
        }
      }
    },
    "tracking.banner.wheninuse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For tracking with the screen locked, set Location to Always in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le suivi écran verrouillé, passe la position sur « Toujours » dans Réglages."
