    "trick.tail-butter.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tail butter loads the tails. The tips lift and turn. Same idea as the nose, reversed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tail butter charge la queue. L'avant des skis décolle et tourne. Même logique que le nose, à l'envers."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tail butter zatíží patky. Špičky se zvednou a otočí. Stejný nápad jako nose, obráceně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tail Butter lädt die Tails. Die Spitzen heben ab und drehen. Dieselbe Idee wie der Nose, nur umgekehrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tail butter carga las colas. Las puntas se levantan y giran. La misma idea que el nose, al revés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tail butter carica le code. Le punte si alzano e girano. Stessa idea del nose, al contrario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テールバターはテールに荷重する。先が浮いて回る。ノーズの逆。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테일 버터는 테일에 무게를 실어. 앞끝이 뜨고 돌아. 노즈와 같은 생각, 반대야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tail butter lader bakskiene. Tuppene løfter og snur. Samme idé som nose, bakvendt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tail butter laadt de tails. De tips komen omhoog en draaien. Dezelfde idee als de nose, omgekeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tail butter obciąża tyły. Dzioby się unoszą i obracają. Ten sam pomysł co nose, odwrotnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tail butter carrega as caudas. As pontas levantam e rodam. A mesma ideia do nose, ao contrário."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tail butter laddar bakskidorna. Spetsarna lyfter och vrider. Samma idé som nose, bakvänd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "板尾黄油转给板尾加压。板头抬起并转动。和板头黄油转一样，只是反过来。"
          }
        }
      }
    },
    "trick.tail-butter.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitting on the tails locks the ski and dumps you backward. Stay standing in the boots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'asseoir sur les queues bloque le ski et te fait tomber en arrière. Reste debout dans les bottes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sednout si na patky zablokuje lyži a shodí tě dozadu. Zůstaň stát v botách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Tails setzen blockiert den Ski und wirft dich nach hinten. Bleib in den Schuhen stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentarte en las colas bloquea el esquí y te tira hacia atrás. Quédate de pie en las botas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sederti sulle code blocca lo sci e ti butta indietro. Resta in piedi negli scarponi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テールに座るとスキーが止まり、後ろに落ちる。ブーツの中で立ったまま。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테일에 앉으면 스키가 잠기고 뒤로 넘어진다. 부츠 안에서 서 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sette deg på bakskiene låser skien og tipper deg bakover. Bli stående i støvlene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de tails gaan zitten blokkeert de ski en gooit je achterover. Blijf staan in de schoenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siadanie na tyłach blokuje nartę i zrzuca cię do tyłu. Zostań stojąc w butach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentares-te nas caudas bloqueia o esqui e atira-te para trás. Fica de pé nas botas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att sätta dig på bakskidorna låser skidan och tippar dig bakåt. Stå kvar i pjäxorna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐到板尾上会锁住雪板，把你往后甩。站在雪鞋里。"
          }
        }
      }
    },
    "trick.tail-butter.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a soft bump, move weight to the tails without sitting down."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur une bosse douce, recule le poids sur les queues sans t'asseoir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na měkké bouli přesuň váhu na patky, aniž si sedneš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem weichen Buckel verlagerst du das Gewicht auf die Tails, ohne dich hinzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un bache blando pasas el peso a las colas, sin sentarte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su una gobba morbida sposti il peso sulle code, senza sederti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柔らかいコブで、座らずにテールへ体重を移す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 범프에서 앉지 않고 테일로 무게를 옮겨."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På en myk hump flytter du vekten til bakskiene uten å sette deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een zachte bult verplaats je het gewicht naar de tails, zonder te gaan zitten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na miękkim garbie przenieś ciężar na tyły, bez siadania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa lomba mole passas o peso para as caudas, sem te sentares."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På en mjuk gupp flyttar du vikten till bakskidorna utan att sätta dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在柔软的雪包上把重量移到板尾，不要坐下。"
          }
        }
      }
    },
    "trick.tail-butter.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend the knees and let the tips get light."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fléchis les genoux et laisse les spatules devenir légères."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrč kolena a nech špičky zlehknout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beuge die Knie und lass die Spitzen leicht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexiona las rodillas y deja que las puntas se aligeren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piega le ginocchia e lascia le punte diventare leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝を曲げ、先を軽くする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎을 굽히고 앞끝을 가볍게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy knærne og la tuppene bli lette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buig de knieën en laat de tips licht worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugnij kolana i pozwól dziobom stać się lekkimi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Flete os joelhos e deixa as pontas ficarem leves."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böj knäna och låt spetsarna bli lätta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弯曲膝盖，让板头变轻。"
          }
        }
      }
    },
    "trick.tail-butter.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the tips with the feet. The upper body stays fairly quiet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne les spatules avec les pieds. Le haut du corps reste assez calme."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otoč špičky chodidly. Trup zůstane dost klidný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh die Spitzen mit den Füßen. Der Oberkörper bleibt ziemlich ruhig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira las puntas con los pies. El torso se queda bastante quieto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira le punte con i piedi. Il busto resta abbastanza fermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足で先を回す。上半身はかなり静か。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발로 앞끝을 돌려. 상체는 꽤 조용히."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snu tuppene med føttene. Overkroppen blir ganske rolig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai de tips met de voeten. Het bovenlijf blijft redelijk rustig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obróć dzioby stopami. Tułów zostaje dość spokojny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda as pontas com os pés. O tronco fica bastante quieto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid spetsarna med fötterna. Överkroppen stannar ganska lugn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用脚转动板头。上身保持比较安静。"
          }
        }
      }
    },
    "trick.tail-butter.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look where you want to come out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regard va là où tu veux ressortir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívej se tam, kudy chceš vyjet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau dorthin, wo du herauskommen willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira hacia donde quieres salir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda dove vuoi uscire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出たい方向を見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나가고 싶은 곳을 봐."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dit du vil komme ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk waar je uit wilt komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz tam, gdzie chcesz wyjechać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha para onde queres sair."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta dit du vill komma ut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看你想出去的方向。"
          }
        }
      }
    },
    "trick.tail-butter.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the tips back down before the bump ends and recenter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repose les spatules avant la fin de la bosse et recentre-toi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Polož špičky zpět, než boule skončí, a vycentruj se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz die Spitzen wieder auf, bevor der Buckel endet, und zentriere dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a bajar las puntas antes de que acabe el bache y recentra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimetti giù le punte prima che la gobba finisca e ricentrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コブが終わる前に先を戻し、真ん中へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범프가 끝나기 전에 앞끝을 다시 내리고 가운데로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett tuppene ned igjen før humpen tar slutt og sentrer deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de tips weer neer voordat de bult eindigt en centreer je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połóż dzioby z powrotem, zanim garb się skończy, i wycentruj się."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe as pontas outra vez no chão antes de a lomba acabar e recentra-te."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt ner spetsarna igen innan guppen tar slut och centrera dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪包结束前把板头放回去，重心回到中间。"
          }
        }
      }
    },
    "trick.tail-butter.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low arms stop you from arching."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bras bas t'empêchent de cambrer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nízké ruce tě drží před prohnutím."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefe Arme hindern dich am Hohlkreuz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazos bajos te impiden arquearte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccia basse ti impediscono di inarcarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を低くすると反り腰にならない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔을 낮추면 허리가 젖혀지지 않아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave armer hindrer deg i å svaie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lage armen houden je tegen een holle rug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niskie ręce powstrzymują cię przed wygięciem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Braços baixos impedem-te de arquear."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låga armar hindrar dig från att svanka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手臂放低，就不会把腰拱起来。"
          }
        }
      }
    },
    "trick.tail-butter.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tiny tail butter held for a long time beats a big missed gesture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tail butter tout petit, tenu longtemps, est plus utile qu'un grand geste raté."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maličký tail butter, držený dlouho, je lepší než velké minuté gesto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein winziger Tail Butter, lange gehalten, schlägt eine große, verpasste Geste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tail butter diminuto, sostenido mucho, vale más que un gesto grande y fallado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tail butter piccolissimo, tenuto a lungo, batte un grande gesto sbagliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さく長く持ったテールバターは、大きく外した動きに勝る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아주 작고 오래 유지한 테일 버터가 크고 놓친 동작보다 낫다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En bitteliten tail butter, holdt lenge, slår en stor bommet gest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een piepkleine tail butter, lang vastgehouden, verslaat een groot mislukt gebaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Malutki tail butter, trzymany długo, jest lepszy niż duży, chybiony gest."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tail butter minúsculo, segurado muito tempo, vale mais do que um gesto grande falhado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En pytteliten tail butter, hållen länge, slår en stor missad gest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个很小、保持很久的板尾黄油转，胜过一个大而没做成的动作。"
          }
        }
      }
    },
