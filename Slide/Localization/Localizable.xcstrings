    "profile.location.always": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed all the time. Tracking can continue with the screen locked, and it stops when you finish."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisée en permanence. Le suivi peut continuer écran verrouillé, et il s'arrête quand tu termines."
          }
        }
      }
    },
    "profile.location.wheninuse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed only while the app is open. For a pocket, choose Always."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisée seulement quand l'app est ouverte. Pour la poche, choisis Toujours."
          }
        }
      }
    },
    "profile.location.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked. Without it there is no speed and no track."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquée. Sans ça, pas de vitesse ni de trace."
          }
        }
      }
    },
    "profile.location.unknown": {
      "extractionState": "manual",
