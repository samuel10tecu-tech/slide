    "trick.park-rules.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A terrain park is not a normal piste. Everyone goes the same way, and nobody stops on a landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le snowpark n'est pas une piste normale. Tout le monde descend dans le même sens, et personne ne s'arrête sur une réception."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snowpark není běžná sjezdovka. Všichni jedou stejným směrem a nikdo nestojí na dopadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Snowpark ist keine normale Piste. Alle fahren in dieselbe Richtung, und niemand bleibt auf der Landung stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un snowpark no es una pista normal. Todos bajan en el mismo sentido y nadie se para en la recepción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il park non è una pista normale. Tutti vanno nello stesso senso e nessuno si ferma in ricezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スノーパークは普通のゲレンデではない。みんな同じ向きに滑り、着地に止まらない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스노파크는 보통 슬로프가 아니야. 모두 같은 방향으로 내려가고, 착지에 멈추지 않아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En snowpark er ingen vanlig løype. Alle kjører samme vei, og ingen stopper i landingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een snowpark is geen normale piste. Iedereen gaat dezelfde kant op en niemand stopt op de landing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snowpark to nie zwykła trasa. Wszyscy jadą w jedną stronę i nikt nie staje na lądowaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um snowpark não é uma pista normal. Toda a gente desce no mesmo sentido e ninguém pára na receção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En snowpark är ingen vanlig pist. Alla åker åt samma håll och ingen stannar på landningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪上公园不是普通雪道。所有人往同一个方向滑，没有人停在落地区。"
          }
        }
      }
    },
    "trick.park-rules.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Switzerland: 144 for an ambulance, 1414 for REGA helicopter. In nearby France: 112. Save the numbers before you go up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En Suisse, les secours : 144 (ambulance) et 1414 (REGA, hélico). En France voisine : 112. Mets ces numéros dans ton téléphone avant de monter."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve Švýcarsku: 144 sanitka, 1414 vrtulník REGA. V sousední Francii: 112. Ulož čísla, než vyjedeš nahoru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Schweiz: 144 für den Rettungsdienst, 1414 für den REGA-Helikopter. Im nahen Frankreich: 112. Speichere die Nummern, bevor du hochfährst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Suiza: 144 para la ambulancia, 1414 para el helicóptero REGA. En la Francia cercana: 112. Guarda los números antes de subir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Svizzera: 144 per l'ambulanza, 1414 per l'elicottero REGA. Nella Francia vicina: 112. Salva i numeri prima di salire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイスでは救急車144、REGAのヘリ1414。隣のフランスは112。上る前に番号を保存して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위스에서는 구급차 144, REGA 헬기 1414. 가까운 프랑스는 112. 올라가기 전에 번호를 저장해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I Sveits: 144 for ambulanse, 1414 for REGA-helikopter. I Frankrike ved siden av: 112. Lagre numrene før du kjører opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zwitserland: 144 voor de ambulance, 1414 voor de REGA-helikopter. In het nabije Frankrijk: 112. Sla de nummers op voor je omhoog gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Szwajcarii: 144 karetka, 1414 helikopter REGA. W pobliskiej Francji: 112. Zapisz numery, zanim wjedziesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Suíça: 144 para a ambulância, 1414 para o helicóptero REGA. Na França ao lado: 112. Guarda os números antes de subir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Schweiz: 144 för ambulans, 1414 för REGA-helikopter. I närliggande Frankrike: 112. Spara numren innan du åker upp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "瑞士：救护车 144，REGA 直升机 1414。旁边的法国：112。上山前把号码存好。"
          }
        }
      }
    },
    "trick.park-rules.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the day's map at the bottom. Features are sized S, M, L, XL. Start on S."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde le plan du jour au départ. Les modules ont une taille : S, M, L, XL. Commence par S."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dole se podívej na plán dne. Prvky jsou S, M, L, XL. Začni na S."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau dir unten den Plan des Tages an. Die Elemente sind S, M, L, XL. Fang mit S an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el plano del día abajo. Los módulos son S, M, L, XL. Empieza por S."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la mappa del giorno in partenza. I moduli sono S, M, L, XL. Inizia da S."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下でその日のマップを見る。サイズはS、M、L、XL。Sから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 오늘 지도를 봐. 크기는 S, M, L, XL. S부터."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dagens kart nede. Features er S, M, L, XL. Begynn på S."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk onderaan naar de kaart van de dag. Features zijn S, M, L, XL. Begin bij S."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dole zobacz plan dnia. Przeszkody są S, M, L, XL. Zacznij od S."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê o mapa do dia em baixo. Os módulos são S, M, L, XL. Começa pelo S."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolla dagens karta nere. Features är S, M, L, XL. Börja på S."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下面看当天的地图。大小是 S、M、L、XL。从 S 开始。"
          }
        }
      }
    },
    "trick.park-rules.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look uphill and downhill before you drop. One look, then you go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de partir, regarde en haut ET en bas. Un coup d'œil, puis tu t'engages."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než vyjedeš, podívej se nahoru i dolů. Jeden pohled a jedeš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau vor dem Start bergauf und bergab. Ein Blick, dann fährst du."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de salir mira arriba y abajo. Una mirada y sales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di partire guarda a monte e a valle. Uno sguardo, poi vai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出る前に上と下を見る。一度見てから滑る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나가기 전에 위와 아래를 봐. 한 번 보고 타."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se oppover og nedover før du kjører. Ett blikk, så kjører du."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk voor je gaat omhoog en omlaag. Eén blik, dan ga je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed startem spójrz w górę i w dół. Jedno spojrzenie i jedziesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de partir olha para cima e para baixo. Um olhar e sais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta uppför och nedför innan du åker. En blick, sedan åker du."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出发前看上坡和下坡。看一眼再滑。"
          }
        }
      }
    },
    "trick.park-rules.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't cross a jump or a rail. Ride the line, exit, and clear to the side."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne traverse pas un kick ou un rail. Tu suis la ligne, tu sors, tu dégages sur le côté."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekřiž skok ani rail. Jeď linii, sjeď a uvolni stranu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreuze keinen Sprung und kein Rail. Fahr die Linie, raus, und zur Seite frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cruces un salto ni un rail. Sigue la línea, sal y apártate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non attraversare un salto o un rail. Segui la linea, esci e spostati di lato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャンプやレールを横切らない。ラインを滑り、出て、横にどく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점프나 레일을 가로지르지 마. 라인을 타고 나와서 옆으로 비켜."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryss ikke et hopp eller en rail. Kjør linjen, ut, og til siden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steek geen jump of rail over. Volg de lijn, eraf, en ruim opzij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przecinaj skoku ani raila. Jedź linią, zjedź i zjedź na bok."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não atravesses um salto nem um carril. Segue a linha, sais e afastas-te."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Korsa inte ett hopp eller en rail. Åk linjen, ut, och åt sidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要横穿跳台或杆。顺着线路滑，出去，再让到旁边。"
          }
        }
      }
    },
    "trick.park-rules.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you fall, get off the line immediately, even if it hurts. The rider behind cannot see you in time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu tombes, sors de la ligne tout de suite, même si tu as mal. La personne derrière ne te voit pas assez tôt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když spadneš, hned sjeď z linie, i když to bolí. Ten za tebou tě neuvidí včas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fällst, geh sofort von der Linie, auch wenn es weh tut. Der hinter dir sieht dich nicht rechtzeitig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si caes, sal de la línea al momento, aunque duela. Quien viene detrás no te ve a tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cadi, esci subito dalla linea, anche se fa male. Chi è dietro non ti vede in tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転んだら、痛くてもすぐにラインから出る。後ろの人は間に合わない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넘어지면 아파도 바로 라인에서 나와. 뒤 사람은 제때 못 봐."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du faller, kom deg av linjen med en gang, selv om det gjør vondt. Den bak ser deg ikke i tide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je valt, van de lijn af, ook als het pijn doet. Degene achter je ziet je niet op tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak upadniesz, zejdź z linii od razu, nawet jeśli boli. Osoba z tyłu nie zobaczy cię w porę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se caíres, sai já da linha, mesmo que doa. Quem vem atrás não te vê a tempo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du faller, lämna linjen genast, även om det gör ont. Den bakom ser dig inte i tid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摔倒了，哪怕疼也马上离开线路。后面的人来不及看见你。"
          }
        }
      }
    },
    "trick.park-rules.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One rider at a time on a feature. Wait until the landing is empty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul rider à la fois sur un module. Tu attends que la réception soit libre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na prvku jen jeden. Počkej, až je dopad volný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Person auf einem Element. Warte, bis die Landung frei ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona a la vez en un módulo. Espera a que la recepción esté libre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona alla volta su un modulo. Aspetta che la ricezione sia libera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一つのキッカーに一人。着地が空くまで待つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 구조물에 한 명. 착지가 빌 때까지 기다려."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én om gangen på en feature. Vent til landingen er tom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén persoon tegelijk op een feature. Wacht tot de landing leeg is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna osoba naraz na przeszkodzie. Czekaj, aż lądowanie będzie puste."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa de cada vez num módulo. Espera que a receção esteja livre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En person i taget på en feature. Vänta tills landningen är tom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个跳台上一次一个人。等到落地区空了再上。"
          }
        }
      }
    },
    "trick.park-rules.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helmet buckled before the first chair, not 'only for the park'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le casque est fermé avant le premier télésiège, pas « pour le park seulement »."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Helma zapnutá před prvním vlekem, ne „jen do parku”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm zu, bevor der erste Sessellift kommt, nicht „nur für den Park“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casco abrochado antes del primer telesilla, no «solo para el park»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Casco allacciato prima della prima seggiovia, non «solo per il park»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のリフトの前にヘルメットを締める。「パークだけ」ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 리프트 전에 헬멧을 채워. ‘파크에서만’이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelm spent før første stolheis, ikke «bare for parken»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm vast voor de eerste stoeltjeslift, niet ‘alleen voor het park’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kask zapięty przed pierwszym krzesełkiem, nie „tylko do parku”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacete apertado antes do primeiro telecadeira, não «só para o park»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälm spänd före första stolliften, inte ”bara för parken”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一趟缆车之前扣好头盔，不是“只在公园才戴”。"
          }
        }
      }
    },
    "trick.park-rules.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the snow is hard or you are tired, the park can wait. Most bad falls are at the end of the day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la neige est dure ou que tu es fatigué, le park peut attendre. La plupart des grosses chutes arrivent en fin de journée."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je sníh tvrdý nebo jsi unavený, park může počkat. Většina těžkých pádů je na konci dne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Schnee hart ist oder du müde bist, kann der Park warten. Die meisten schweren Stürze kommen am Ende des Tages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la nieve está dura o estás cansado, el park puede esperar. Las caídas gordas llegan al final del día."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la neve è dura o sei stanco, il park può aspettare. Le cadute grosse arrivano a fine giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪が硬いか疲れていたらパークは待てる。大きな転倒の多くは一日の終わり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈이 딱딱하거나 피곤하면 파크는 기다려. 큰 낙상은 대부분 하루 끝이야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis snøen er hard eller du er trøtt, kan parken vente. De fleste harde fallene kommer på slutten av dagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de sneeuw hard is of je moe bent, kan het park wachten. De zware valpartijen komen aan het eind van de dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy śnieg jest twardy albo jesteś zmęczony, park może poczekać. Większość ciężkich upadków jest pod koniec dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a neve está dura ou estás cansado, o park pode esperar. As quedas graves chegam ao fim do dia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om snön är hård eller du är trött kan parken vänta. De flesta tunga fallen kommer i slutet av dagen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪硬或者你累了，公园可以等。严重摔倒大多在一天的末尾。"
          }
        }
      }
    },
    "trick.protections.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helmet and back protector"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casque et dorsale"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Helma a chránič zad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm und Rückenprotektor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casco y espaldera"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Casco e paraschiena"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルメットとバックプロテクター"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헬멧과 등 보호대"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelm og ryggbeskytter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helm en rugbeschermer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kask i ochraniacz pleców"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacete e proteção dorsal"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälm och ryggskydd"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头盔和护背"
          }
        }
      }
    },
    "trick.protections.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fitted ski helmet, a back protector, and full gloves. Not optional if you jump or slide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un casque de ski bien réglé, une dorsale, et des gants entiers. Ce n'est pas négociable pour sauter ou slider."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Padnoucí lyžařská helma, chránič zad a celé rukavice. Není to volitelné, když skáčeš nebo slideuješ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein passender Skihelm, ein Rückenprotektor und geschlossene Handschuhe. Nicht verhandelbar, wenn du springst oder slidest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un casco de esquí que ajuste, una espaldera y guantes enteros. No es opcional si saltas o deslizas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un casco da sci che sta fermo, un paraschiena e guanti interi. Non è facoltativo se salti o slitti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合ったスキーヘルメット、バックプロテクター、指まで覆う手袋。ジャンプやスライドなら必須。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞는 스키 헬멧, 등 보호대, 손가락까지 덮는 장갑. 점프나 슬라이드면 선택이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En skihjelm som sitter, en ryggbeskytter og hele hansker. Ikke valgfritt hvis du hopper eller slider."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een skihelm die past, een rugbeschermer en dichte handschoenen. Niet optioneel als je springt of slidet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasowany kask narciarski, ochraniacz pleców i pełne rękawice. Nie do negocjacji, gdy skaczesz albo slidujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um capacete de esqui justo, uma proteção dorsal e luvas fechadas. Não é opcional se saltas ou deslizas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En skidhjälm som sitter, ett ryggskydd och hela handskar. Inte valfritt om du hoppar eller slidar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合适的滑雪头盔、护背和全指手套。要跳或滑杆就不是可选项。"
          }
        }
      }
    },
    "trick.protections.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A beanie under the helmet is not a helmet. Landing bumps are often hard in the afternoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bonnet sous le casque ne remplace pas le casque. Les bosses de réception sont souvent dures l'après-midi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čepice pod helmou není helma. Boule na dopadu jsou odpoledne často tvrdé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mütze unter dem Helm ist kein Helm. Landungsbuckel sind nachmittags oft hart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gorro bajo el casco no es un casco. Los baches de recepción suelen estar duros por la tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un berretto sotto il casco non è un casco. Le gobbe in ricezione spesso sono dure nel pomeriggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルメットの下のニット帽はヘルメットではない。着地のコブは午後に硬くなりやすい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헬멧 속 비니는 헬멧이 아니야. 착지 범프는 오후에 종종 딱딱해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lue under hjelmen er ingen hjelm. Landingshumpene er ofte harde på ettermiddagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een muts onder de helm is geen helm. Landingshobbels zijn ’s middags vaak hard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czapka pod kaskiem to nie kask. Garby na lądowaniu po południu często są twarde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma touca por baixo do capacete não é um capacete. As lombas da receção ficam duras à tarde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mössa under hjälmen är ingen hjälm. Landningsguppen är ofta hårda på eftermiddagen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头盔里面的帽子不是头盔。落地区的包下午常常变硬。"
          }
        }
      }
    },
    "trick.protections.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helmet does not shift when you shake your head. The strap is closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le casque ne bouge pas quand tu secoues la tête. La sangle est fermée."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Helma se nehne, když zavrtíš hlavou. Řemínek je zapnutý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Helm rutscht nicht, wenn du den Kopf schüttelst. Der Riemen ist zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El casco no se mueve si sacudes la cabeza. La correa está cerrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il casco non si muove se scuoti la testa. Il cinturino è chiuso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭を振ってもヘルメットが動かない。あごひもは閉じている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고개를 흔들어도 헬멧이 안 움직여. 끈은 잠겨 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelmen flytter seg ikke når du rister på hodet. Remmen er lukket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De helm schuift niet als je je hoofd schudt. De band is dicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kask nie rusza się, gdy kręcisz głową. Pasek jest zapięty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O capacete não mexe se abanares a cabeça. A fivela está fechada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälmen rör sig inte när du skakar på huvudet. Remmen är stängd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摇头时头盔不晃。带子扣上。"
          }
        }
      }
    },
    "trick.protections.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The back protector covers the middle of the back, not only the shoulders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dorsale couvre le milieu du dos, pas seulement les épaules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chránič zad kryje střed zad, ne jen ramena."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rückenprotektor deckt die Mitte des Rückens, nicht nur die Schultern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La espaldera cubre el centro de la espalda, no solo los hombros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il paraschiena copre il centro della schiena, non solo le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックプロテクターは背中の真ん中を覆う。肩だけではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등 보호대는 등의 가운데를 덮어. 어깨만이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryggbeskytteren dekker midten av ryggen, ikke bare skuldrene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rugbeschermer dekt het midden van de rug, niet alleen de schouders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochraniacz pleców zakrywa środek pleców, nie tylko ramiona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A proteção dorsal cobre o meio das costas, não só os ombros."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryggskyddet täcker mitten av ryggen, inte bara axlarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "护背盖住后背中间，不只是肩膀。"
          }
        }
      }
    },
    "trick.protections.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knee and hip padding helps the day you learn butters and switch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des genoux et des fesses protégés aident le jour où tu apprends les butters et le switch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrániče kolen a boků pomůžou v den, kdy se učíš buttery a switch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie- und Hüftpolster helfen an dem Tag, an dem du Butter und Switch lernst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodilleras y cadera ayudan el día que aprendes butters y switch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginocchia e anche protette aiutano il giorno in cui impari butter e switch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バターやスイッチを覚える日は膝と腰のパッドが助けになる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버터와 스위치를 배우는 날에는 무릎과 엉덩이 보호가 도움이 돼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kne- og hoftebeskyttelse hjelper den dagen du lærer butters og switch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie- en heupbescherming helpt de dag dat je butters en switch leert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochraniacze kolan i bioder pomagają w dniu, gdy uczysz się butterów i switcha."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joelheiras e anca ajudam no dia em que aprendes butters e switch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knä- och höftskydd hjälper dagen du lär dig butters och switch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学黄油转和反脚的那天，护膝和护髋有用。"
          }
        }
      }
    },
    "trick.protections.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buckle the boots tight. Play in the shell and the landing goes sideways."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resserre les chaussures. Un jeu dans la coque, et la réception part de travers."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Utáhni boty. Vůle v holeni a dopad ujede do strany."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnall die Schuhe fest. Spiel im Schaft und die Landung geht seitlich weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprieta las botas. Holgura en la caña y la recepción se va de lado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allaccia gli scarponi. Gioco nel gambetto e l'atterraggio parte di lato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブーツを締める。甲に遊びがあると着地が横に流れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부츠를 조여. 샤프트가 놀면 착지가 옆으로 새."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stram støvlene. Slark i skaftet og landingen går sidelengs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Riem de schoenen vast. Speling in de schacht en de landing gaat zijwaarts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnij buty. Luz w cholewce i lądowanie ucieka w bok."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperta as botas. Folga no cano e a aterragem foge para o lado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spänn pjäxorna. Glapp i skaftet och landningen går åt sidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扣紧雪鞋。鞋筒有空隙，落地就会往旁边跑。"
          }
        }
      }
    },
    "trick.protections.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the helmet took a hard hit, replace it. The foam can be dead without looking broken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le casque a pris un gros choc, on le change. La mousse ne se voit pas, mais elle ne protège plus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostala-li helma tvrdou ránu, vyměň ji. Pěna může být mrtvá, i když to není vidět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat der Helm einen harten Schlag bekommen, tausch ihn. Der Schaum kann tot sein, ohne dass man es sieht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el casco recibió un golpe fuerte, cámbialo. La espuma puede estar muerta sin verse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il casco ha preso un colpo forte, cambialo. La schiuma può essere morta senza sembrarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルメットが強い衝撃を受けたら替える。見た目は無事でもフォームは死んでいることがある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헬멧이 세게 맞았으면 바꿔. 겉은 괜찮아 보여도 폼은 죽었을 수 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis hjelmen fikk et hardt slag, bytt den. Skummet kan være dødt uten at det synes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de helm een harde klap kreeg, vervang hem. Het schuim kan dood zijn zonder dat je het ziet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli kask dostał mocne uderzenie, wymień go. Pianka może być martwa, choć tego nie widać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o capacete levou um impacto forte, troca-o. A espuma pode estar morta sem se ver."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om hjälmen tog en hård smäll, byt den. Skummet kan vara dött utan att det syns."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头盔受过重击就换掉。外表看不出来，里面的泡沫也可能已经废了。"
          }
        }
      }
    },
    "trick.protections.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gloves with a reinforced palm save an open hand on a rail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des gants avec une paume renforcée évitent les mains ouvertes sur un rail."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rukavice se zesílenou dlaní chrání otevřenou ruku na railu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handschuhe mit verstärkter Handfläche schützen eine offene Hand auf dem Rail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guantes con la palma reforzada salvan una mano abierta en un rail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guanti con il palmo rinforzato salvano una mano aperta su un rail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "掌が強化された手袋は、レールで開いた手を守る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손바닥이 보강된 장갑은 레일에서 편 손을 지켜."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hansker med forsterket håndflate redder en åpen hånd på en rail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handschoenen met een versterkte palm redden een open hand op een rail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rękawice ze wzmocnioną dłonią chronią otwartą dłoń na railu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Luvas com a palma reforçada poupam uma mão aberta num carril."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Handskar med förstärkt handflata räddar en öppen hand på en rail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "掌心加厚的手套能保护在杆上张开的手。"
          }
        }
      }
    },
    "trick.fall-better.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fall without snapping"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomber sans se casser"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Padnout bez zlomeniny"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallen, ohne zu brechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caer sin romperse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadere senza rompersi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折れずに転ぶ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부러지지 않고 넘어지기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Falle uten å knekke"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vallen zonder te breken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upaść bez złamania"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cair sem partir"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Falla utan att gå av"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摔倒但不折断"
          }
        }
      }
    },
    "trick.fall-better.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will fall. The goal is to slide, not to post a hand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vas tomber. Le but est de glisser, pas de planter les mains."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spadneš. Cílem je klouzat, ne zapíchnout ruku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst fallen. Das Ziel ist zu rutschen, nicht die Hand zu stemmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas a caer. El objetivo es deslizar, no clavar la mano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadrai. Lo scopo è scivolare, non piantare la mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転ぶ。目的は滑ること。手をつくことではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넘어질 거야. 목표는 미끄러지는 거지, 손을 박는 게 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer til å falle. Målet er å skli, ikke å plante en hånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gaat vallen. Het doel is glijden, niet een hand planten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upadniesz. Celem jest ślizg, nie wbita dłoń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vais cair. O objetivo é deslizar, não espetar a mão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kommer att falla. Målet är att glida, inte att sätta i en hand."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会摔。目标是滑出去，不是用手撑。"
          }
        }
      }
    },
    "trick.fall-better.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planting a hand to 'catch yourself' breaks a wrist or a thumb. You accept the slide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une main plantée pour « se rattraper » casse un poignet ou un pouce. Tu acceptes de glisser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruka zapíchnutá, abys se „chytil”, zlomí zápěstí nebo palec. Klouzání přijmeš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Hand, die du „zum Abfangen“ aufsetzt, bricht ein Handgelenk oder einen Daumen. Du nimmst den Rutsch an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mano clavada para «salvarte» rompe una muñeca o un pulgar. Aceptas el desliz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mano piantata per «salvarsi» rompe un polso o un pollice. Accetti lo scivolone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「受けよう」とついた手は手首か親指を折る。滑ることを受け入れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘받치려고’ 박은 손은 손목이나 엄지를 부러뜨려. 미끄러짐을 받아들여."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En hånd du planter for å ta deg imot knekker et håndledd eller en tommel. Du tar sklien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hand die je plant om je op te vangen breekt een pols of een duim. Je neemt de glijpartij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dłoń wbita, żeby się „złapać”, łamie nadgarstek albo kciuk. Przyjmujesz ślizg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mão espetada para «te salvares» parte um pulso ou um polegar. Aceitas o deslize."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En hand som du sätter i för att ta emot dig bryter en handled eller en tumme. Du tar glidet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了“撑住”而撑出去的手会折手腕或拇指。你接受滑出去。"
          }
        }
      }
    },
    "trick.fall-better.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuck the arms. Thumbs along the hands, not stuck out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentre les bras. Les pouces le long des mains, pas écartés."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhni ruce. Palce podél dlaní, ne ven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arme einziehen. Daumen an den Händen, nicht abgespreizt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mete los brazos. Pulgares junto a las manos, no abiertos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritira le braccia. Pollici lungo le mani, non aperti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕をしまう。親指は手に沿わせ、突き出さない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔을 넣어. 엄지는 손 옆에, 밖으로 빼지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk inn armene. Tomlene langs hendene, ikke ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Armen intrekken. Duimen langs de handen, niet uitgestoken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowaj ręce. Kciuki przy dłoniach, nie odstające."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encolhe os braços. Polegares junto às mãos, não abertos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra in armarna. Tummarna längs händerna, inte utåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手臂收回来。拇指贴着手，不要伸出去。"
          }
        }
      }
    },
    "trick.fall-better.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fall to the side, hip and thigh, and let yourself slide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombe sur le côté, hanche et cuisse, et laisse-toi glisser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Padni na bok, bok a stehno, a nech se klouzat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falle auf die Seite, Hüfte und Oberschenkel, und lass dich rutschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cae de lado, cadera y muslo, y déjate deslizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadi di lato, anca e coscia, e lasciati scivolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横、腰と太ももで転び、滑らせる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆, 엉덩이와 허벅지로 넘어지고 미끄러져."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fall på siden, hofte og lår, og la deg skli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Val op je zij, heup en dij, en laat je glijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Padnij na bok, biodro i udo, i daj się ślizgać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cai de lado, anca e coxa, e deixa-te deslizar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Falla på sidan, höft och lår, och låt dig glida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧着摔，用髋和大腿，让自己滑出去。"
          }
        }
      }
    },
    "trick.fall-better.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chin toward the chest so the back of the helmet hits before the neck."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menton se rentre vers la poitrine pour que l'arrière du casque touche avant la nuque."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Brada k hrudi, ať se helma dotkne zezadu dřív než krk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinn zur Brust, damit der Hinterkopf des Helms kommt, bevor der Nacken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barbilla al pecho para que toque primero la nuca del casco, no el cuello."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mento verso il petto così tocca prima la nuca del casco, non il collo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あごを胸に。首より先にヘルメットの後ろが当たる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턱을 가슴으로. 목보다 헬멧 뒤가 먼저 닿게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Haken mot brystet så bakhodet på hjelmen treffer før nakken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kin naar de borst zodat de achterkant van de helm raakt vóór de nek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Broda do klatki, żeby tył kasku dotknął przed karkiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queixo ao peito para tocar primeiro a nuca do capacete, não o pescoço."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakan mot bröstet så hjälmens bakdel tar före nacken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下巴收到胸口，让头盔后部先碰到，而不是脖子。"
          }
        }
      }
    },
    "trick.fall-better.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't stand up while you are still on a jump or rail line."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne te relève pas tant que tu es sur la ligne d'un saut ou d'un rail."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevstávej, dokud jsi na linii skoku nebo railu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh nicht auf, solange du noch auf der Linie eines Sprungs oder Rails bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te levantes mientras sigues en la línea de un salto o un rail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rialzarti finché sei sulla linea di un salto o di un rail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャンプやレールのラインにいるうちは起き上がらない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점프나 레일 라인 위에 있는 동안은 일어나지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reis deg ikke mens du fortsatt er på linjen til et hopp eller en rail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta niet op zolang je op de lijn van een jump of rail ligt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wstawaj, póki jesteś na linii skoku albo raila."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não te levantes enquanto estiveres na linha de um salto ou de um carril."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Res dig inte så länge du är på linjen för ett hopp eller en rail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还在跳台或杆的线路上时不要站起来。"
          }
        }
      }
    },
    "trick.fall-better.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice falling on a gentle slope, slow, before the park."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi à tomber sur une pente douce, à petite vitesse, avant le park."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénuj pád na mírném svahu, pomalu, před parkem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe das Fallen an einem flachen Hang, langsam, vor dem Park."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica caer en una pendiente suave, despacio, antes del park."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati a cadere su un pendio dolce, piano, prima del park."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パークの前に、緩い斜面でゆっくり転ぶ練習を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파크 전에 완만한 슬로프에서 천천히 넘어지는 연습을 해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv på å falle i en slak bakke, sakte, før parken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen vallen op een flauwe helling, langzaam, vóór het park."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz upadek na łagodnym stoku, wolno, przed parkiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treina a cair numa encosta suave, devagar, antes do park."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öva att falla i en flack backe, långsamt, före parken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进公园之前，在缓坡上慢慢练摔倒。"
          }
        }
      }
    },
    "trick.fall-better.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are unsure about pain in the head, neck or back: stop and call. Not 'one more run'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as un doute sur une douleur à la tête, au cou ou au dos : tu t'arrêtes, tu appelles. Pas de « encore un run »."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když si nejsi jistý bolestí hlavy, krku nebo zad: zastav a volej. Ne „ještě jeden sjezd”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du unsicher bist bei Schmerz an Kopf, Nacken oder Rücken: Stopp und anrufen. Nicht „noch eine Abfahrt“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dudas de un dolor en cabeza, cuello o espalda: para y llama. No «una bajada más»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai un dubbio su un dolore a testa, collo o schiena: fermati e chiama. Non «ancora una discesa»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭、首、背中の痛みが不安なら止まって電話。 「もう一本」はしない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리, 목, 등 통증이 애매하면 멈추고 전화해. ‘한 번 더’는 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du er usikker på smerte i hodet, nakken eller ryggen: stopp og ring. Ikke «en nedfart til»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij twijfel over pijn aan hoofd, nek of rug: stop en bel. Niet ‘nog een afdaling’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy nie jesteś pewien bólu głowy, karku albo pleców: stop i dzwoń. Nie „jeszcze jeden zjazd”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tiveres dúvida numa dor na cabeça, pescoço ou costas: pára e liga. Não «mais uma descida»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du är osäker på smärta i huvud, nacke eller rygg: stanna och ring. Inte ”ett åk till”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头、脖子或后背的疼拿不准：停下并打电话。不是“再滑一趟”。"
          }
        }
      }
    },
    "trick.read-jump.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a jump"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire un saut"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečíst skok"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Sprung lesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer un salto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere un salto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャンプを読む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점프 읽기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lese et hopp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een jump lezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytać skok"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler um salto"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läsa ett hopp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看懂一个跳台"
          }
        }
      }
    },
    "trick.read-jump.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The jump is won before the lip. You pick the speed, you see the landing, you decide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le saut se gagne avant le kick. Tu choisis la vitesse, tu vois la réception, tu décides."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skok se vyhrává před hranou. Zvolíš rychlost, uvidíš dopad a rozhodneš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sprung ist vor der Lippe gewonnen. Du wählst das Tempo, siehst die Landung und entscheidest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El salto se gana antes del labio. Eliges la velocidad, ves la recepción y decides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salto si vince prima del lip. Scegli la velocità, vedi la ricezione, decidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャンプはリップの前に決まる。速さを選び、着地を見て、決める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점프는 립 전에 이긴다. 속도를 고르고, 착지를 보고, 결정해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoppet vinnes før lippen. Du velger farten, ser landingen og bestemmer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De jump win je vóór de lip. Je kiest de snelheid, ziet de landing en beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skok wygrywa się przed krawędzią. Wybierasz prędkość, widzisz lądowanie i decydujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O salto ganha-se antes do lábio. Escolhes a velocidade, vês a receção e decides."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoppet vinns före lippen. Du väljer farten, ser landningen och bestämmer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳台在唇沿之前就定了。你选速度，看见落地区，再决定。"
          }
        }
      }
    },
    "trick.read-jump.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never stop on the flat just after a lip, or on the landing. The next rider is faster than you think."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne s'arrête jamais sur le plat juste après un kick, ni sur la réception. Les autres arrivent vite."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy nestůj na rovince hned za hranou ani na dopadu. Další je rychlejší, než si myslíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt nie auf dem Flachen direkt nach der Lippe und nie auf der Landung. Der Nächste ist schneller, als du denkst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca pares en el llano justo después del labio ni en la recepción. El siguiente va más rápido de lo que crees."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non fermarti mai sul piatto appena dopo il lip, né sulla ricezione. Il prossimo è più veloce di quanto pensi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リップ直後の平らにも、着地にも止まらない。次の人は思ったより速い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "립 바로 뒤의 평지에도, 착지에도 멈추지 마. 다음 사람은 생각보다 빨라."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp aldri på flaten rett etter lippen, eller i landingen. Den neste er raskere enn du tror."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop nooit op het vlakke net na de lip, en nooit op de landing. De volgende is sneller dan je denkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie stój na płaskim tuż za krawędzią ani na lądowaniu. Następny jest szybszy, niż myślisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca pares no plano logo a seguir ao lábio, nem na receção. O seguinte vai mais rápido do que pensas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanna aldrig på flacket precis efter lippen, eller på landningen. Nästa är snabbare än du tror."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要停在唇沿后面的平地上，也不要停在落地区。后面的人比你想的快。"
          }
        }
      }
    },
    "trick.read-jump.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop on the side, never on the track, and look at the lip then the landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête-toi sur le côté, jamais sur la trajectoire, et regarde le kick puis la réception."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastav se stranou, nikdy na stopě, a podívej se na hranu a pak na dopad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt seitlich an, nie auf der Spur, und schau erst die Lippe, dann die Landung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a un lado, nunca en la línea, y mira el labio y luego la recepción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermati di lato, mai sulla traiettoria, e guarda prima il lip poi la ricezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横で止まる。ラインの上では止まらない。先にリップ、次に着地を見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆에서 멈춰. 라인 위에서는 멈추지 마. 립을 보고 그다음 착지를 봐."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp på siden, aldri på sporet, og se på lippen og deretter landingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop aan de zijkant, nooit op het spoor, en kijk eerst naar de lip, dan de landing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj się z boku, nigdy na linii, i zobacz krawędź, potem lądowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pára de lado, nunca na linha, e olha o lábio e depois a receção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanna vid sidan, aldrig på spåret, och titta på lippen och sedan landningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停在旁边，不要停在线路上。先看唇沿，再看落地区。"
          }
        }
      }
    },
    "trick.read-jump.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where the slope continues. If you cannot see the bottom, you do not go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère où la piste reprend. Si tu ne vois pas le bas, tu ne pars pas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívej se, kde sjezdovka pokračuje. Nevidíš-li konec, nejedeš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wo die Piste weitergeht. Wenn du das Ende nicht siehst, fährst du nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira dónde sigue la pista. Si no ves el final, no sales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi dove la pista riprende. Se non vedi il fondo, non parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "斜面がどこへ続くか見る。下が見えなければ出ない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬로프가 어디로 이어지는지 봐. 아래가 안 보이면 나가지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvor løypa fortsetter. Ser du ikke bunnen, kjører du ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie waar de piste verdergaat. Zie je de onderkant niet, dan ga je niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, gdzie trasa wraca. Jeśli nie widzisz dołu, nie jedziesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê onde a pista continua. Se não vês o fundo, não partes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se var pisten fortsätter. Ser du inte slutet åker du inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看雪道从哪里接上。看不见下面，就不要出发。"
          }
        }
      }
    },
    "trick.read-jump.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch two riders to learn the speed: too short, or too long."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde deux riders passer pour comprendre la vitesse : trop court, ou trop long."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj dva jezdce, ať pochopíš rychlost: moc krátký, nebo moc dlouhý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau zwei Fahrer an, um das Tempo zu lernen: zu kurz oder zu lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira a dos riders para aprender la velocidad: demasiado corto o demasiado largo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda due rider per capire la velocità: troppo corto o troppo lungo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二人見て速さを覚える。短すぎるか、長すぎるか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 명을 보고 속도를 익혀. 너무 짧은지, 너무 긴지."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på to kjørere for å lære farten: for kort eller for lang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk naar twee rijders om de snelheid te leren: te kort of te lang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popatrz na dwóch riderów, żeby poznać prędkość: za krótko albo za długo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê dois riders para perceber a velocidade: curto demais ou longo demais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta på två åkare för att lära dig farten: för kort eller för lång."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看两个人滑，学会速度：太短，还是太长。"
          }
        }
      }
    },
    "trick.read-jump.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a start point. Too high means too fast. Too low and you land on the flat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère un point de départ. Trop haut = trop vite. Trop bas = tu poses sur le plat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvol start. Moc vysoko je moc rychle. Moc nízko a dopadneš na rovinku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Startpunkt. Zu hoch heißt zu schnell. Zu tief und du landest auf dem Flachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un punto de salida. Demasiado arriba es demasiado rápido. Demasiado abajo y caes en el llano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un punto di partenza. Troppo in alto è troppo veloce. Troppo in basso e atterri sul piatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタート地点を決める。高すぎると速すぎる。低すぎると平らに着く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발 지점을 정해. 너무 높으면 너무 빠르고, 너무 낮으면 평지에 착지해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et startpunkt. For høyt er for fort. For lavt og du lander på flaten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een startpunt. Te hoog is te snel. Te laag en je landt op het vlakke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz punkt startu. Za wysoko to za szybko. Za nisko i lądujesz na płaskim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um ponto de partida. Alto demais é rápido demais. Baixo demais e aterras no plano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en startpunkt. För högt är för fort. För lågt och du landar på flacket."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个出发点。太高就是太快。太低就会落在平地上。"
          }
        }
      }
    },
    "trick.read-jump.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first hit is straight, no grab and no spin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier passage se fait droit, sans grab et sans rotation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První jízda je rovně, bez grabu a bez rotace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Versuch ist geradeaus, ohne Grab und ohne Drehung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer intento es recto, sin grab y sin giro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo passaggio è dritto, senza grab e senza rotazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初はストレート。グラブもスピンもしない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째는 직진이야. 그랩도 회전도 없이."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første forsøk er rett, uten grab og uten spinn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste hit is recht, zonder grab en zonder spin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy przejazd jest na wprost, bez graba i bez obrotu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira passagem é a direito, sem grab e sem rotação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första försöket är rakt, utan grab och utan snurr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次直着滑，不抓板，不转。"
          }
        }
      }
    },
    "trick.read-jump.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean S jump beats a missed M."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un saut S bien pris vaut mieux qu'un M raté."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čistý skok S je lepší než minutý M."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sauberer S-Sprung schlägt einen verpassten M."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salto S limpio vale más que un M fallado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salto S pulito batte un M sbagliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決まったSは外したMに勝る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨끗한 S가 놓친 M보다 낫다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rent S-hopp slår et bommet M."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schone S-jump verslaat een gemiste M."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysty skok S jest lepszy niż spudłowane M."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um salto S limpo vale mais do que um M falhado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett rent S-hopp slår ett missat M."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个干净的 S 胜过一个没做成的 M。"
          }
        }
      }
    },
    "trick.read-jump.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headwind or flat light hides the landing. Wait."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le vent de face est fort ou que la lumière est plate, la réception se voit mal. Attends."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protivítr nebo ploché světlo schová dopad. Počkej."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegenwind oder flaches Licht versteckt die Landung. Warte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viento de cara o la luz plana esconden la recepción. Espera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vento contrario o luce piatta nascondono la ricezione. Aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向かい風やフラットな光は着地を隠す。待つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞바람이나 평평한 빛은 착지를 가려. 기다려."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Motvind eller flatt lys skjuler landingen. Vent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegenwind of vlak licht verbergt de landing. Wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiatr w twarz albo płaskie światło chowa lądowanie. Czekaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vento de frente ou luz plana escondem a receção. Espera."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Motvind eller platt ljus döljer landningen. Vänta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逆风或平光会把落地区藏起来。等一等。"
          }
        }
      }
    },
    "trick.straight-air.name": {
      "extractionState": "manual",
      "localizations": {
