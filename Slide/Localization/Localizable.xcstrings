          }
        }
      }
    },
    "trick.switch-riding.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch means the other foot in front. Without it, 180s and slides stay guesses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch = à l'envers, l'autre pied devant. Sans ça, les 180 et les slides restent des paris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch znamená druhá noha vpředu. Bez toho 180 a slidy zůstanou tipováním."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch heißt: der andere Fuß ist vorn. Ohne das bleiben 180 und Slides ein Raten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch significa el otro pie delante. Sin eso, los 180 y los slides siguen siendo apuestas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch vuol dire l'altro piede davanti. Senza, 180 e slide restano scommesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチは逆の足が前。これがないと180もスライドも勘のまま。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치는 반대 발이 앞이야. 그게 없으면 180과 슬라이드는 맞히기야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch betyr den andre foten foran. Uten det blir 180 og slides gjetting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch betekent de andere voet voor. Zonder dat blijven 180s en slides gokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch znaczy druga stopa z przodu. Bez tego 180 i slide’y zostają zgadywaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch significa o outro pé à frente. Sem isso, os 180 e os slides continuam apostas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch betyder andra foten fram. Utan det förblir 180 och slides gissningar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反脚就是另一只脚在前面。没有这个，180 和滑杆都是在猜。"
          }
        }
      }
    },
    "trick.switch-riding.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch tires muscles you don't usually use. Stop before you cut someone off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le switch fatigue des muscles que tu n'utilises pas. Arrête-toi avant de croiser quelqu'un n'importe comment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch unaví svaly, které skoro nepoužíváš. Zastav se, než někoho přetneš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch ermüdet Muskeln, die du sonst kaum nutzt. Hör auf, bevor du jemanden schneidest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El switch cansa músculos que casi no usas. Para antes de cruzarte con alguien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo switch stanca muscoli che usi poco. Fermati prima di tagliare qualcuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチは普段使わない筋肉を疲れさせる。人を横切る前にやめる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치는 평소에 안 쓰는 근육을 지치게 해. 누군가를 가로막기 전에 멈춰."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch sliter muskler du nesten ikke bruker. Stopp før du skjærer av noen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch vermoeit spieren die je bijna niet gebruikt. Stop voordat je iemand afsnijdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch męczy mięśnie, których prawie nie używasz. Zatrzymaj się, zanim kogoś przetniesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O switch cansa músculos que quase não usas. Pára antes de cortares alguém."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch tröttar muskler du sällan använder. Stanna innan du skär av någon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反脚会累到你平时不用的肌肉。在横穿别人之前停下来。"
          }
        }
      }
    },
    "trick.switch-riding.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the flat, slide switch just to feel which foot is forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le plat, glisse en switch, juste pour sentir quel pied est devant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na rovině kloužeš switch, jen ať cítíš, která noha je vpředu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Flachen gleitest du switch, nur um zu spüren, welcher Fuß vorn ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el llano deslizas en switch, solo para sentir qué pie va delante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul piatto scivoli in switch, solo per sentire quale piede è davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平らでスイッチに滑り、どっちの足が前か感じるだけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평지에서 스위치로 미끄러지며 어느 발이 앞인지 느껴."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På flaten sklir du switch, bare for å kjenne hvilken fot som er foran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op het vlakke glij je switch, alleen om te voelen welke voet voor is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na płaskim ślizgasz się switch, tylko żeby poczuć, która stopa jest z przodu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No plano deslizas em switch, só para sentires que pé vai à frente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På flacket glider du switch, bara för att känna vilken fot som är fram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在平地上反脚滑一下，只为感觉哪只脚在前面。"
          }
        }
      }
    },
    "trick.switch-riding.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ski a whole green run switch, wide turns."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends une verte entière en switch, virages larges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjeď celou zelenou switch, širokými oblouky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahr eine ganze grüne Piste switch, mit weiten Schwüngen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquía una verde entera en switch, con virajes amplios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scia un'intera pista verde in switch, con curve larghe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリーンを一本、スイッチで広いターンで滑る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그린 한 코스를 스위치로, 넓은 턴으로 타."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør en hel grønn løype switch, med vide svinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ski een hele groene piste switch, met wijde bochten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjedź całą zieloną switch, szerokimi skrętami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquia uma verde inteira em switch, com curvas largas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åk en hel grön pist switch, med breda svängar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整条绿道用反脚滑，转弯要大。"
          }
        }
      }
    },
    "trick.switch-riding.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands low, a bit more weight on the uphill ski, like forwards — mirrored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les mains basses et le poids un peu plus sur le ski amont, comme en avant… mais tout est miroir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruce nízko, o něco víc váhy na horní lyži, jako dopředu — jen zrcadlově."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hände tief, etwas mehr Gewicht auf dem Bergski, wie vorwärts — nur gespiegelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manos bajas, un poco más de peso en el esquí de arriba, como de frente, pero en espejo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani basse, un po' più di peso sullo sci a monte, come in avanti — solo allo specchio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手は低く、山側のスキーに少し多めの体重。前と同じ、左右が逆。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손은 낮게, 위쪽 스키에 무게를 조금 더. 정방향과 같고, 거울처럼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hender lavt, litt mer vekt på overskien, som forover — bare speilvendt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handen laag, iets meer gewicht op de bergski, zoals vooruit — alleen gespiegeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręce nisko, trochę więcej ciężaru na narcie od góry, jak przodem — tylko w lustrze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mãos baixas, um pouco mais de peso no esqui de montante, como para a frente — só ao espelho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Händer lågt, lite mer vikt på överskidan, som framåt — bara spegelvänt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手放低，上侧雪板多一点重量，和正脚一样，只是镜像。"
          }
        }
      }
    },
    "trick.switch-riding.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do traverses, then small carved turns."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais des traversées, puis des petits virages coupés."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dělej traverzy, pak malé řezané oblouky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach Traversen, dann kleine geschnittene Schwünge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz travesías y luego virajes cortados pequeños."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai delle traverse, poi piccole curve tagliate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "斜滑してから、小さくカービングする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트래버스 다음에 작은 카빙 턴."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør traverser, så små skårede svinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe traverses, daarna kleine gesneden bochten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rób trawersy, potem małe cięte skręty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz travessias e depois curvas cortadas pequenas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör traverser, sedan små skurna svängar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先横滑，再做小的刻滑转弯。"
          }
        }
      }
    },
    "trick.switch-riding.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a green switch is boring, move to an easy blue. Not before."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une verte en switch est ennuyeuse, passe à une bleue facile. Pas avant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až bude zelená switch nudná, přejdi na snadnou modrou. Ne dřív."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine grüne Piste switch langweilig wird, geh auf eine leichte blaue. Nicht vorher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una verde en switch aburre, pasa a una azul fácil. No antes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una verde in switch è noiosa, passa a una blu facile. Non prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチのグリーンが退屈になってから、易しいブルーへ。その前ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치 그린이 지루해진 다음에 쉬운 블루로. 그 전은 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en grønn switch er kjedelig, gå til en lett blå. Ikke før."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een groene switch saai wordt, ga naar een makkelijke blauwe. Niet eerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zielona switch jest nudna, przejdź na łatwą niebieską. Nie wcześniej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma verde em switch for aborrecida, passa a uma azul fácil. Não antes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en grön switch är tråkig, gå till en lätt blå. Inte innan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反脚滑绿道觉得无聊了，再去一条容易的蓝道。在那之前不要。"
          }
        }
      }
    },
    "trick.switch-riding.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes each lift beats one hour on the last day of the trip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq minutes à chaque remontée valent mieux qu'une heure le dernier jour des vacances."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pět minut na každém vleku je víc než hodina poslední den dovolené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Minuten pro Lift schlagen eine Stunde am letzten Ferientag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco minutos en cada remonte valen más que una hora el último día de vacaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque minuti a ogni risalita battono un'ora l'ultimo giorno di vacanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リフトごとに五分のほうが、休み最後の日の一時間よりいい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리프트마다 5분이 휴가 마지막 날 한 시간보다 낫다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem minutter hver heis slår en time siste feriedag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf minuten per lift verslaan een uur op de laatste vakantiedag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć minut na każdym wyciągu jest lepsze niż godzina ostatniego dnia ferii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco minutos em cada subida valem mais do que uma hora no último dia de férias."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem minuter varje lift slår en timme sista semesterdagen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次坐缆车练五分钟，比假期最后一天练一小时有用。"
          }
        }
      }
    },
    "trick.switch-riding.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look far. In switch the eyes drop toward the back tip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde loin. En switch, le regard a tendance à tomber sur la spatule arrière."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívej se daleko. Ve switch pohled snadno spadne na zadní špičku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau weit. Im Switch fällt der Blick leicht auf die hintere Spitze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira lejos. En switch la mirada cae fácil hacia la punta de atrás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lontano. In switch lo sguardo cade facilmente sulla punta dietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠くを見る。スイッチだと視線が後ろの先に落ちやすい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리 봐. 스위치에서는 시선이 뒤쪽 끝으로 떨어지기 쉬워."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se langt. I switch faller blikket lett mot den bakre tuppen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk ver. In switch valt de blik makkelijk op de achterste tip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz daleko. W switch wzrok łatwo spada na tylny dziób."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha longe. Em switch o olhar cai facilmente na ponta de trás."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta långt. I switch faller blicken lätt mot den bakre spetsen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看远。反脚时眼睛容易掉到后面的板头上。"
          }
        }
      }
    },
