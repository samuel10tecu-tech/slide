        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 시도가 아니라, 깨끗하게 착지하면 체크해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Huk av når du lander rent, ikke på første forsøk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vink het af als je het schoon landt, niet bij de eerste poging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odznacz, gdy lądujesz czysto, nie za pierwszym razem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca quando aterrares limpo, não à primeira tentativa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bocka av när du landar rent, inte på första försöket."
