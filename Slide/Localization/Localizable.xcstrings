        }
      }
    },
    "trick.landing.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A good landing is soft in the legs and steady in the eyes. The ski touches, the body follows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bonne réception est molle dans les jambes et solide dans le regard. Le ski touche, le corps suit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrý dopad je měkký v nohou a klidný v očích. Lyže se dotkne, tělo jde za ní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gute Landung ist weich in den Beinen und ruhig im Blick. Der Ski berührt, der Körper folgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una buena recepción es blanda en las piernas y firme en la mirada. El esquí toca, el cuerpo sigue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una buona ricezione è morbida nelle gambe e ferma nello sguardo. Lo sci tocca, il corpo segue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "良い着地は脚が柔らかく、目が安定している。スキーが先に着き、体が続く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 착지는 다리는 부드럽고 시선은 흔들리지 않아. 스키가 닿고 몸이 따라와."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En god landing er myk i beina og rolig i blikket. Skien treffer, kroppen følger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een goede landing is zacht in de benen en rustig in de blik. De ski raakt, het lichaam volgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre lądowanie jest miękkie w nogach i spokojne w oczach. Narta dotyka, ciało idzie za nią."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma boa receção é mole nas pernas e firme no olhar. O esqui toca, o corpo segue."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bra landning är mjuk i benen och stadig i blicken. Skidan tar, kroppen följer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好的落地腿是软的，眼睛是稳的。雪板先碰到，身体跟着。"
          }
        }
      }
    },
    "trick.landing.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Landing stiff means the knee takes the hit instead of the spring. If you are too long, take a slightly low landing rather than reaching for the flat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterrir tendu, c'est le genou qui encaisse à la place du ressort. Si tu sens que tu es trop long, assume une réception un peu basse plutôt qu'un rattrapage au plat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuhý dopad znamená, že úder bere koleno místo pružiny. Jsi-li moc dlouhý, vezmi o něco kratší dopad, místo sahání na rovinku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steif landen heißt: das Knie nimmt den Schlag statt der Feder. Wenn du zu lang bist, nimm eine etwas kurze Landung, statt das Flache zu greifen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterrizar rígido significa que la rodilla se lleva el golpe en vez del muelle. Si vas largo, quédate un poco corto en vez de buscar el llano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterrare rigido significa che il ginocchio prende il colpo al posto della molla. Se sei troppo lungo, accetta una ricezione un po' bassa invece di cercare il piatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "硬く着くと、バネの代わりに膝が衝撃を受ける。長すぎるなら、平らを狙わず少し手前の着地を取る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뻣뻣하게 착지하면 스프링 대신 무릎이 충격을 받아. 너무 길면 평지를 잡으려 하지 말고 조금 짧은 착지를 받아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lande stivt betyr at kneet tar støtet i stedet for fjæren. Er du for lang, ta en litt kort landing i stedet for å strekke deg mot flaten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stijf landen betekent dat de knie de klap krijgt in plaats van de veer. Ben je te lang, neem een iets korte landing in plaats van het vlakke te zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sztywne lądowanie znaczy, że kolano bierze uderzenie zamiast sprężyny. Jeśli jesteś za długi, weź trochę krótkie lądowanie, zamiast sięgać na płaskie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterrar rígido significa que o joelho leva o impacto em vez da mola. Se vais longo, aceita uma receção um pouco curta em vez de procurar o plano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att landa stelt betyder att knät tar smällen i stället för fjädern. Är du för lång, ta en lite kort landning i stället för att nå flacket."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "落地发僵，就是膝盖代替弹簧吃冲击。如果太长，宁可落得稍短一点，不要去够平地。"
          }
        }
      }
    },
    "trick.landing.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the air, prepare the legs: not locked, not glued to your hips."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En l'air, prépare les jambes : ni tendues, ni collées aux fesses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve vzduchu připrav nohy: ani natažené, ani přilepené k bokům."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Luft bereitest du die Beine vor: nicht gestreckt, nicht an die Hüfte geklebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el aire prepara las piernas: ni rígidas ni pegadas a la cadera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In aria prepara le gambe: né tese, né incollate ai fianchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空中で脚を用意する。伸ばしきりでも、腰にくっつけてもいない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공중에서 다리를 준비해. 잠그지도, 엉덩이에 붙이지도 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I lufta gjør du beina klare: ikke låst, ikke limt mot hoften."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de lucht zet je de benen klaar: niet gestrekt, niet tegen de heup geplakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W powietrzu przygotuj nogi: ani zablokowane, ani przyklejone do bioder."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No ar prepara as pernas: nem esticadas, nem coladas à anca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I luften förbereder du benen: inte låsta, inte klistrade mot höften."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空中准备好腿：不要锁死，也不要贴到髋上。"
          }
        }
      }
    },
    "trick.landing.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the slope with the skis. They land along the landing, not flat on the flat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche la pente avec les skis. Ils se posent dans le sens de la réception, pas à plat sur le plat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledej svah lyžemi. Dopadají po dopadu, ne naplocho na rovinu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such die Piste mit den Ski. Sie landen entlang der Landung, nicht flach auf dem Flachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca la pendiente con los esquís. Aterrizan a lo largo de la recepción, no planos en el llano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca la pista con gli sci. Si posano lungo la ricezione, non piatti sul piatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーで斜面を探す。着地の向きに着く。平らに平地へではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스키로 슬로프를 찾아. 착지 방향으로 닿아. 평지에 평평하게가 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn løypa med skiene. De lander langs landingen, ikke flatt på flaten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek de piste met de ski’s. Ze landen langs de landing, niet plat op het vlakke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj stoku nartami. Lądują wzdłuż lądowania, nie płasko na płaskim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura a pista com os esquis. Pousam ao longo da receção, não planos no plano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta pisten med skidorna. De landar längs landningen, inte platt på flacket."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用雪板找坡。顺着落地区落地，不要平拍在平地上。"
          }
        }
      }
    },
    "trick.landing.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On contact, flex ankle, knee, hip, in that order, like a spring."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au contact, plie chevilles-genoux-hanches dans cet ordre, comme un ressort."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při kontaktu pokrč kotník, koleno, bok, v tom pořadí, jako pružinu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Kontakt beugst du Knöchel, Knie, Hüfte, in dieser Reihenfolge, wie eine Feder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al contacto flexionas tobillo, rodilla y cadera, en ese orden, como un muelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al contatto piega caviglia, ginocchio, anca, in quest'ordine, come una molla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着いたら足首、膝、腰の順に曲げる。バネのように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닿으면 발목, 무릎, 엉덩이 순서로 굽혀. 스프링처럼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved kontakt bøyer du ankel, kne, hofte, i den rekkefølgen, som en fjær."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij contact buig je enkel, knie, heup, in die volgorde, als een veer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy kontakcie uginasz kostkę, kolano, biodro, w tej kolejności, jak sprężyna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No contacto fletes tornozelo, joelho e anca, por essa ordem, como uma mola."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid kontakt böjer du vrist, knä, höft, i den ordningen, som en fjäder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接触时按脚踝、膝盖、髋的顺序弯曲，像弹簧。"
          }
        }
      }
    },
    "trick.landing.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands stay low and in front. They do not go to the sky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mains restent basses et devant. Elles ne partent pas au ciel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruce zůstanou nízko a vpředu. Neletí k nebi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hände bleiben tief und vorn. Sie gehen nicht in den Himmel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las manos se quedan bajas y delante. No se van al cielo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mani restano basse e davanti. Non vanno al cielo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手は低く、前。空へ上げない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손은 낮고 앞에. 하늘로 가지 않아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hendene blir lavt og foran. De går ikke mot himmelen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De handen blijven laag en voor je. Ze gaan niet de lucht in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręce zostają nisko i z przodu. Nie idą w niebo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mãos ficam baixas e à frente. Não vão para o céu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Händerna stannar lågt och framför. De går inte mot himlen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手保持低、在前面。不要伸向天空。"
          }
        }
      }
    },
    "trick.landing.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you are stable, get off the line."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois stable, sors de la ligne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile jsi stabilní, sjeď z linie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du stabil bist, verlässt du die Linie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto estés estable, sal de la línea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appena sei stabile, esci dalla linea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定したらラインを出る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안정되면 라인에서 나와."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du er stabil, forlater du linjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra je stabiel bent, verlaat je de lijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy jesteś stabilny, zejdź z linii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que estiveres estável, sai da linha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du är stabil lämnar du linjen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站稳了就离开线路。"
          }
        }
      }
    },
    "trick.landing.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound should be dull, not a slap. A slap means stiff legs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bruit doit être sourd, pas un claquement. Claquement = jambes raides."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk má být tupý, ne plesknutí. Plesknutí jsou tuhé nohy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geräusch soll dumpf sein, kein Klatschen. Ein Klatschen heißt steife Beine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido debe ser sordo, no un golpe seco. Un golpe seco son piernas rígidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rumore deve essere sordo, non uno schiocco. Uno schiocco vuol dire gambe rigide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音は鈍いほうがいい。パチンは脚が硬い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 둔해야 해. 탁 하는 소리는 다리가 뻣뻣한 거야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden skal være dump, ikke et smell. Et smell betyr stive bein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluid moet dof zijn, geen klap. Een klap betekent stijve benen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk ma być głuchy, nie klaśnięcie. Klaśnięcie to sztywne nogi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O som deve ser surdo, não um estalo. Um estalo são pernas rígidas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet ska vara dovt, inte en smäll. En smäll betyder stela ben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音应该是闷的，不是拍打。拍打就是腿发僵。"
          }
        }
      }
    },
    "trick.landing.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After three bad landings in a row, change feature or stop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après trois mauvaises réceptions d'affilée, tu changes de module ou tu arrêtes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po třech špatných dopadech za sebou změň prvek nebo skonči."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach drei schlechten Landungen hintereinander wechselst du das Element oder hörst auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras tres recepciones malas seguidas cambias de módulo o paras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo tre ricezioni brutte di fila cambi modulo o ti fermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "悪い着地が三回続いたら、別のキッカーに変えるかやめる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁜 착지가 세 번 이어지면 구조물을 바꾸거나 멈춰."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter tre dårlige landinger på rad bytter du feature eller stopper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na drie slechte landingen achter elkaar wissel je van feature of stop je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po trzech złych lądowaniach z rzędu zmieniasz przeszkodę albo kończysz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de três receções más seguidas mudas de módulo ou paras."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter tre dåliga landningar i rad byter du feature eller slutar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续三次落地不好，就换一个跳台，或者停下来。"
          }
        }
      }
    },
    "trick.ollie.name": {
      "extractionState": "manual",
      "localizations": {
