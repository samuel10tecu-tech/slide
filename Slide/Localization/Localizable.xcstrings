    "trick.box-5050.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 50-50: both skis in line, in the middle of the box, like a very wide flat rail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 50-50 : les deux skis dans l'axe, au milieu de la box, comme un rail très large et plat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50: obě lyže v linii, uprostřed boxu, jako velmi široký plochý rail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 50-50: beide Ski in der Linie, in der Mitte der Box, wie ein sehr breites, flaches Rail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 50-50: los dos esquís en línea, en el centro de la box, como un rail muy ancho y plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 50-50: entrambi gli sci in linea, al centro della box, come un rail molto largo e piatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50は両方のスキーをラインに、ボックスの真ん中。とても広い平らなレールのように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50은 두 스키를 라인에 두고 박스 가운데로. 아주 넓고 평평한 레일처럼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50: begge skiene på linje, midt på boksen, som en veldig bred flat rail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 50-50: beide ski’s in lijn, in het midden van de box, als een heel brede platte rail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50: obie narty w linii, na środku boxa, jak bardzo szeroki płaski rail."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O 50-50: os dois esquis em linha, no meio da box, como um carril muito largo e plano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50: båda skidorna i linje, mitt på boxen, som en mycket bred platt rail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50：两只雪板顺着方向，在盒子中间，像一根又宽又平的杆。"
          }
        }
      }
    },
    "trick.box-5050.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First session: helmet, and someone watching. If you are sideways, you exit. You don't force a finish."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première session : casque, et quelqu'un qui regarde. Si tu es de travers, tu sors. Tu n'insistes pas pour « finir »."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První session: helma a někdo, kdo se dívá. Jsi-li nakřivo, sjedete. Konec nenutíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Session: Helm, und jemand schaut zu. Wenn du schief bist, steigst du ab. Du zwingst kein Ende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera sesión: casco, y alguien mirando. Si vas de lado, sales. No fuerzas el final."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima sessione: casco, e qualcuno che guarda. Se sei storto, esci. Non forzi la fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のセッションはヘルメット、そして見てくれる人。斜めなら降りる。最後まで無理にやらない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 세션은 헬멧, 그리고 봐 주는 사람. 비스듬하면 내려와. 끝까지 억지로 하지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første økt: hjelm, og noen som ser på. Er du skjev, hopper du av. Du tvinger ikke en avslutning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste sessie: helm, en iemand die kijkt. Sta je scheef, dan stap je af. Je forceert geen einde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza sesja: kask i ktoś, kto patrzy. Jeśli jedziesz krzywo, zjeżdżasz. Nie wymuszasz końca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeira sessão: capacete, e alguém a ver. Se estás de lado, sais. Não forces o fim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första passet: hjälm, och någon som tittar. Om du är snett går du av. Du tvingar inte ett slut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次：戴头盔，有人看着。歪了就下来。不要硬撑到头。"
          }
        }
      }
    },
    "trick.box-5050.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a low, straight box with a flat start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une box basse, droite, avec un départ plat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber nízký rovný box s plochým nájezdem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine niedrige, gerade Box mit flachem Einstieg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una box baja y recta, con una entrada plana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una box bassa, dritta, con un ingresso piatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低くてまっすぐ、入りが平らなボックスを選ぶ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮고 곧고, 입구가 평평한 박스를 골라."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en lav, rett boks med flat inngang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een lage, rechte box met een vlakke instap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz niski, prosty box z płaskim wjazdem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma box baixa, direita, com uma entrada plana."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en låg, rak box med plant insteg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个低的、直的盒子，入口是平的。"
          }
        }
      }
    },
    "trick.box-5050.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the exit, not your skis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde la sortie, pas tes skis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívej se na výjezd, ne na lyže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau auf den Ausstieg, nicht auf die Ski."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la salida, no los esquís."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda l'uscita, non gli sci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口を見る。スキーは見ない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출구를 봐. 스키는 보지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på utgangen, ikke på skiene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk naar de uitgang, niet naar je ski’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz na wyjście, nie na narty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha a saída, não os esquis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta på utgången, inte på skidorna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看出口，不要看雪板。"
          }
        }
      }
    },
    "trick.box-5050.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get on in the middle, skis parallel, equal weight on both feet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte dessus au milieu, skis parallèles, poids égal sur les deux pieds."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najeď uprostřed, lyže rovnoběžně, stejná váha na obou nohách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steig in der Mitte auf, Ski parallel, gleiches Gewicht auf beiden Füßen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbete por el centro, esquís paralelos, el mismo peso en los dos pies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali al centro, sci paralleli, peso uguale sui due piedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真ん中に乗る。スキーは平行、両足の体重は同じ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데로 올라가. 스키는 평행, 두 발에 무게는 같게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå på i midten, ski parallelle, lik vekt på begge føttene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stap in het midden op, ski’s parallel, gelijk gewicht op beide voeten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wjedź na środku, narty równolegle, równy ciężar na obu stopach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe no meio, esquis paralelos, peso igual nos dois pés."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå på i mitten, skidor parallella, lika vikt på båda fötterna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从中间上去，雪板平行，两只脚重量一样。"
          }
        }
      }
    },
    "trick.box-5050.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft knees, low arms. You don't jump onto the box: you roll onto it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoux souples, bras bas. Tu ne sautes pas sur la box : tu y roules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měkká kolena, nízké ruce. Na box neskáčeš: navalíš se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiche Knie, tiefe Arme. Du springst nicht auf die Box: du rollst drauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodillas blandas, brazos bajos. No saltas a la box: ruedas sobre ella."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginocchia morbide, braccia basse. Non salti sulla box: ci rotoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝は柔らかく、腕は低く。ボックスに跳ばない。転がるように乗る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎은 부드럽게, 팔은 낮게. 박스에 뛰지 마. 굴려서 올라가."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Myke knær, lave armer. Du hopper ikke opp på boksen: du ruller på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachte knieën, lage armen. Je springt niet op de box: je rolt erop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miękkie kolana, niskie ręce. Nie skaczesz na box: wtaczasz się."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joelhos moles, braços baixos. Não saltas para a box: rolas para cima dela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjuka knän, låga armar. Du hoppar inte upp på boxen: du rullar på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "膝盖放松，手臂放低。不是跳上盒子，是滚上去。"
          }
        }
      }
    },
    "trick.box-5050.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the end, let the box go and absorb the small drop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin, tu laisses la box partir et tu absorbes la petite marche."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na konci box pustíš a pohltíš malý schod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende lässt du die Box los und federst den kleinen Absatz ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al final dejas la box y absorbes el pequeño escalón."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla fine lasci andare la box e assorbi il piccolo salto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終わりでボックスを離れ、小さい段差を吸収する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝에서 박스를 놓고 작은 단차를 흡수해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Til slutt slipper du boksen og tar imot det lille fallet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan het eind laat je de box los en absorbeer je het kleine randje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na końcu puszczasz box i amortyzujesz mały próg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No fim deixas a box e absorves o pequeno degrau."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I slutet släpper du boxen och dämpar det lilla fallet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到头了就离开盒子，把那个小落差缓冲掉。"
          }
        }
      }
    },
    "trick.box-5050.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bit of speed, not a crawl. Too slow and the skis stick or wander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu de vitesse, pas une pointe. Trop lent, les skis collent ou dévient."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochu rychlosti, ne plazení. Moc pomalu a lyže lepí nebo ujíždějí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein bisschen Tempo, kein Kriechen. Zu langsam und die Ski kleben oder wandern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco de velocidad, no un arrastre. Demasiado lento y los esquís se pegan o se van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po' di velocità, non un passo. Troppo lento e gli sci si incollano o deviano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し速さは要る。のろのろはだめ。遅すぎるとスキーが貼りつくか、ずれる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도는 조금 필요해. 기어가듯은 안 돼. 너무 느리면 스키가 붙거나 흘러."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Litt fart, ikke kryping. For sakte og skiene setter seg eller vandrer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beetje snelheid, geen kruipen. Te langzaam en de ski’s plakken of dwalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochę prędkości, nie czołganie. Za wolno i narty kleją albo uciekają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco de velocidade, não um rastejo. Lento demais e os esquis colam ou desviam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lite fart, inte krypande. För långsamt och skidorna fastnar eller vandrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要有一点速度，不要爬。太慢雪板会粘住或者跑偏。"
          }
        }
      }
    },
    "trick.box-5050.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes dropping to the tips tip you forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regard qui tombe sur les spatules te fait tomber vers l'avant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když pohled spadne na špičky, padáš dopředu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fällt der Blick auf die Spitzen, kippst du nach vorn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la mirada cae en las puntas, te vas hacia delante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo sguardo cade sulle punte, cadi in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視線が先に落ちると前に倒れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시선이 앞끝으로 떨어지면 앞으로 넘어진다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Faller blikket på tuppene, tipper du forover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je blik op de tips valt, kieper je voorover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wzrok spada na dzioby, przewracasz się do przodu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o olhar cai nas pontas, cais para a frente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Faller blicken på spetsarna tippar du framåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼睛掉到板头上，人就会往前栽。"
          }
        }
      }
    },
