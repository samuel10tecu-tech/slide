            "state": "translated",
            "value": "Geblokkeerd. Zonder locatie geen snelheid en geen spoor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowana. Bez lokalizacji nie ma prędkości ani śladu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueada. Sem localização não há velocidade nem traçado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockerad. Utan plats ingen fart och inget spår."
          }
        },
