    "profile.erase.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name and units stay. Nothing is copied online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prénom et les unités restent. Rien n'est copié en ligne."
          }
        }
      }
    },
    "profile.about.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans compte"
          }
        }
      }
    },
    "profile.about.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide does not create an account and sends nothing to the internet. Tracks, tricks and your name stay on the phone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide ne crée pas de compte et n'envoie rien sur Internet. Les traces, les tricks et le prénom restent dans le téléphone."
          }
        }
      }
    },
    "profile.about.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Airtime is an accelerometer estimate: useful for comparing jumps, not a lab measurement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'airtime est une estimation de l'accéléromètre : utile pour comparer tes sauts, pas une mesure de labo."
          }
        }
      }
    },
    "profile.about.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cold kills batteries in the mountains. Keep the phone warm, in an inside pocket, and start full. Low Power Mode can stall GPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En montagne le froid vide la batterie. Garde le téléphone au chaud, dans une poche intérieure, et pars chargé. Le mode économie d'énergie peut couper le GPS."
          }
        }
      }
    },
    "profile.about.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blue pill can show while tracking: iOS is saying GPS is on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pastille bleue peut s'afficher pendant le suivi : c'est iOS qui montre que le GPS tourne."
          }
        }
      }
    },
    "profile.about.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a free Apple ID, an app installed from Xcode must be reinstalled about every 7 days. Sending the app itself (TestFlight) needs a paid developer account in an adult's name. Live Activity on the Dynamic Island works without that paid account. A home-screen widget that reads your days does not: it would need App Groups, which a free Apple ID cannot use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un Apple ID gratuit, l'app installée depuis Xcode doit être réinstallée environ tous les 7 jours. Envoyer l'app elle-même (TestFlight) demande un compte développeur payant, au nom d'un adulte. L'activité en direct sur la Dynamic Island marche sans ce compte payant. Un widget d'écran d'accueil qui lit tes journées, non : il faudrait des App Groups, impossibles avec un Apple ID gratuit."
          }
        }
      }
    },
