            "state": "translated",
            "value": "Voeg een neppe track toe of haal hem weg om de geschiedenis te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj albo usuń zmyślony ślad, żeby zobaczyć historię."
          }
        },
        "pt": {
