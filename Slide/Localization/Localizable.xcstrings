    "profile.screen.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while tracking. It drains the battery faster, especially in the cold."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le suivi seulement. Ça vide la batterie plus vite, surtout dans le froid."
          }
        }
      }
    },
    "profile.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
