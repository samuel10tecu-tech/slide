    "freestyle.learned.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check it when you land it clean, not on the first try."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche quand tu le poses proprement, pas au premier essai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odškrtni, až to čistě dokončíš, ne na první pokus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake es ab, wenn du es sauber landest, nicht beim ersten Versuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Márcalo cuando lo aterrices limpio, no al primer intento."
          }
