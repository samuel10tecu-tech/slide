    "trick.mute.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mute: the front hand grabs the front ski, outside edge, between tip and binding."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mute : la main avant attrape le ski avant, côté extérieur, entre la spatule et la fixation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute: přední ruka chytí přední lyži zvenku, mezi špičkou a vázáním."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mute: die vordere Hand greift den vorderen Ski außen, zwischen Spitze und Bindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mute: la mano delantera agarra el esquí delantero, canto exterior, entre la punta y la fijación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mute: la mano davanti prende lo sci davanti, lato esterno, tra punta e attacco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュートは前の手が前のスキーの外側、先とビンディングのあいだをつかむ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뮤트는 앞손이 앞 스키 바깥쪽, 끝과 바인딩 사이를 잡는 거야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Muten: den fremre hånden tar den fremre skien på utsiden, mellom tupp og binding."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mute: de voorhand pakt de voorste ski aan de buitenkant, tussen tip en binding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute: przednia ręka łapie przednią nartę od zewnątrz, między dziobem a wiązaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mute: a mão da frente agarra o esqui da frente, lado de fora, entre a ponta e a fixação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Muten: den främre handen tar den främre skidan på utsidan, mellan spets och bindning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute：前手抓住前雪板的外侧，在板头和固定器之间。"
          }
        }
      }
    },
    "trick.mute.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A grab that makes you miss the landing is not a grab. Shorten it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grab qui te fait perdre la réception n'est pas un grab. Tu le raccourcis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Grab, kvůli kterému mineš dopad, není grab. Zkrať ho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Grab, der dich die Landung verpassen lässt, ist kein Grab. Kürz ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grab que te hace perder la recepción no es un grab. Acórtalo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grab che ti fa perdere la ricezione non è un grab. Accorcialo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着地を外すグラブはグラブではない。短くする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착지를 놓치게 하는 그랩은 그랩이 아니야. 짧게 해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En grab som får deg til å bomme på landingen er ingen grab. Gjør den kortere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een grab waardoor je de landing mist, is geen grab. Maak hem korter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grab, przez który gubisz lądowanie, nie jest grabem. Skróć go."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um grab que te faz perder a receção não é um grab. Encurta-o."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En grab som får dig att missa landningen är ingen grab. Korta den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你错过落地的抓板就不是抓板。把它缩短。"
          }
        }
      }
    },
    "trick.mute.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from a stable straight air, safety already clean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pars d'un saut droit stable, safety déjà propre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začni ze stabilního straight air, když je safety už čistý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte von einem stabilen Straight Air, wenn der Safety schon sauber ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal de un straight air estable, con el safety ya limpio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti da uno straight air stabile, con il safety già pulito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーフティが決まってから、安定したストレートエアで始める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이프티가 이미 깨끗할 때, 안정된 스트레이트 에어에서 시작해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start fra et stabilt straight air når safetyen allerede er ren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start vanuit een stabiele straight air, als de safety al schoon is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od stabilnego straight air, gdy safety jest już czysty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de um straight air estável, com o safety já limpo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgå från ett stabilt straight air när safetyn redan är ren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从一次稳定的直跳开始，safety 已经干净。"
          }
        }
      }
    },
    "trick.mute.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the front ski to the front hand. The knee comes to the chest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte le ski avant vers la main avant. Le genou vient à la poitrine."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přines přední lyži k přední ruce. Koleno jde k hrudi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring den vorderen Ski zur vorderen Hand. Das Knie kommt zur Brust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el esquí delantero a la mano delantera. La rodilla va al pecho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta lo sci davanti alla mano davanti. Il ginocchio va al petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のスキーを前の手へ。膝は胸に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞 스키를 앞손으로 가져와. 무릎은 가슴으로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før den fremre skien til den fremre hånden. Kneet kommer mot brystet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng de voorste ski naar de voorhand. De knie komt naar de borst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciągnij przednią nartę do przedniej ręki. Kolano idzie do klatki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz o esqui da frente à mão da frente. O joelho vai ao peito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För den främre skidan till den främre handen. Knät kommer mot bröstet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把前雪板送到前手。膝盖收到胸口。"
          }
        }
      }
    },
    "trick.mute.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grab the outside of the ski, not between the legs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attrape le ski à l'extérieur, pas entre les jambes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyť vnější stranu lyže, ne mezi nohama."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Greif die Außenseite des Ski, nicht zwischen den Beinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agarra el exterior del esquí, no entre las piernas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi l'esterno dello sci, non tra le gambe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーの外側をつかむ。脚のあいだではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스키 바깥쪽을 잡아. 다리 사이가 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta utsiden av skien, ikke mellom beina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pak de buitenkant van de ski, niet tussen de benen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łap zewnętrzną stronę narty, nie między nogami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agarra o exterior do esqui, não entre as pernas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta utsidan av skidan, inte mellan benen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抓雪板外侧，不是两腿之间。"
          }
        }
      }
    },
    "trick.mute.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other arm opens a little for balance, without starting a spin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre bras s'écarte un peu pour l'équilibre, sans lancer la rotation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Druhá ruka se trochu otevře pro rovnováhu, bez startu rotace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der andere Arm öffnet sich etwas fürs Gleichgewicht, ohne eine Drehung zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro brazo se abre un poco para el equilibrio, sin empezar un giro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altro braccio si apre un po' per l'equilibrio, senza avviare una rotazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方の腕はバランスのために少し開く。回転は始めない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 팔은 균형을 위해 조금 벌려. 회전은 시작하지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den andre armen åpner seg litt for balansen, uten å starte en spinn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De andere arm opent een beetje voor balans, zonder een draai te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druga ręka otwiera się trochę dla równowagi, bez startu obrotu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro braço abre-se um pouco para o equilíbrio, sem começar uma rotação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den andra armen öppnar sig lite för balansen, utan att starta en snurr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一只手臂为了平衡稍微打开，不要开始旋转。"
          }
        }
      }
    },
    "trick.mute.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let go early, skis parallel, absorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâche tôt, remets les skis parallèles, absorbe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusť brzy, lyže rovnoběžně, pohltí náraz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass früh los, Ski parallel, federe ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta pronto, esquís paralelos, absorbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molla presto, sci paralleli, assorbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早く離し、スキーを平行に戻して吸収する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일찍 놓고, 스키를 평행하게, 흡수해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp tidlig, ski parallelle, ta imot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat vroeg los, ski’s parallel, absorbeer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puść wcześnie, narty równolegle, zamortyzuj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Larga cedo, esquis paralelos, absorve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp tidigt, skidor parallella, dämpa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早点松开，雪板平行，再缓冲。"
          }
        }
      }
    },
    "trick.mute.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knee up, not a broken back reaching for the ski."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genou haut, pas dos cassé vers le ski."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleno vysoko, ne zlomená záda sahající po lyži."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie hoch, nicht ein gebrochener Rücken, der nach dem Ski greift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodilla arriba, no una espalda rota que busca el esquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginocchio alto, non una schiena spezzata che cerca lo sci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝を上げる。背中を折ってスキーに手を伸ばさない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎을 올려. 등을 꺾어 스키를 잡지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kne opp, ikke en brukket rygg som strekker seg etter skien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie omhoog, geen gebroken rug die naar de ski reikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolano wysoko, nie złamane plecy sięgające po nartę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joelho alto, não costas partidas à procura do esqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knä upp, inte en bruten rygg som når efter skidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "膝盖抬高，不要折着后背去够雪板。"
          }
        }
      }
    },
    "trick.mute.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mute should not open the hip enough to cross the skis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mute ne doit pas ouvrir ta hanche au point de croiser les skis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute nemá otevřít bok tak, že se lyže zkříží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mute soll die Hüfte nicht so weit öffnen, dass sich die Ski kreuzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mute no debe abrir la cadera tanto que se crucen los esquís."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mute non deve aprire l'anca tanto da incrociare gli sci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュートで腰を開きすぎてスキーを交差させない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뮤트가 엉덩이를 너무 열어 스키가 교차하면 안 돼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Muten skal ikke åpne hoften så skiene krysses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mute mag de heup niet zo ver openen dat de ski’s kruisen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute nie powinien otwierać biodra tak, że narty się krzyżują."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mute não deve abrir a anca ao ponto de cruzar os esquis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Muten ska inte öppna höften så att skidorna korsas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute 不要把髋打开到雪板交叉。"
          }
        }
      }
    },
    "trick.three-sixty.name": {
