    "tracking.banner.wheninuse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For tracking with the screen locked, set Location to Always in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le suivi écran verrouillé, passe la position sur « Toujours » dans Réglages."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav polohu na Vždy, ať záznam běží se zamčenou obrazovkou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit die Aufzeichnung bei gesperrtem Bildschirm weiterläuft, stelle den Ort auf „Immer“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para seguir con la pantalla bloqueada, pon la ubicación en «Siempre»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuare a schermo bloccato, imposta la posizione su «Sempre»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ロック中も記録するなら、位置情報を「常に」にして。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 잠겨도 기록하려면 위치를 ‘항상’으로 해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett posisjon til Alltid så sporingen fortsetter med låst skjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet locatie op ‘Altijd’ zodat volgen doorgaat met een vergrendeld scherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw lokalizację na „Zawsze”, żeby nagranie szło przy zablokowanym ekranie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar com o ecrã bloqueado, põe a localização em «Sempre»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt plats till Alltid så att spårningen fortsätter med låst skärm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要锁屏后继续记录，把定位设成“始终”。"
          }
        }
      }
    },
