    "tracking.map.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map tiles need a cache. Your numbers are saved either way."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond de carte a besoin d'un cache. Tes chiffres sont enregistrés quand même."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa potřebuje mezipaměť. Čísla se stejně uloží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte braucht einen Cache. Deine Zahlen sind trotzdem gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa necesita caché. Tus cifras se guardan igual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mappa ha bisogno di cache. I numeri sono salvati comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図タイルはキャッシュが要る。数字はどちらにせよ保存される。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 타일은 캐시가 필요해. 숫자는 어차피 저장돼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartet trenger buffer. Tallene lagres uansett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart heeft een cache nodig. Je cijfers zijn toch opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa potrzebuje pamięci podręcznej. Liczby i tak są zapisane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa precisa de cache. Os números ficam guardados na mesma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartan behöver cache. Siffrorna sparas ändå."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图底图需要缓存。数字无论如何都会保存。"
          }
        }
      }
