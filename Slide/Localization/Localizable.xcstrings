    "tracking.settings.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Always so tracking continues in a pocket with the screen locked. Slide stops GPS when you finish."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis « Toujours » pour que le suivi continue dans la poche, écran verrouillé. Slide coupe le GPS quand tu termines."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvol Vždy, ať záznam běží v kapse se zamčenou obrazovkou. Slide vypne GPS, když skončíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Immer“, damit die Aufzeichnung in der Tasche bei gesperrtem Bildschirm weiterläuft. Slide stoppt das GPS, wenn du beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Siempre» para que el seguimiento siga en el bolsillo con la pantalla bloqueada. Slide para el GPS al terminar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli «Sempre» così il tracciamento continua in tasca a schermo bloccato. Slide ferma il GPS quando termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポケットで画面ロック中も続けるなら「常に」を選んで。終了するとSlideはGPSを止める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주머니에서 화면이 잠겨도 이어가려면 ‘항상’을 골라. 끝내면 Slide가 GPS를 끈다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg Alltid så sporingen fortsetter i lommen med låst skjerm. Slide stopper GPS når du er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Altijd zodat volgen in je zak doorgaat met een vergrendeld scherm. Slide stopt gps als je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz „Zawsze”, żeby nagranie szło w kieszeni przy zablokowanym ekranie. Slide wyłącza GPS, gdy kończysz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe «Sempre» para o registo continuar no bolso com o ecrã bloqueado. O Slide pára o GPS quando terminas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Alltid så spårningen fortsätter i fickan med låst skärm. Slide stänger GPS när du slutar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在口袋里锁屏后继续，就选“始终”。你结束时 Slide 会关掉 GPS。"
          }
        }
      }
    },
