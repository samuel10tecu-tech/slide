    "trick.safety-grab.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The safety is grabbing the ski just in front of the binding, between the feet. The most stable grab to start with."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le safety, c'est attraper le ski juste devant la fixation, entre les deux pieds. Le grab le plus stable pour commencer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U safety chytáš lyži těsně před vázáním, mezi chodidly. Nejstabilnější grab na začátek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Safety greifst du den Ski direkt vor der Bindung, zwischen den Füßen. Der stabilste Grab zum Anfang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el safety agarras el esquí justo delante de la fijación, entre los pies. El grab más estable para empezar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel safety prendi lo sci proprio davanti all'attacco, tra i piedi. Il grab più stabile per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーフティはビンディングのすぐ前、両足のあいだでスキーをつかむ。最初にいちばん安定するグラブ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이프티는 바인딩 바로 앞, 두 발 사이에서 스키를 잡는 거야. 시작하기에 가장 안정적인 그랩."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I en safety tar du skien rett foran bindingen, mellom føttene. Den mest stabile graben å starte med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij de safety pak je de ski net voor de binding, tussen de voeten. De stabielste grab om mee te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W safety łapiesz nartę tuż przed wiązaniem, między stopami. Najstabilniejszy grab na start."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No safety agarras o esqui mesmo à frente da fixação, entre os pés. O grab mais estável para começar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I en safety tar du skidan precis framför bindningen, mellan fötterna. Den stabilaste graben att börja med."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety 是在固定器正前方、两脚之间抓住雪板。最稳的入门抓板。"
          }
        }
      }
    },
    "trick.safety-grab.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose the slope while grabbing, the grab was too early or too low. Let go and land."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne vois plus la piste en attrapant, le grab est trop tôt ou trop bas. Lâche et pose-toi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když při grabu ztratíš svah, byl grab moc brzy nebo moc nízko. Pusť a dopadni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du beim Greifen die Piste verlierst, war der Grab zu früh oder zu tief. Lass los und lande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si pierdes la pista al agarrar, el grab fue demasiado pronto o demasiado bajo. Suelta y aterriza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdi la pista mentre afferri, il grab era troppo presto o troppo basso. Molla e atterra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つかんでいるあいだに斜面を見失ったら、グラブが早すぎるか低すぎる。離して着く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잡는 동안 슬로프를 놓치면 그랩이 너무 이르거나 너무 낮은 거야. 놓고 착지해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du mister løypa mens du grabber, var grabben for tidlig eller for lav. Slipp og land."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de piste kwijtraakt tijdens de grab, was die te vroeg of te laag. Laat los en land."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli przy grabie tracisz stok, grab był za wcześnie albo za nisko. Puść i ląduj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdes a pista ao agarrar, o grab foi cedo demais ou baixo demais. Larga e aterra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du tappar pisten medan du grabbar var grabben för tidig eller för låg. Släpp och landa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抓的时候看不见坡，就是抓得太早或太低。松开并落地。"
          }
        }
      }
    },
    "trick.safety-grab.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start on a small straight air you already land without thinking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'abord sur un petit saut droit que tu poses déjà sans y penser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začni na malém straight air, který už dopadáš bez přemýšlení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fang auf einem kleinen Straight Air an, den du schon ohne Nachdenken landest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza en un straight air pequeño que ya aterrizas sin pensarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia su un piccolo straight air che atterri già senza pensarci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考えずに着ける、小さいストレートエアから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각 없이 착지하는 작은 스트레이트 에어에서 시작해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynn på et lite straight air du allerede lander uten å tenke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin op een kleine straight air die je al landt zonder na te denken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od małego straight air, który lądujesz już bez myślenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa num straight air pequeno que já aterras sem pensar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja på ett litet straight air som du redan landar utan att tänka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从一个你已经不用想就能落地的小直跳开始。"
          }
        }
      }
    },
    "trick.safety-grab.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the air, bend the knees and bring the ski to the hand. Don't dive the hand down and break the back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En l'air, plie les genoux et amène le ski à la main. Tu ne plonges pas la main vers le ski en cassant le dos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve vzduchu pokrč kolena a přines lyži k ruce. Nenoř ruku dolů a nelámej záda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Luft beugst du die Knie und bringst den Ski zur Hand. Tauche nicht mit der Hand nach unten und brich den Rücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el aire flexiona las rodillas y lleva el esquí a la mano. No claves la mano abajo y rompas la espalda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In aria piega le ginocchia e porta lo sci alla mano. Non tuffare la mano in basso spezzando la schiena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空中で膝を曲げ、スキーを手に近づける。手を下へ突っ込んで背中を折らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공중에서 무릎을 굽히고 스키를 손으로 가져와. 손을 아래로 집어넣어 등을 꺾지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I lufta bøyer du knærne og fører skien til hånden. Ikke dykk med hånden ned og knekk ryggen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de lucht buig je de knieën en breng je de ski naar de hand. Duik niet met de hand omlaag en breek je rug niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W powietrzu ugnij kolana i przyciągnij nartę do ręki. Nie nurkuj ręką w dół i nie łam pleców."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No ar flete os joelhos e traz o esqui à mão. Não mergulhes a mão para baixo e partas as costas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I luften böjer du knäna och för skidan till handen. Dyka inte med handen nedåt och bryt inte ryggen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空中弯曲膝盖，把雪板送到手上。不要把手往下探、把后背折断。"
          }
        }
      }
    },
    "trick.safety-grab.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front or back hand grabs the inside of the ski, in front of the binding."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La main avant ou arrière attrape le ski côté intérieur, devant la fixation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přední nebo zadní ruka chytí vnitřek lyže, před vázáním."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vordere oder hintere Hand greift die Innenseite des Ski, vor der Bindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano de delante o de atrás agarra el interior del esquí, delante de la fijación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano davanti o dietro prende l'interno dello sci, davanti all'attacco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の手か後ろの手が、ビンディングの前、スキーの内側をつかむ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞손이나 뒷손이 바인딩 앞, 스키 안쪽을 잡아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremre eller bakre hånd tar innsiden av skien, foran bindingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor- of achterhand pakt de binnenkant van de ski, vóór de binding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przednia albo tylna ręka łapie wnętrze narty, przed wiązaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mão da frente ou de trás agarra o interior do esqui, à frente da fixação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Främre eller bakre handen tar insidan av skidan, framför bindningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前手或后手抓住雪板内侧、固定器前面。"
          }
        }
      }
    },
    "trick.safety-grab.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold it for a second, let go, set up the landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tiens le grab une seconde, tu lâches, tu prépares la réception."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrž vteřinu, pusť, připrav dopad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ihn eine Sekunde, lass los, bereite die Landung vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujétalo un segundo, suelta y prepara la recepción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienilo un secondo, molla, prepara la ricezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一秒つかんで離し、着地を用意する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1초 잡고 놓고, 착지를 준비해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold et sekund, slipp, gjør landingen klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd hem een seconde vast, laat los, zet de landing klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj sekundę, puść, przygotuj lądowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segura um segundo, larga e prepara a receção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll en sekund, släpp, ställ in landningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抓住一秒，松开，准备落地。"
          }
        }
      }
    },
    "trick.safety-grab.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes stay on the landing the whole time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regard reste sur la réception pendant tout le grab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oči zůstanou celou dobu na dopadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Augen bleiben die ganze Zeit auf der Landung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ojos se quedan en la recepción todo el tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli occhi restano sulla ricezione per tutto il tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目はずっと着地に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시선은 내내 착지에."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øynene blir på landingen hele tiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ogen blijven de hele tijd op de landing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczy zostają na lądowaniu przez cały czas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os olhos ficam na receção o tempo todo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ögonen stannar på landningen hela tiden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼睛一直看着落地区。"
          }
        }
      }
    },
    "trick.safety-grab.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knees up, torso quiet. The grab should not turn your shoulders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoux hauts, torse calme. Le grab ne doit pas tourner tes épaules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolena vysoko, trup klidně. Grab nemá otáčet ramena."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie hoch, Oberkörper ruhig. Der Grab soll die Schultern nicht drehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodillas arriba, torso quieto. El grab no debe girar los hombros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginocchia alte, busto fermo. Il grab non deve girare le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝は高く、上半身は静か。グラブで肩を回さない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎은 높게, 상체는 조용히. 그랩이 어깨를 돌리면 안 돼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knær opp, overkroppen rolig. Grabben skal ikke snu skuldrene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knieën omhoog, bovenlijf rustig. De grab mag je schouders niet draaien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolana wysoko, tułów spokojny. Grab nie powinien obracać ramion."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joelhos altos, tronco quieto. O grab não deve rodar os ombros."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knän upp, överkroppen lugn. Grabben ska inte vrida axlarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "膝盖抬高，上身安静。抓板不该把肩膀拧过去。"
          }
        }
      }
    },
    "trick.safety-grab.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do the safety on both sides before you change grabs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe le safety des deux côtés avant de changer de grab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělej safety na obě strany, než změníš grab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach den Safety auf beiden Seiten, bevor du den Grab wechselst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz el safety a ambos lados antes de cambiar de grab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai il safety da entrambi i lati prima di cambiare grab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラブを変える前に、両側でセーフティを決める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그랩을 바꾸기 전에 양쪽 세이프티를 먼저 해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør safetyen til begge sider før du bytter grab."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe de safety aan beide kanten voordat je van grab wisselt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób safety z obu stron, zanim zmienisz graba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz o safety dos dois lados antes de mudares de grab."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör safetyn åt båda hållen innan du byter grab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换抓法之前，两边的 safety 都先做干净。"
          }
        }
      }
    },
