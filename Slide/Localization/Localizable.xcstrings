    "trick.switch-180.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You leave switch and land forward. Often easier than a regular 180, because the landing is your strong direction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pars en switch et tu poses en avant. C'est souvent plus facile que le 180 classique, parce que la réception est dans ton sens fort."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjíždíš switch a dopadáš dopředu. Často snazší než běžná 180, protože dopad je tvůj silný směr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du startest switch und landest vorwärts. Oft leichter als eine normale 180, weil die Landung deine starke Richtung ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sales en switch y aterrizas de frente. A menudo más fácil que un 180 normal, porque la recepción es tu sentido fuerte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti in switch e atterri in avanti. Spesso più facile di un 180 normale, perché la ricezione è il tuo verso forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチで出て、前向きで着く。着地が得意な向きなので、普通の180より易しいことが多い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치로 나가 정방향으로 착지해. 착지가 강한 방향이라 보통 180보다 쉬운 경우가 많아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du drar switch og lander forover. Ofte lettere enn en vanlig 180, fordi landingen er din sterke retning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vertrekt switch en landt vooruit. Vaak makkelijker dan een gewone 180, omdat de landing je sterke kant is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjeżdżasz switch i lądujesz przodem. Często łatwiej niż zwykłe 180, bo lądowanie jest twoją mocną stroną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sais em switch e aterras para a frente. Muitas vezes mais fácil do que um 180 normal, porque a receção é o teu sentido forte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lämnar switch och landar framåt. Ofta lättare än en vanlig 180, för landningen är ditt starka håll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反脚出发，正脚落地。落地是你强的方向，所以常常比普通 180 容易。"
          }
        }
      }
    },
    "trick.switch-180.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switch approach is the real risk: you see other people less well. Look twice before you go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'approche en switch est le vrai risque : tu vois moins bien les autres. Regarde deux fois avant de partir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájezd switch je skutečné riziko: ostatní vidíš hůř. Podívej se dvakrát, než vyjedeš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Switch-Anlauf ist das echte Risiko: du siehst andere schlechter. Schau zweimal, bevor du fährst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aproximación en switch es el riesgo de verdad: ves peor a los demás. Mira dos veces antes de salir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'approccio in switch è il vero rischio: vedi gli altri peggio. Guarda due volte prima di partire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチのアプローチが本当のリスク。人が見えにくい。出る前に二度見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치 진입이 진짜 위험이야. 다른 사람이 잘 안 보여. 나가기 전에 두 번 봐."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch-innkjøringen er den virkelige risikoen: du ser andre dårligere. Se to ganger før du kjører."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De switch-aanloop is het echte risico: je ziet anderen slechter. Kijk twee keer voordat je gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najazd switch to prawdziwe ryzyko: gorzej widzisz innych. Spójrz dwa razy, zanim ruszysz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aproximação em switch é o risco a sério: vês pior os outros. Olha duas vezes antes de saíres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch-infarten är den verkliga risken: du ser andra sämre. Titta två gånger innan du åker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反脚接近才是真正的风险：你更难看清别人。出发前看两次。"
          }
        }
      }
    },
    "trick.switch-180.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean switch on a blue, and ollie or nollie already there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch propre sur une bleue, et ollie ou nollie déjà en place."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čistý switch na modré a ollie nebo nollie už na místě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauberes Switch auf einer blauen Piste, und Ollie oder Nollie schon da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch limpio en una azul, y ollie o nollie ya listos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch pulito su una blu, e ollie o nollie già a posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブルーでスイッチがきれいで、オーリーかノーリーもある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블루에서 스위치가 깨끗하고, 올리나 놀리도 이미 있어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ren switch på en blå, og ollie eller nollie allerede på plass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schoon switch op een blauwe, en ollie of nollie al aanwezig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysty switch na niebieskiej i ollie albo nollie już na miejscu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch limpo numa azul, e ollie ou nollie já no sítio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ren switch på en blå, och ollie eller nollie redan på plats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝道上反脚已经干净，ollie 或 nollie 也有了。"
          }
        }
      }
    },
    "trick.switch-180.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small jump. Arrive switch, pop, the head turns toward your usual direction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit kick. Tu arrives en switch, tu pop, la tête tourne vers ton sens habituel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malý skok. Přijedeš switch, pop, hlava se otočí k tvému obvyklému směru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner Sprung. Du kommst switch an, poppst, der Kopf dreht zu deiner gewohnten Richtung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto pequeño. Llegas en switch, haces pop, la cabeza gira hacia tu sentido habitual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto piccolo. Arrivi in switch, fai pop, la testa gira verso il tuo verso abituale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さいジャンプ。スイッチで入り、ポップし、頭はいつもの向きへ回る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 점프. 스위치로 들어가 팝하고, 머리는 평소 방향으로 돌아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lite hopp. Du kommer inn switch, popper, hodet snur mot din vanlige retning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine jump. Je komt switch aan, popt, het hoofd draait naar je gewone kant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały skok. Wjeżdżasz switch, pop, głowa obraca się w twoją zwykłą stronę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto pequeno. Chegas em switch, fazes pop, a cabeça roda para o teu sentido habitual."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Litet hopp. Du kommer in switch, poppar, huvudet vrider mot ditt vanliga håll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小跳台。反脚进入，起跳，头转向你习惯的方向。"
          }
        }
      }
    },
    "trick.switch-180.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skis pass 180 and find forward again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les skis passent 180 et retrouvent l'avant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyže projdou 180 a znovu najdou dopředu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ski gehen durch 180 und finden wieder vorwärts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los esquís pasan los 180 y encuentran otra vez el frente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sci passano i 180 e ritrovano l'avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーは180を過ぎて、また前向きを見つける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스키가 180을 지나 다시 정방향을 찾아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiene passerer 180 og finner forover igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ski’s gaan door 180 en vinden weer vooruit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narty przechodzą 180 i znowu znajdują przód."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esquis passam os 180 e encontram outra vez a frente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skidorna passerar 180 och hittar framåt igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪板转过 180，再找到正脚。"
          }
        }
      }
    },
    "trick.switch-180.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land like a normal straight air and absorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu poses comme un saut droit normal et tu absorbes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopadni jako běžný straight air a pohltí náraz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lande wie ein normaler Straight Air und federe ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterriza como un straight air normal y absorbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterra come uno straight air normale e assorbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普通のストレートエアのように着いて吸収する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 스트레이트 에어처럼 착지하고 흡수해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Land som et vanlig straight air og ta imot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Land als een gewone straight air en absorbeer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ląduj jak zwykły straight air i zamortyzuj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterra como um straight air normal e absorve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Landa som ett vanligt straight air och dämpa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像一次普通直跳一样落地并缓冲。"
          }
        }
      }
    },
    "trick.switch-180.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both directions before a bigger jump."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-le des deux côtés avant de l'emmener sur un plus grand kick."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba směry, než větší skok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Richtungen, bevor ein größerer Sprung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos sentidos antes de un salto más grande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi i sensi prima di un salto più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きいジャンプの前に両方向。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 큰 점프 전에 양쪽 다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge veier før et større hopp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide kanten voordat je naar een grotere jump gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie strony, zanim większy skok."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois sentidos antes de um salto maior."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda hållen innan ett större hopp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个方向都做了，再上更大的跳台。"
          }
        }
      }
    },
    "trick.switch-180.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the approach is wrong, you don't 'send it anyway'. You roll the jump with no pop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu rates l'approche, tu ne « tentes quand même ». Tu roules le kick sans pop."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je nájezd špatně, „nepošleš to stejně”. Skok převalíš bez popu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Anlauf falsch ist, „schickst“ du ihn nicht trotzdem. Du rollst den Sprung ohne Pop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la aproximación está mal, no lo «tiras igual». Ruedas el salto sin pop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'approccio è sbagliato, non lo «mandi lo stesso». Rotoli il salto senza pop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプローチが違ったら、それでも飛ばない。ポップなしで転がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입이 틀리면 ‘그래도 보내지’ 마. 팝 없이 굴려 넘어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er innkjøringen feil, «sender» du den ikke likevel. Du ruller hoppet uten pop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klopt de aanloop niet, dan ‘send’ je hem niet toch. Je rolt de jump zonder pop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli najazd jest zły, nie „wysyłasz go i tak”. Przetaczasz skok bez popu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a aproximação está errada, não «mandas na mesma». Rolas o salto sem pop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är infarten fel ”sendar” du den inte ändå. Du rullar hoppet utan pop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近不对，就不要“还是发出去”。不起跳，滚过跳台。"
          }
        }
      }
    },
    "trick.switch-180.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the spin small and high. A flat switch 180 ends with a planted tail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la rotation petite et haute. Un switch 180 plat finit en queue plantée."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drž rotaci malou a vysokou. Plochá switch 180 skončí zapíchnutou patkou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt die Drehung klein und hoch. Eine flache Switch-180 endet mit eingestochenem Tail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el giro pequeño y alto. Un switch 180 plano acaba con la cola clavada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la rotazione piccola e alta. Uno switch 180 piatto finisce con la coda piantata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転は小さく高く。平らなスイッチ180はテールを刺して終わる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회전은 작고 높게. 평평한 스위치 180은 테일을 박고 끝나."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold spinnet liten og høy. En flat switch 180 ender med en plantet bakski."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de draai klein en hoog. Een vlakke switch 180 eindigt met een geplante tail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj obrót mały i wysoki. Płaskie switch 180 kończy się wbitym tyłem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a rotação pequena e alta. Um switch 180 plano acaba com a cauda espetada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll snurren liten och hög. En platt switch 180 slutar med en planterad bakskida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转要小、要高。平的反脚 180 会以插板尾结束。"
          }
        }
      }
    },
