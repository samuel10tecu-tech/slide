    "trick.inversion-order.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflips, frontflips and corks are in this app. They are advanced, and they are done with a coach. The order does not change because a video looks easy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les backflips, frontflips et corks sont dans cette app. Ils sont avancés, et ils se font avec un coach. L'ordre ne change pas parce qu'une vidéo a l'air facile."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflipy, frontflipy a corky jsou v téhle aplikaci. Jsou pokročilé a dělají se s trenérem. Pořadí se nemění jen proto, že video vypadá snadně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflips, Frontflips und Corks sind in dieser App. Sie sind fortgeschritten und werden mit einem Coach gemacht. Die Reihenfolge ändert sich nicht, weil ein Video leicht aussieht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflips, frontflips y corks están en esta app. Son avanzados y se hacen con un coach. El orden no cambia porque un vídeo parezca fácil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflip, frontflip e cork sono in questa app. Sono avanzati e si fanno con un coach. L'ordine non cambia perché un video sembra facile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックフリップ、フロントフリップ、コークはこのアプリにある。上級で、コーチとやる。動画が簡単に見えても順番は変わらない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백플립, 프론트플립, 코크는 이 앱에 있어. 고급이고, 코치와 해. 영상이 쉬워 보여도 순서는 안 바뀌어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflips, frontflips og corks er i denne appen. De er avanserte og gjøres med en trener. Rekkefølgen endres ikke fordi en video ser lett ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflips, frontflips en corks staan in deze app. Ze zijn gevorderd en doe je met een coach. De volgorde verandert niet omdat een video makkelijk lijkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflipy, frontflipy i corki są w tej aplikacji. Są zaawansowane i robi się je z trenerem. Kolejność nie zmienia się dlatego, że film wygląda łatwo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflips, frontflips e corks estão nesta app. São avançados e fazem-se com um treinador. A ordem não muda porque um vídeo parece fácil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflips, frontflips och corks finns i den här appen. De är avancerade och görs med en coach. Ordningen ändras inte för att en video ser lätt ut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后空翻、前空翻和 cork 都在这个应用里。它们是高级动作，要和教练一起做。视频看起来容易，顺序也不会变。"
          }
        }
      }
    },
    "trick.inversion-order.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app replaces a person who can say 'not today'. Listen to them. Emergency numbers stay in the phone: 144 and 1414 in Switzerland, 112 in France."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app ne remplace quelqu'un qui peut dire « pas aujourd'hui ». Écoute cette personne. Les numéros restent dans le téléphone : 144 et 1414 en Suisse, 112 en France."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná aplikace nenahradí člověka, který řekne „dnes ne”. Poslouchej. Čísla zůstanou v telefonu: 144 a 1414 ve Švýcarsku, 112 ve Francii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App ersetzt eine Person, die „heute nicht“ sagen kann. Hör auf sie. Die Notrufnummern bleiben im Telefon: 144 und 1414 in der Schweiz, 112 in Frankreich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna app sustituye a una persona que puede decir «hoy no». Escúchala. Los números se quedan en el teléfono: 144 y 1414 en Suiza, 112 en Francia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app sostituisce una persona che può dire «oggi no». Ascoltala. I numeri restano nel telefono: 144 e 1414 in Svizzera, 112 in Francia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日はやめ」と言える人の代わりになるアプリはない。その人の言うことを聞く。番号は電話に残す。スイスは144と1414、フランスは112。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘오늘은 아니야’라고 말할 수 있는 사람을 앱이 대신하지 못해. 그 말을 들어. 번호는 전화에 남겨. 스위스는 144와 1414, 프랑스는 112."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen app erstatter en person som kan si «ikke i dag». Hør på dem. Numrene blir i telefonen: 144 og 1414 i Sveits, 112 i Frankrike."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen app vervangt iemand die ‘vandaag niet’ kan zeggen. Luister. De nummers blijven in de telefoon: 144 en 1414 in Zwitserland, 112 in Frankrijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna aplikacja nie zastąpi osoby, która może powiedzieć „dziś nie”. Słuchaj jej. Numery zostają w telefonie: 144 i 1414 w Szwajcarii, 112 we Francji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma app substitui uma pessoa que pode dizer «hoje não». Ouve-a. Os números ficam no telemóvel: 144 e 1414 na Suíça, 112 em França."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen app ersätter en person som kan säga ”inte idag”. Lyssna. Numren stannar i telefonen: 144 och 1414 i Schweiz, 112 i Frankrike."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有应用能代替一个可以说“今天不行”的人。听那个人的。号码留在手机里：瑞士 144 和 1414，法国 112。"
          }
        }
      }
    },
    "trick.inversion-order.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First the trampoline, with a coach or a trained spotter who can catch you. You learn to set, to spot the landing, and to bail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'abord le trampoline, avec un coach ou un pareur formé qui peut te rattraper. Tu apprends le set, à voir la réception, et à abandonner."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív trampolína, s trenérem nebo vyškoleným spotterem, který tě chytí. Učíš se set, vidět dopad a vzdát to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst das Trampolin, mit einem Coach oder einem ausgebildeten Spotter, der dich fangen kann. Du lernst den Set, die Landung zu sehen und abzubrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero el trampolín, con un coach o un spotter formado que pueda cogerte. Aprendes el set, a ver la recepción y a abortar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima il trampolino, con un coach o un paratore formato che può prenderti. Impari il set, a vedere la ricezione e a rinunciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずトランポリン。コーチか、受け止められる訓練されたスポッターと。セット、着地を見ること、やめることを覚える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 트램펄린. 코치나, 받아 줄 수 있는 훈련된 스포터와. 세트, 착지를 보는 것, 포기하는 것을 배워."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Først trampolinen, med en trener eller en utdannet spotter som kan ta imot deg. Du lærer set, å se landingen og å avbryte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst de trampoline, met een coach of een opgeleide spotter die je kan opvangen. Je leert de set, de landing te zien en af te breken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw trampolina, z trenerem albo wyszkolonym spotterem, który może cię złapać. Uczysz się setu, widzenia lądowania i rezygnacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro o trampolim, com um treinador ou um spotter formado que te possa apanhar. Aprendes o set, a ver a receção e a desistir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Först studsmattan, med en coach eller en utbildad spotter som kan fånga dig. Du lär dig set, att se landningen och att avbryta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先上蹦床，和教练，或者能接住你的受过训练的保护者。你学起跳姿态、看见落地，以及放弃。"
          }
        }
      }
    },
    "trick.inversion-order.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then a water ramp or an airbag, still with that coach. Snow is not the place to discover the rotation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite un tremplin d'eau ou un airbag, toujours avec ce coach. La neige n'est pas l'endroit où tu découvres la rotation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pak vodní rampa nebo airbag, pořád s tím trenérem. Sníh není místo, kde objevíš rotaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann eine Wasserrampe oder ein Airbag, immer noch mit diesem Coach. Schnee ist nicht der Ort, an dem du die Drehung entdeckst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego una rampa de agua o un airbag, todavía con ese coach. La nieve no es el sitio donde descubres el giro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi una rampa d'acqua o un airbag, sempre con quel coach. La neve non è il posto dove scopri la rotazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次はウォーターランプかエアバッグ。同じコーチと。回転を発見する場所は雪ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음은 워터 램프나 에어백. 같은 코치와. 회전을 처음 알아내는 곳은 눈이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så en vannrampe eller en airbag, fortsatt med den treneren. Snø er ikke stedet der du oppdager rotasjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna een waterramp of een airbag, nog steeds met die coach. Sneeuw is niet de plek waar je de draai ontdekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem rampa wodna albo airbag, wciąż z tym trenerem. Śnieg nie jest miejscem, w którym odkrywasz obrót."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois uma rampa de água ou um airbag, ainda com esse treinador. A neve não é o sítio onde descobres a rotação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan en vattenramp eller en airbag, fortfarande med den coachen. Snö är inte platsen där du upptäcker rotationen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后是水台或气垫，还是那位教练。雪不是你发现旋转的地方。"
          }
        }
      }
    },
    "trick.inversion-order.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow comes last: a jump you already straight-air cleanly, a steep landing, a coach who says go, speed checked, nobody below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La neige en dernier : un saut que tu passes déjà droit et propre, une réception pentue, un coach qui dit oui, la vitesse vérifiée, personne en dessous."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sníh až nakonec: skok, který už jedeš rovně a čistě, strmý dopad, trenér, který řekne ano, rychlost ověřená, nikdo pod tebou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnee kommt zuletzt: ein Sprung, den du schon sauber geradeaus fährst, eine steile Landung, ein Coach, der ja sagt, Tempo geprüft, niemand darunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nieve al final: un salto que ya haces recto y limpio, una recepción empinada, un coach que dice sí, velocidad comprobada, nadie debajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La neve per ultima: un salto che già fai dritto e pulito, una ricezione ripida, un coach che dice sì, velocità verificata, nessuno sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪は最後。すでにまっすぐきれいに通せるジャンプ、急な着地、はいと言うコーチ、確認した速さ、下に誰もいない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈은 맨 마지막. 이미 곧고 깨끗하게 넘는 점프, 가파른 착지, 예라고 하는 코치, 확인한 속도, 아래에 아무도 없을 때."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snø kommer sist: et hopp du allerede kjører rett og rent, en bratt landing, en trener som sier ja, farten sjekket, ingen nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneeuw komt laatst: een jump die je al recht en schoon rijdt, een steile landing, een coach die ja zegt, snelheid gecheckt, niemand eronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śnieg na końcu: skok, który już jedziesz prosto i czysto, strome lądowanie, trener, który mówi tak, prędkość sprawdzona, nikt poniżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A neve por último: um salto que já fazes a direito e limpo, uma receção íngreme, um treinador que diz sim, velocidade verificada, ninguém por baixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snö kommer sist: ett hopp du redan åker rakt och rent, en brant landning, en coach som säger ja, farten kollad, ingen nedanför."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪排在最后：一个你已经能干净直跳的跳台，陡的落地区，教练说可以，速度核对过，下面没有人。"
          }
        }
      }
    },
    "trick.inversion-order.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you hesitate on the approach, you ride out. The decision is made before you drop, not on the lip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu hésites dans l'approche, tu passes droit. La décision se prend avant de partir, pas sur la lèvre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když váháš v nájezdu, jedeš rovně. Rozhodnutí padne před startem, ne na hraně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du im Anlauf zögerst, fährst du geradeaus. Die Entscheidung fällt, bevor du losfährst, nicht an der Lippe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dudas en la aproximación, pasas recto. La decisión se toma antes de salir, no en el labio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esiti in avvicinamento, passi dritto. La decisione si prende prima di partire, non sul lip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプローチで迷ったらまっすぐ抜ける。決めるのは出る前。リップではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입에서 망설이면 곧게 넘어가. 결정은 나가기 전이지, 립이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøler du i innkjøringen, kjører du rett. Avgjørelsen tas før du slipper, ikke på lippen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aarzel je in de aanloop, dan rijd je rechtdoor. De beslissing valt vóór je gaat, niet op de lip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wahasz się na najjeździe, jedziesz prosto. Decyzja zapada przed startem, nie na krawędzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hesitas na aproximação, passas a direito. A decisão toma-se antes de saíres, não no lábio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvekar du i infarten åker du rakt. Beslutet tas innan du släpper, inte på lippen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近时犹豫，就直着滑过去。决定在出发之前，不在唇沿上。"
          }
        }
      }
    },
    "trick.inversion-order.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many coaches will not teach this until the basics are boring and you are old enough for their program. That is the program, not an insult."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de coachs n'enseigneront pas ça tant que les bases ne sont pas ennuyeuses, et pas avant l'âge de leur programme. C'est le programme, pas une insulte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnoho trenérů to neučí, dokud základy nejsou nudné a nemáš věk jejich programu. To je program, ne urážka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Coaches bringen das erst bei, wenn die Grundlagen langweilig sind und du alt genug für ihr Programm bist. Das ist das Programm, keine Beleidigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchos coaches no lo enseñan hasta que las bases aburren y tienes la edad de su programa. Es el programa, no un insulto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molti coach non lo insegnano finché le basi non sono noiose e non hai l'età del loro programma. È il programma, non un insulto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くのコーチは、基礎が退屈になり、プログラムの年齢になるまで教えない。それがプログラム。侮辱ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많은 코치는 기초가 지루해지고 그 프로그램 나이가 될 때까지 가르치지 않아. 그게 프로그램이야. 모욕이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mange trenere lærer ikke bort dette før grunnlaget er kjedelig og du er gammel nok for programmet deres. Det er programmet, ikke en fornærmelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel coaches leren dit pas als de basis saai is en je oud genoeg bent voor hun programma. Dat is het programma, geen belediging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wielu trenerów nie uczy tego, póki podstawy nie są nudne i nie masz wieku ich programu. To program, nie obraza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos treinadores não ensinam isto até as bases serem aborrecidas e teres a idade do programa deles. É o programa, não um insulto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Många coacher lär inte ut det förrän grunderna är tråkiga och du är gammal nog för deras program. Det är programmet, ingen förolämpning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很多教练要等基础变得无聊、你也到了他们课程的年龄，才教这个。这是课程，不是侮辱。"
          }
        }
      }
    },
    "trick.inversion-order.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Film the basics (straight air, 180, 360). Progress shows there before any magazine trick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme tes bases (saut droit, 180, 360). Le progrès se voit là, avant les figures de magazine."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Natoč základy (straight air, 180, 360). Pokrok je vidět tam, před každým trikem z magazínu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Film die Grundlagen (Straight Air, 180, 360). Der Fortschritt zeigt sich dort, vor jedem Magazin-Trick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba las bases (straight air, 180, 360). El progreso se ve ahí, antes de cualquier trick de revista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filma le basi (straight air, 180, 360). Il progresso si vede lì, prima di ogni trick da rivista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基礎（ストレートエア、180、360）を撮る。雑誌の技の前に、進歩はそこにある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기초(스트레이트 에어, 180, 360)를 찍어. 잡지 트릭보다 먼저, 발전은 거기에 보여."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Film grunnlaget (straight air, 180, 360). Fremgangen synes der, før hvert magasin-triks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Film de basis (straight air, 180, 360). De vooruitgang zie je daar, vóór elke magazine-trick."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj podstawy (straight air, 180, 360). Postęp widać tam, przed każdym trikiem z magazynu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Filma as bases (straight air, 180, 360). O progresso vê-se aí, antes de qualquer trick de revista."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filma grunderna (straight air, 180, 360). Framstegen syns där, före varje magasin-trick."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把基础拍下来（直跳、180、360）。进步出现在那里，在任何杂志动作之前。"
          }
        }
      }
    },
    "trick.inversion-order.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fear is information. If you don't want to go, you don't owe anyone a jump."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La peur est une info. Si tu n'as pas envie, tu ne dois rien à personne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strach je informace. Když nechceš, nikomu skok nedlužíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angst ist eine Information. Wenn du nicht willst, schuldest du niemandem einen Sprung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El miedo es información. Si no quieres, no le debes un salto a nadie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La paura è un'informazione. Se non vuoi, non devi un salto a nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "怖さは情報。行きたくなければ、誰にもジャンプを借りていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두려움은 정보야. 가고 싶지 않으면 누구에게도 점프를 빚진 게 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frykt er informasjon. Vil du ikke, skylder du ingen et hopp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Angst is informatie. Als je niet wilt, ben je niemand een jump schuldig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strach to informacja. Jeśli nie chcesz, nikomu nie jesteś winien skoku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O medo é uma informação. Se não queres, não deves um salto a ninguém."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rädsla är information. Vill du inte är du ingen ett hopp skyldig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "害怕是信息。你不想去，就不欠任何人一个跳跃。"
          }
        }
      }
    },
