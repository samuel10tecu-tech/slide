    "trick.park-rules.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A terrain park is not a normal piste. Everyone goes the same way, and nobody stops on a landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le snowpark n'est pas une piste normale. Tout le monde descend dans le même sens, et personne ne s'arrête sur une réception."
          }
        }
      }
    },
    "trick.park-rules.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Switzerland: 144 for an ambulance, 1414 for REGA helicopter. In nearby France: 112. Save the numbers before you go up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En Suisse, les secours : 144 (ambulance) et 1414 (REGA, hélico). En France voisine : 112. Mets ces numéros dans ton téléphone avant de monter."
          }
        }
      }
    },
    "trick.park-rules.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the day's map at the bottom. Features are sized S, M, L, XL. Start on S."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde le plan du jour au départ. Les modules ont une taille : S, M, L, XL. Commence par S."
          }
        }
      }
    },
    "trick.park-rules.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look uphill and downhill before you drop. One look, then you go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de partir, regarde en haut ET en bas. Un coup d'œil, puis tu t'engages."
          }
        }
      }
    },
    "trick.park-rules.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't cross a jump or a rail. Ride the line, exit, and clear to the side."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne traverse pas un kick ou un rail. Tu suis la ligne, tu sors, tu dégages sur le côté."
          }
        }
      }
    },
    "trick.park-rules.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you fall, get off the line immediately, even if it hurts. The rider behind cannot see you in time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu tombes, sors de la ligne tout de suite, même si tu as mal. La personne derrière ne te voit pas assez tôt."
          }
        }
      }
    },
    "trick.park-rules.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One rider at a time on a feature. Wait until the landing is empty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul rider à la fois sur un module. Tu attends que la réception soit libre."
          }
        }
      }
    },
    "trick.park-rules.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helmet buckled before the first chair, not 'only for the park'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le casque est fermé avant le premier télésiège, pas « pour le park seulement »."
          }
        }
      }
    },
    "trick.park-rules.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the snow is hard or you are tired, the park can wait. Most bad falls are at the end of the day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la neige est dure ou que tu es fatigué, le park peut attendre. La plupart des grosses chutes arrivent en fin de journée."
          }
        }
      }
    },
    "trick.protections.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helmet and back protector"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casque et dorsale"
          }
        }
      }
    },
    "trick.protections.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fitted ski helmet, a back protector, and full gloves. Not optional if you jump or slide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un casque de ski bien réglé, une dorsale, et des gants entiers. Ce n'est pas négociable pour sauter ou slider."
          }
        }
      }
    },
    "trick.protections.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A beanie under the helmet is not a helmet. Landing bumps are often hard in the afternoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bonnet sous le casque ne remplace pas le casque. Les bosses de réception sont souvent dures l'après-midi."
          }
        }
      }
    },
    "trick.protections.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helmet does not shift when you shake your head. The strap is closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le casque ne bouge pas quand tu secoues la tête. La sangle est fermée."
          }
        }
      }
    },
    "trick.protections.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The back protector covers the middle of the back, not only the shoulders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dorsale couvre le milieu du dos, pas seulement les épaules."
          }
        }
      }
    },
    "trick.protections.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knee and hip padding helps the day you learn butters and switch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des genoux et des fesses protégés aident le jour où tu apprends les butters et le switch."
          }
        }
      }
    },
    "trick.protections.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buckle the boots tight. Play in the shell and the landing goes sideways."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resserre les chaussures. Un jeu dans la coque, et la réception part de travers."
          }
        }
      }
    },
    "trick.protections.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the helmet took a hard hit, replace it. The foam can be dead without looking broken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le casque a pris un gros choc, on le change. La mousse ne se voit pas, mais elle ne protège plus."
          }
        }
      }
    },
    "trick.protections.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gloves with a reinforced palm save an open hand on a rail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des gants avec une paume renforcée évitent les mains ouvertes sur un rail."
          }
        }
      }
    },
    "trick.fall-better.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fall without snapping"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomber sans se casser"
          }
        }
      }
    },
    "trick.fall-better.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will fall. The goal is to slide, not to post a hand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vas tomber. Le but est de glisser, pas de planter les mains."
          }
        }
      }
    },
    "trick.fall-better.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planting a hand to 'catch yourself' breaks a wrist or a thumb. You accept the slide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une main plantée pour « se rattraper » casse un poignet ou un pouce. Tu acceptes de glisser."
          }
        }
      }
    },
    "trick.fall-better.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuck the arms. Thumbs along the hands, not stuck out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentre les bras. Les pouces le long des mains, pas écartés."
          }
        }
      }
    },
    "trick.fall-better.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fall to the side, hip and thigh, and let yourself slide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombe sur le côté, hanche et cuisse, et laisse-toi glisser."
          }
        }
      }
    },
    "trick.fall-better.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chin toward the chest so the back of the helmet hits before the neck."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menton se rentre vers la poitrine pour que l'arrière du casque touche avant la nuque."
          }
        }
      }
    },
    "trick.fall-better.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't stand up while you are still on a jump or rail line."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne te relève pas tant que tu es sur la ligne d'un saut ou d'un rail."
          }
        }
      }
    },
    "trick.fall-better.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice falling on a gentle slope, slow, before the park."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi à tomber sur une pente douce, à petite vitesse, avant le park."
          }
        }
      }
    },
    "trick.fall-better.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are unsure about pain in the head, neck or back: stop and call. Not 'one more run'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as un doute sur une douleur à la tête, au cou ou au dos : tu t'arrêtes, tu appelles. Pas de « encore un run »."
          }
        }
      }
    },
    "trick.read-jump.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a jump"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire un saut"
          }
        }
      }
    },
    "trick.read-jump.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The jump is won before the lip. You pick the speed, you see the landing, you decide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le saut se gagne avant le kick. Tu choisis la vitesse, tu vois la réception, tu décides."
          }
        }
      }
    },
    "trick.read-jump.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never stop on the flat just after a lip, or on the landing. The next rider is faster than you think."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne s'arrête jamais sur le plat juste après un kick, ni sur la réception. Les autres arrivent vite."
          }
        }
      }
    },
    "trick.read-jump.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop on the side, never on the track, and look at the lip then the landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête-toi sur le côté, jamais sur la trajectoire, et regarde le kick puis la réception."
          }
        }
      }
    },
    "trick.read-jump.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where the slope continues. If you cannot see the bottom, you do not go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère où la piste reprend. Si tu ne vois pas le bas, tu ne pars pas."
          }
        }
      }
    },
    "trick.read-jump.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch two riders to learn the speed: too short, or too long."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde deux riders passer pour comprendre la vitesse : trop court, ou trop long."
          }
        }
      }
    },
    "trick.read-jump.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a start point. Too high means too fast. Too low and you land on the flat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère un point de départ. Trop haut = trop vite. Trop bas = tu poses sur le plat."
          }
        }
      }
    },
    "trick.read-jump.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first hit is straight, no grab and no spin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier passage se fait droit, sans grab et sans rotation."
          }
        }
      }
    },
    "trick.read-jump.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean S jump beats a missed M."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un saut S bien pris vaut mieux qu'un M raté."
          }
        }
      }
    },
    "trick.read-jump.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headwind or flat light hides the landing. Wait."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le vent de face est fort ou que la lumière est plate, la réception se voit mal. Attends."
          }
        }
      }
    },
    "trick.straight-air.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut droit"
          }
        }
      }
    },
    "trick.straight-air.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air is the base of everything else: pop, quiet body, eyes far away."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le saut droit, c'est la base de tout le reste : pop, corps calme, regard loin."
          }
        }
      }
    },
    "trick.straight-air.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No violent pop on a jump you don't know. Roll it almost flat first, then add a little air."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de pop violent sur un kick que tu ne connais pas. D'abord tu le roules presque, ensuite tu ajoutes un peu d'air."
          }
        }
      }
    },
    "trick.straight-air.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive athletic: ankles, knees and hips a little bent, hands in front."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive en position athlétique : chevilles, genoux et hanches un peu fléchis, mains devant."
          }
        }
      }
    },
    "trick.straight-air.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the end of the landing, not your tips."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde la fin de la réception, pas tes spatules."
          }
        }
      }
    },
    "trick.straight-air.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the lip, push down (the pop) and let the skis come with you. Don't throw the shoulders back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la lèvre, tu pousses vers le bas (le pop) et tu laisses les skis monter avec toi. Tu ne jettes pas les épaules en arrière."
          }
        }
      }
    },
    "trick.straight-air.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the air, soft knees, skis parallel, weight in the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En l'air, genoux souples, skis parallèles, poids au milieu."
          }
        }
      }
    },
    "trick.straight-air.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both skis touch first, then you flex to absorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu touches en premier avec les deux skis, puis tu plies pour absorber."
          }
        }
      }
    },
    "trick.straight-air.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you leave backwards, your eyes and hips stayed on the lip. Look far ahead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu pars en arrière, c'est souvent le regard et les hanches qui sont restés sur le kick. Regarde loin devant."
          }
        }
      }
    },
    "trick.straight-air.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Film yourself from the side. You'll see a broken waist immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme-toi de côté. Tu verras tout de suite si tu es cassé à la taille."
          }
        }
      }
    },
    "trick.landing.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Landing"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réception"
          }
        }
      }
    },
    "trick.landing.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A good landing is soft in the legs and steady in the eyes. The ski touches, the body follows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bonne réception est molle dans les jambes et solide dans le regard. Le ski touche, le corps suit."
          }
        }
      }
    },
    "trick.landing.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Landing stiff means the knee takes the hit instead of the spring. If you are too long, take a slightly low landing rather than reaching for the flat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterrir tendu, c'est le genou qui encaisse à la place du ressort. Si tu sens que tu es trop long, assume une réception un peu basse plutôt qu'un rattrapage au plat."
          }
        }
      }
    },
    "trick.landing.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the air, prepare the legs: not locked, not glued to your hips."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En l'air, prépare les jambes : ni tendues, ni collées aux fesses."
          }
        }
      }
    },
    "trick.landing.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the slope with the skis. They land along the landing, not flat on the flat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche la pente avec les skis. Ils se posent dans le sens de la réception, pas à plat sur le plat."
          }
        }
      }
    },
    "trick.landing.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On contact, flex ankle, knee, hip, in that order, like a spring."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au contact, plie chevilles-genoux-hanches dans cet ordre, comme un ressort."
          }
        }
      }
    },
    "trick.landing.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands stay low and in front. They do not go to the sky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mains restent basses et devant. Elles ne partent pas au ciel."
          }
        }
      }
    },
    "trick.landing.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you are stable, get off the line."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois stable, sors de la ligne."
          }
        }
      }
    },
    "trick.landing.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound should be dull, not a slap. A slap means stiff legs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bruit doit être sourd, pas un claquement. Claquement = jambes raides."
          }
        }
      }
    },
    "trick.landing.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After three bad landings in a row, change feature or stop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après trois mauvaises réceptions d'affilée, tu changes de module ou tu arrêtes."
          }
        }
      }
    },
    "trick.ollie.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollie"
          }
        }
      }
    },
    "trick.ollie.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ollie is a pop from the tails. It helps on a small hit, a bump, or leaving a box."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ollie est un pop depuis la queue des skis. Il sert sur un petit hit, une bosse, ou pour décoller une box."
          }
        }
      }
    },
    "trick.ollie.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn the ollie on the flat, away from people, before you take it to a lip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends l'ollie sur le plat, loin du monde, avant de l'emmener sur une lèvre."
          }
        }
      }
    },
    "trick.ollie.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a straight line, medium speed, flex a little."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ligne droite, à vitesse moyenne, fléchis un peu."
          }
        }
      }
    },
    "trick.ollie.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push the feet forward to load the tails, without sitting down."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse les pieds vers l'avant pour charger la queue, sans t'asseoir."
          }
        }
      }
    },
    "trick.ollie.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend ankles and knees at once. The tip rises, the tail follows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplie d'un coup chevilles et genoux. La spatule monte, la queue suit."
          }
        }
      }
    },
    "trick.ollie.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the knees up so the skis stay with your feet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les genoux pour garder les skis collés aux pieds."
          }
        }
      }
    },
    "trick.ollie.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land flat, both skis together, and absorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose-toi à plat, les deux skis ensemble, et absorbe."
          }
        }
      }
    },
    "trick.ollie.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If only the tip leaves the snow, you pulled with your back. The pop comes from the legs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si seule la spatule décolle, tu as tiré avec le dos. Le pop vient des jambes."
          }
        }
      }
    },
    "trick.ollie.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small clean ollie beats a big off-balance hop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit ollie propre bat un grand saut déséquilibré."
          }
        }
      }
    },
    "trick.safety-grab.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety grab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety grab"
          }
        }
      }
    },
    "trick.safety-grab.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The safety is grabbing the ski just in front of the binding, between the feet. The most stable grab to start with."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le safety, c'est attraper le ski juste devant la fixation, entre les deux pieds. Le grab le plus stable pour commencer."
          }
        }
      }
    },
    "trick.safety-grab.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose the slope while grabbing, the grab was too early or too low. Let go and land."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne vois plus la piste en attrapant, le grab est trop tôt ou trop bas. Lâche et pose-toi."
          }
        }
      }
    },
    "trick.safety-grab.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start on a small straight air you already land without thinking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'abord sur un petit saut droit que tu poses déjà sans y penser."
          }
        }
      }
    },
    "trick.safety-grab.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the air, bend the knees and bring the ski to the hand. Don't dive the hand down and break the back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En l'air, plie les genoux et amène le ski à la main. Tu ne plonges pas la main vers le ski en cassant le dos."
          }
        }
      }
    },
    "trick.safety-grab.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front or back hand grabs the inside of the ski, in front of the binding."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La main avant ou arrière attrape le ski côté intérieur, devant la fixation."
          }
        }
      }
    },
    "trick.safety-grab.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold it for a second, let go, set up the landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tiens le grab une seconde, tu lâches, tu prépares la réception."
          }
        }
      }
    },
    "trick.safety-grab.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes stay on the landing the whole time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regard reste sur la réception pendant tout le grab."
          }
        }
      }
    },
    "trick.safety-grab.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knees up, torso quiet. The grab should not turn your shoulders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoux hauts, torse calme. Le grab ne doit pas tourner tes épaules."
          }
        }
      }
    },
    "trick.safety-grab.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do the safety on both sides before you change grabs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe le safety des deux côtés avant de changer de grab."
          }
        }
      }
    },
    "trick.box-5050.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50 on a box"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50 sur une box"
          }
        }
      }
    },
    "trick.box-5050.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 50-50: both skis in line, in the middle of the box, like a very wide flat rail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 50-50 : les deux skis dans l'axe, au milieu de la box, comme un rail très large et plat."
          }
        }
      }
    },
    "trick.box-5050.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First session: helmet, and someone watching. If you are sideways, you exit. You don't force a finish."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première session : casque, et quelqu'un qui regarde. Si tu es de travers, tu sors. Tu n'insistes pas pour « finir »."
          }
        }
      }
    },
    "trick.box-5050.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a low, straight box with a flat start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une box basse, droite, avec un départ plat."
          }
        }
      }
    },
    "trick.box-5050.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the exit, not your skis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde la sortie, pas tes skis."
          }
        }
      }
    },
    "trick.box-5050.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get on in the middle, skis parallel, equal weight on both feet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte dessus au milieu, skis parallèles, poids égal sur les deux pieds."
          }
        }
      }
    },
    "trick.box-5050.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft knees, low arms. You don't jump onto the box: you roll onto it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoux souples, bras bas. Tu ne sautes pas sur la box : tu y roules."
          }
        }
      }
    },
    "trick.box-5050.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the end, let the box go and absorb the small drop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin, tu laisses la box partir et tu absorbes la petite marche."
          }
        }
      }
    },
    "trick.box-5050.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bit of speed, not a crawl. Too slow and the skis stick or wander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu de vitesse, pas une pointe. Trop lent, les skis collent ou dévient."
          }
        }
      }
    },
    "trick.box-5050.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes dropping to the tips tip you forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regard qui tombe sur les spatules te fait tomber vers l'avant."
          }
        }
      }
    },
    "trick.one-eighty.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "180"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "180"
          }
        }
      }
    },
    "trick.one-eighty.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A half turn in the air. You leave forward and land switch — the other way comes later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un demi-tour en l'air. Tu pars en avant, tu poses en switch — ou l'inverse plus tard."
          }
        }
      }
    },
    "trick.one-eighty.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 180 is first on an S jump, both directions, before a bigger feature."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 180 se fait d'abord sur un jump S, dans les deux sens, avant un module plus grand."
          }
        }
      }
    },
    "trick.one-eighty.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already ski a bit of switch, at least on a mellow blue, so the landing isn't a surprise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sache déjà skier un peu en switch, au moins sur une piste bleue douce, pour que la pose ne te fasse pas peur."
          }
        }
      }
    },
    "trick.one-eighty.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a small jump, pop straight, then turn the head and shoulders. The skis follow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un petit kick, pop droit, puis tourne la tête et les épaules dans le sens choisi. Les skis suivent."
          }
        }
      }
    },
    "trick.one-eighty.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips turn with the shoulders. Not only the arms."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hanches tournent avec les épaules. Pas seulement les bras."
          }
        }
      }
    },
    "trick.one-eighty.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for 180, not 270. Lock the eyes on the landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vises 180, pas 270. Tu bloques le regard vers la réception."
          }
        }
      }
    },
    "trick.one-eighty.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land switch, weight in the middle, and ride straight for a few metres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose en switch, poids au milieu, et continue tout droit quelques mètres."
          }
        }
      }
    },
    "trick.one-eighty.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an easy direction (often looking over the front shoulder) and clean it before the other way."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un sens « facile » (souvent celui où tu regardes par-dessus l'épaule avant) et propre-le avant l'autre."
          }
        }
      }
    },
    "trick.one-eighty.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you under-rotate, the head left late, not the feet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu sous-tournes, c'est la tête qui est partie trop tard, pas les pieds."
          }
        }
      }
    },
    "trick.switch-riding.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiing switch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skier en switch"
          }
        }
      }
    },
    "trick.switch-riding.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch means the other foot in front. Without it, 180s and slides stay guesses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch = à l'envers, l'autre pied devant. Sans ça, les 180 et les slides restent des paris."
          }
        }
      }
    },
    "trick.switch-riding.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch tires muscles you don't usually use. Stop before you cut someone off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le switch fatigue des muscles que tu n'utilises pas. Arrête-toi avant de croiser quelqu'un n'importe comment."
          }
        }
      }
    },
    "trick.switch-riding.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the flat, slide switch just to feel which foot is forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le plat, glisse en switch, juste pour sentir quel pied est devant."
          }
        }
      }
    },
    "trick.switch-riding.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ski a whole green run switch, wide turns."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends une verte entière en switch, virages larges."
          }
        }
      }
    },
    "trick.switch-riding.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands low, a bit more weight on the uphill ski, like forwards — mirrored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les mains basses et le poids un peu plus sur le ski amont, comme en avant… mais tout est miroir."
          }
        }
      }
    },
    "trick.switch-riding.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do traverses, then small carved turns."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais des traversées, puis des petits virages coupés."
          }
        }
      }
    },
    "trick.switch-riding.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a green switch is boring, move to an easy blue. Not before."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une verte en switch est ennuyeuse, passe à une bleue facile. Pas avant."
          }
        }
      }
    },
    "trick.switch-riding.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five minutes each lift beats one hour on the last day of the trip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq minutes à chaque remontée valent mieux qu'une heure le dernier jour des vacances."
          }
        }
      }
    },
    "trick.switch-riding.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look far. In switch the eyes drop toward the back tip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde loin. En switch, le regard a tendance à tomber sur la spatule arrière."
          }
        }
      }
    },
    "trick.nollie.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollie"
          }
        }
      }
    },
    "trick.nollie.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nollie pops from the tips. It is the ollie reversed, and it prepares switch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nollie pop depuis la spatule. C'est l'ollie à l'envers, et il prépare le switch."
          }
        }
      }
    },
    "trick.nollie.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much weight forward and you plant the tips. Keep the hands in front of the hips, not over your head."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de poids avant, et tu plantes les spatules. Garde les mains devant le bassin, pas au-dessus de la tête."
          }
        }
      }
    },
    "trick.nollie.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a straight line, move the hips a little forward to load the front of the skis, without going over."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ligne droite, avance un peu le bassin pour charger l'avant des skis, sans passer par-dessus."
          }
        }
      }
    },
    "trick.nollie.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop by extending the ankles. The tails rise first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop en dépliant les chevilles. La queue monte en premier."
          }
        }
      }
    },
    "trick.nollie.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the knees up, skis flat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les genoux, skis à plat."
          }
        }
      }
    },
    "trick.nollie.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land in the middle of the ski."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose-toi au milieu du ski."
          }
        }
      }
    },
    "trick.nollie.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate ollie and nollie on the flat until they are the same height."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne ollie et nollie sur le plat jusqu'à ce que les deux aient la même hauteur."
          }
        }
      }
    },
    "trick.nollie.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nollie is easier to feel if you are already low before the pop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nollie est plus facile à sentir en étant très bas avant le pop."
          }
        }
      }
    },
    "trick.nollie.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it leaves crooked, your shoulders turned. Keep them parallel to the skis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il part de travers, tes épaules ont tourné. Garde-les parallèles aux skis."
          }
        }
      }
    },
    "trick.mute.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute grab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute grab"
          }
        }
      }
    },
    "trick.mute.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mute: the front hand grabs the front ski, outside edge, between tip and binding."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mute : la main avant attrape le ski avant, côté extérieur, entre la spatule et la fixation."
          }
        }
      }
    },
    "trick.mute.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A grab that makes you miss the landing is not a grab. Shorten it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grab qui te fait perdre la réception n'est pas un grab. Tu le raccourcis."
          }
        }
      }
    },
    "trick.mute.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from a stable straight air, safety already clean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pars d'un saut droit stable, safety déjà propre."
          }
        }
      }
    },
    "trick.mute.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the front ski to the front hand. The knee comes to the chest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte le ski avant vers la main avant. Le genou vient à la poitrine."
          }
        }
      }
    },
    "trick.mute.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grab the outside of the ski, not between the legs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attrape le ski à l'extérieur, pas entre les jambes."
          }
        }
      }
    },
    "trick.mute.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other arm opens a little for balance, without starting a spin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre bras s'écarte un peu pour l'équilibre, sans lancer la rotation."
          }
        }
      }
    },
    "trick.mute.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let go early, skis parallel, absorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâche tôt, remets les skis parallèles, absorbe."
          }
        }
      }
    },
    "trick.mute.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knee up, not a broken back reaching for the ski."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genou haut, pas dos cassé vers le ski."
          }
        }
      }
    },
    "trick.mute.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mute should not open the hip enough to cross the skis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mute ne doit pas ouvrir ta hanche au point de croiser les skis."
          }
        }
      }
    },
    "trick.three-sixty.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "360"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "360"
          }
        }
      }
    },
    "trick.three-sixty.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full turn. You land the way you left. It needs a clean 180 both ways."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour complet. Tu poses dans le sens de départ. Ça demande un 180 propre des deux côtés."
          }
        }
      }
    },
    "trick.three-sixty.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No 360 on an M until the 360 on an S is calm, one direction, ten times in a row."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de 360 sur un M tant que le 360 sur un S est calme, dans un seul sens, dix fois de suite."
          }
        }
      }
    },
    "trick.three-sixty.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small jump, straight-air speed, pop up before you spin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit kick, vitesse de saut droit, pop vers le haut avant de tourner."
          }
        }
      }
    },
    "trick.three-sixty.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head first, then shoulders, then hips. The skis follow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tête part en premier, puis les épaules, puis les hanches. Les skis suivent."
          }
        }
      }
    },
    "trick.three-sixty.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a spot on the landing and find it again at the end of the turn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère un point dans la réception et retrouve-le à la fin du tour."
          }
        }
      }
    },
    "trick.three-sixty.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the skis together. A trailing ski kills the spin, or finishes it too early."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les skis groupés. Un ski qui traîne coupe la rotation… ou la finit trop tôt."
          }
        }
      }
    },
    "trick.three-sixty.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block the upper body when you see the slope again, and land in the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque le haut du corps quand tu revois la piste, et pose-toi au milieu."
          }
        }
      }
    },
    "trick.three-sixty.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under-rotating is normal at first. Add the head, not a violent shoulder throw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-tourner est normal au début. Tu ajoutes la tête, pas un jeté d'épaule violent."
          }
        }
      }
    },
    "trick.three-sixty.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you over-rotate, you popped late and spun early. Pop first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu sur-tournes, tu as pop trop tard et tourné trop tôt. Pop d'abord."
          }
        }
      }
    },
    "trick.nose-butter.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nose butter"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nose butter"
          }
        }
      }
    },
    "trick.nose-butter.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nose butter slides on the tips and pivots the tails. Slow, on a soft bump."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nose butter : tu glisses sur la spatule et tu fais pivoter l'arrière. C'est lent, et ça se travaille sur une bosse douce."
          }
        }
      }
    },
    "trick.nose-butter.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Butters happen away from other people. A sweeping tail hits someone's shins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les butters se font loin des autres. Une queue qui balaie accroche les tibias de quelqu'un."
          }
        }
      }
    },
    "trick.nose-butter.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a small bump or a soft side of the piste, almost flat at the exit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve une petite bosse ou un côté de piste mou, presque plat en sortie."
          }
        }
      }
    },
    "trick.nose-butter.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move weight onto both tips, knees bent, back fairly upright."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance le poids sur les deux spatules, jambes fléchies, dos plutôt droit."
          }
        }
      }
    },
    "trick.nose-butter.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the tails break loose and turn. Guide with the feet and the eyes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse les queues décrocher et tourner. Tu guides avec les pieds et le regard."
          }
        }
      }
    },
    "trick.nose-butter.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep enough speed that you don't stop in the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde assez de vitesse pour ne pas t'arrêter au milieu."
          }
        }
      }
    },
    "trick.nose-butter.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the tails back in line before the bump ends, and return the weight to the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les queues dans l'axe avant que la bosse finisse, et redescends le poids au milieu."
          }
        }
      }
    },
    "trick.nose-butter.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you go over the front, you were too far forward and too stiff. Stay low."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu passes par-dessus, tu étais trop avant ET trop raide. Reste bas."
          }
        }
      }
    },
    "trick.nose-butter.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for a small angle first, not a 360 butter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vise d'abord un petit angle, pas un 360 butter."
          }
        }
      }
    },
    "trick.tail-butter.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tail butter"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tail butter"
          }
        }
      }
    },
    "trick.tail-butter.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tail butter loads the tails. The tips lift and turn. Same idea as the nose, reversed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tail butter charge la queue. L'avant des skis décolle et tourne. Même logique que le nose, à l'envers."
          }
        }
      }
    },
    "trick.tail-butter.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitting on the tails locks the ski and dumps you backward. Stay standing in the boots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'asseoir sur les queues bloque le ski et te fait tomber en arrière. Reste debout dans les bottes."
          }
        }
      }
    },
    "trick.tail-butter.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a soft bump, move weight to the tails without sitting down."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur une bosse douce, recule le poids sur les queues sans t'asseoir."
          }
        }
      }
    },
    "trick.tail-butter.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend the knees and let the tips get light."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fléchis les genoux et laisse les spatules devenir légères."
          }
        }
      }
    },
    "trick.tail-butter.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the tips with the feet. The upper body stays fairly quiet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne les spatules avec les pieds. Le haut du corps reste assez calme."
          }
        }
      }
    },
    "trick.tail-butter.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look where you want to come out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regard va là où tu veux ressortir."
          }
        }
      }
    },
    "trick.tail-butter.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the tips back down before the bump ends and recenter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repose les spatules avant la fin de la bosse et recentre-toi."
          }
        }
      }
    },
    "trick.tail-butter.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low arms stop you from arching."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bras bas t'empêchent de cambrer."
          }
        }
      }
    },
    "trick.tail-butter.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tiny tail butter held for a long time beats a big missed gesture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tail butter tout petit, tenu longtemps, est plus utile qu'un grand geste raté."
          }
        }
      }
    },
    "trick.rail-5050.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50 on a rail"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50 sur un rail"
          }
        }
      }
    },
    "trick.rail-5050.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same idea as the box, but the rail is narrow. Only after a straight box feels easy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même idée que la box, mais le rail est étroit. Tu y vas seulement quand la box droite est devenue facile."
          }
        }
      }
    },
    "trick.rail-5050.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't learn on a tall round rail. A slip there cuts. Stay on a low tube or a narrow box."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de rail rond et haut pour apprendre. Une glissade dessus coupe. Reste sur un tube bas ou une box étroite."
          }
        }
      }
    },
    "trick.rail-5050.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low rail, not too long, with an entry you can roll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail bas, pas trop long, avec un départ que tu peux rouler."
          }
        }
      }
    },
    "trick.rail-5050.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady speed. Aim the middle of both skis at the middle of the rail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitesse régulière. Tu vises le milieu du rail avec le milieu des deux skis."
          }
        }
      }
    },
    "trick.rail-5050.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the exit. Feet flat, soft knees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde la sortie. Les pieds restent à plat, genoux souples."
          }
        }
      }
    },
    "trick.rail-5050.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you start to slip off, don't fight it: jump off to the side."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu commences à partir de côté, tu n'insistes pas : tu sautes dehors."
          }
        }
      }
    },
    "trick.rail-5050.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exit absorbs like a small landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie s'absorbe comme une petite réception."
          }
        }
      }
    },
    "trick.rail-5050.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound should be continuous. A knock means a ski biting the edge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bruit doit être continu. Un à-coup = un ski qui mord le bord."
          }
        }
      }
    },
    "trick.rail-5050.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask someone if you are getting on crooked. You should not look at your skis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à quelqu'un de te dire si tu montes de travers. Toi, tu ne dois pas regarder tes skis."
          }
        }
      }
    },
    "trick.absorb.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorb a hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorber un hit"
          }
        }
      }
    },
    "trick.absorb.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumps and lips are taken with the legs, not the back. Absorbing means staying on the snow when you want to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bosses et les lèvres se prennent avec les jambes, pas avec le dos. Absorber, c'est rester collé à la neige quand tu le veux."
          }
        }
      }
    },
    "trick.absorb.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Staying stiff through bumps tires the knees and ends sideways. Slow down if you can't keep up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester tendu sur une série de bosses fatigue les genoux et finit en travers. Ralentis si tu ne suis plus."
          }
        }
      }
    },
    "trick.absorb.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the bump early."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère la bosse tôt."
          }
        }
      }
    },
    "trick.absorb.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just before it, you are already a little flexed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste avant, tu es déjà un peu fléchi."
          }
        }
      }
    },
    "trick.absorb.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the snow rises, bend and let the bump come into the legs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la neige monte, tu plies et tu laisses la bosse venir dans les jambes."
          }
        }
      }
    },
    "trick.absorb.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the top you can pop — or stay low if you don't want air."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut, tu peux pop — ou rester bas si tu ne veux pas décoller."
          }
        }
      }
    },
    "trick.absorb.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the trough, lengthen the legs to keep contact."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le creux, tu rallonges les jambes pour garder le contact."
          }
        }
      }
    },
    "trick.absorb.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think quiet. Less noise on the bumps means better absorption."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pense « silencieux ». Moins de bruit sur les bosses = mieux absorbé."
          }
        }
      }
    },
    "trick.absorb.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands stay in front of you. If they go back, the pop goes with them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mains restent devant toi. Si elles partent en arrière, le pop part avec."
          }
        }
      }
    },
    "trick.slide.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Box slide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide sur une box"
          }
        }
      }
    },
    "trick.slide.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The slide: skis across the box, like a skid set down on it. Almost flat at first, rotation very slow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le slide : les skis se mettent en travers de la box, comme un dérapage posé dessus. D'abord presque plat, très lent en rotation."
          }
        }
      }
    },
    "trick.slide.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slide on a thin rail comes after weeks of boxes. A ski edge catches, and the fall is hard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un slide sur un rail fin vient après des semaines de box. Le bord de ski accroche, et la chute est sèche."
          }
        }
      }
    },
    "trick.slide.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean 50-50 on this same box, both feet forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "50-50 propre sur cette même box, dans les deux sens de pied avant."
          }
        }
      }
    },
    "trick.slide.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get on in 50-50, then turn shoulders and hips together to about 90°."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte en 50-50, puis tourne les épaules et les hanches ensemble jusqu'à environ 90°."
          }
        }
      }
    },
    "trick.slide.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight stays in the middle of the skis. Don't sit downhill."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poids reste au milieu des skis. Tu ne t'assoies pas en aval."
          }
        }
      }
    },
    "trick.slide.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the exit over the front shoulder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde la sortie par-dessus l'épaule avant."
          }
        }
      }
    },
    "trick.slide.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the skis back in line before the end. A switch exit is later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les skis dans l'axe avant la fin. Sortir en switch, c'est pour plus tard."
          }
        }
      }
    },
    "trick.slide.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skid on the snow beside the box to feel 90° before you get on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dérape sur la neige à côté de la box pour sentir 90° avant de monter dessus."
          }
        }
      }
    },
    "trick.slide.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much rotation at the start puts you at 180 before the middle. Turn less, earlier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de rotation au départ te met à 180 avant le milieu. Tourne moins, plus tôt."
          }
        }
      }
    },
    "trick.japan.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan"
          }
        }
      }
    },
    "trick.japan.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The japan: you grab the front tip, outside, and the knee opens a little. Pretty, and only after a stable mute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le japan : tu attrapes la spatule avant, côté extérieur, et le genou s'ouvre un peu. Joli, mais seulement si le mute est stable."
          }
        }
      }
    },
    "trick.japan.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the japan puts you on the back edge, stop. Go back to the mute until your axis is neutral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le japan te met sur la carre arrière, arrête. Reviens au mute jusqu'à ce que l'axe soit neutre."
          }
        }
      }
    },
    "trick.japan.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, high calm pop. No spin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut droit, pop haut et calme. Pas de rotation."
          }
        }
      }
    },
    "trick.japan.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front hand finds the end of the front ski, on the outside."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La main avant va chercher le bout du ski avant, à l'extérieur."
          }
        }
      }
    },
    "trick.japan.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front knee opens slightly. The back ski stays close."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le genou avant s'écarte légèrement. Le ski arrière reste proche de l'autre."
          }
        }
      }
    },
    "trick.japan.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't pull the ski behind you until you lose the horizon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne tires pas le ski dans le dos au point de perdre l'horizon."
          }
        }
      }
    },
    "trick.japan.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let go, parallel, land in the middle of the ski."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâche, parallèle, réception au milieu du ski."
          }
        }
      }
    },
    "trick.japan.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is a style grab, not a grab to 'go bigger'. The landing matters more than the photo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un grab de style, pas un grab pour « aller plus loin ». La réception compte plus que la photo."
          }
        }
      }
    },
    "trick.japan.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the other hand low so you don't start a 180 by accident."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde l'autre main basse pour ne pas lancer un 180 sans le vouloir."
          }
        }
      }
    },
    "trick.switch-180.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 180"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 180"
          }
        }
      }
    },
    "trick.switch-180.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You leave switch and land forward. Often easier than a regular 180, because the landing is your strong direction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pars en switch et tu poses en avant. C'est souvent plus facile que le 180 classique, parce que la réception est dans ton sens fort."
          }
        }
      }
    },
    "trick.switch-180.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switch approach is the real risk: you see other people less well. Look twice before you go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'approche en switch est le vrai risque : tu vois moins bien les autres. Regarde deux fois avant de partir."
          }
        }
      }
    },
    "trick.switch-180.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean switch on a blue, and ollie or nollie already there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch propre sur une bleue, et ollie ou nollie déjà en place."
          }
        }
      }
    },
    "trick.switch-180.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small jump. Arrive switch, pop, the head turns toward your usual direction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit kick. Tu arrives en switch, tu pop, la tête tourne vers ton sens habituel."
          }
        }
      }
    },
    "trick.switch-180.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skis pass 180 and find forward again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les skis passent 180 et retrouvent l'avant."
          }
        }
      }
    },
    "trick.switch-180.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land like a normal straight air and absorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu poses comme un saut droit normal et tu absorbes."
          }
        }
      }
    },
    "trick.switch-180.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both directions before a bigger jump."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-le des deux côtés avant de l'emmener sur un plus grand kick."
          }
        }
      }
    },
    "trick.switch-180.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the approach is wrong, you don't 'send it anyway'. You roll the jump with no pop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu rates l'approche, tu ne « tentes quand même ». Tu roules le kick sans pop."
          }
        }
      }
    },
    "trick.switch-180.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the spin small and high. A flat switch 180 ends with a planted tail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la rotation petite et haute. Un switch 180 plat finit en queue plantée."
          }
        }
      }
    },
    "trick.five-forty.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "540"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "540"
          }
        }
      }
    },
    "trick.five-forty.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One and a half turns. You land switch. Only when 360s are calm both ways, on a small jump, with someone watching."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour et demi. Tu poses en switch. Seulement quand tes 360 sont calmes des deux côtés, sur un petit kick, avec quelqu'un qui te regarde."
          }
        }
      }
    },
    "trick.five-forty.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on day one of a feature, not without a helmet, not if the 360 still fails half the time. If nobody experienced can watch, stay on the 360. Inverted tricks are later in this library: trampoline, airbag, then snow with a coach. Not alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de 540 le premier jour sur un module, pas sans casque, pas si le 360 rate encore une fois sur deux. Si personne d'expérience ne peut te regarder, tu restes au 360. Les figures inversées sont plus loin dans cette bibliothèque : trampoline, airbag, puis neige avec un coach. Pas seul."
          }
        }
      }
    },
    "trick.five-forty.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prerequisite: a clean 360 left and right, and a solid switch landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-requis : 360 propre à gauche et à droite, et switch solide en sortie de saut."
          }
        }
      }
    },
    "trick.five-forty.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same pop as a 360. The spin comes from the head and hips, not a late throw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même pop qu'un 360. La rotation vient de la tête et des hanches, pas d'un jeté tardif."
          }
        }
      }
    },
    "trick.five-forty.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pass the 360 and keep going until you see the landing in switch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu passes le 360 et tu continues jusqu'à voir la réception en switch."
          }
        }
      }
    },
    "trick.five-forty.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block the shoulders, skis together, land switch in the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bloques les épaules, skis groupés, et tu poses switch au milieu."
          }
        }
      }
    },
    "trick.five-forty.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get off the line before you celebrate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sors de la ligne avant de fêter ça."
          }
        }
      }
    },
    "trick.five-forty.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under-rotating a 540 means landing sideways in switch. A committed 360 is better."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-tourner un 540, c'est poser de travers en switch. Mieux vaut un 360 assumé."
          }
        }
      }
    },
    "trick.five-forty.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed is your straight-air speed on THIS jump. Not an extra push 'for the spin'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse est celle de ton saut droit sur CE kick. Pas un élan de plus « pour la rotation »."
          }
        }
      }
    },
    "trick.inversion-order.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inversions: the order"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inversés : l'ordre"
          }
        }
      }
    },
    "trick.inversion-order.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflips, frontflips and corks are in this app. They are advanced, and they are done with a coach. The order does not change because a video looks easy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les backflips, frontflips et corks sont dans cette app. Ils sont avancés, et ils se font avec un coach. L'ordre ne change pas parce qu'une vidéo a l'air facile."
          }
        }
      }
    },
    "trick.inversion-order.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app replaces a person who can say 'not today'. Listen to them. Emergency numbers stay in the phone: 144 and 1414 in Switzerland, 112 in France."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app ne remplace quelqu'un qui peut dire « pas aujourd'hui ». Écoute cette personne. Les numéros restent dans le téléphone : 144 et 1414 en Suisse, 112 en France."
          }
        }
      }
    },
    "trick.inversion-order.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First the trampoline, with a coach or a trained spotter who can catch you. You learn to set, to spot the landing, and to bail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'abord le trampoline, avec un coach ou un pareur formé qui peut te rattraper. Tu apprends le set, à voir la réception, et à abandonner."
          }
        }
      }
    },
    "trick.inversion-order.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then a water ramp or an airbag, still with that coach. Snow is not the place to discover the rotation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite un tremplin d'eau ou un airbag, toujours avec ce coach. La neige n'est pas l'endroit où tu découvres la rotation."
          }
        }
      }
    },
    "trick.inversion-order.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow comes last: a jump you already straight-air cleanly, a steep landing, a coach who says go, speed checked, nobody below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La neige en dernier : un saut que tu passes déjà droit et propre, une réception pentue, un coach qui dit oui, la vitesse vérifiée, personne en dessous."
          }
        }
      }
    },
    "trick.inversion-order.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you hesitate on the approach, you ride out. The decision is made before you drop, not on the lip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu hésites dans l'approche, tu passes droit. La décision se prend avant de partir, pas sur la lèvre."
          }
        }
      }
    },
    "trick.inversion-order.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many coaches will not teach this until the basics are boring and you are old enough for their program. That is the program, not an insult."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de coachs n'enseigneront pas ça tant que les bases ne sont pas ennuyeuses, et pas avant l'âge de leur programme. C'est le programme, pas une insulte."
          }
        }
      }
    },
    "trick.inversion-order.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Film the basics (straight air, 180, 360). Progress shows there before any magazine trick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme tes bases (saut droit, 180, 360). Le progrès se voit là, avant les figures de magazine."
          }
        }
      }
    },
    "trick.inversion-order.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fear is information. If you don't want to go, you don't owe anyone a jump."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La peur est une info. Si tu n'as pas envie, tu ne dois rien à personne."
          }
        }
      }
    },
    "trick.backflip.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflip"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backflip"
          }
        }
      }
    },
    "trick.backflip.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backward flip. Expert, and only with supervision. Trampoline with a spotter, then water or an airbag, then snow with a coach. Never the first try on a resort kicker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flip vers l'arrière. Expert, et seulement avec quelqu'un qui surveille. Trampoline avec un pareur, puis eau ou airbag, puis neige avec un coach. Jamais le premier essai sur un kick de station."
          }
        }
      }
    },
    "trick.backflip.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common mistakes: looking at the sky and never spotting, flipping late, reaching with the hands, under-rotating onto the neck, trying it tired or to impress someone. Bail-out: if you are not around, do not stick the arms. Chin in. Try to take it on the back and hips and slide, then get off the landing. If you are unsure before you leave the lip, do not pop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreurs fréquentes : regarder le ciel sans jamais voir la réception, flipper trop tard, tendre les mains, sous-rotater sur la nuque, le tenter fatigué ou pour impressionner. Abandon : si tu n'es pas autour, tu ne tends pas les bras. Menton rentré. Tu essaies de prendre ça sur le dos et les hanches et de glisser, puis tu sors de la réception. Si tu doutes avant de quitter la lèvre, tu ne pop pas."
          }
        }
      }
    },
    "trick.backflip.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the trampoline, a coach sets the hips and teaches a layout or the tuck they want. You do not invent it from a video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le trampoline, un coach place les hanches et enseigne le layout ou le groupé qu'il veut. Tu ne l'inventes pas depuis une vidéo."
          }
        }
      }
    },
    "trick.backflip.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn to spot: as you leave, the eyes find the landing over the shoulder early. If you only see sky, you are late."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends à spotter : au départ, les yeux trouvent la réception par-dessus l'épaule, tôt. Si tu ne vois que le ciel, tu es en retard."
          }
        }
      }
    },
    "trick.backflip.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The set is up and slightly back, from the pop, not a desperate throw of the head on the lip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le set part vers le haut et un peu en arrière, depuis le pop, pas un jeté désespéré de la tête sur la lèvre."
          }
        }
      }
    },
    "trick.backflip.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bail on the trampoline until it is boring: if the rotation is late, the spotter stops you, or you sit the rotation down. You practice the bail, not only the make."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu abandonnes sur le trampoline jusqu'à ce que ce soit ennuyeux : si la rotation est en retard, le pareur te stoppe, ou tu poses la rotation assis. Tu t'entraînes à abandonner, pas seulement à réussir."
          }
        }
      }
    },
    "trick.backflip.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water ramp or airbag next, same coach, same cues. Count consistent landings there before anyone says the word snow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite tremplin d'eau ou airbag, même coach, mêmes repères. Compte des réceptions régulières là-bas avant que quelqu'un prononce le mot neige."
          }
        }
      }
    },
    "trick.backflip.step.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On snow: helmet and back protector, a jump you straight-air without thinking, steep landing, coach on the side, one rider, speed from a marked start. If any of that is missing, you straight-air it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur neige : casque et dorsale, un saut que tu passes droit sans y penser, réception pentue, coach sur le côté, un seul rider, vitesse depuis un départ marqué. S'il manque un élément, tu passes droit."
          }
        }
      }
    },
    "trick.backflip.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A coach who has never seen you straight-air that jump does not get to say go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coach qui ne t'a pas vu passer ce saut droit n'a pas à dire oui."
          }
        }
      }
    },
    "trick.backflip.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop for the day after one scary attempt. The second one, rattled, is how people get hurt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu arrêtes la journée après un essai qui t'a fait peur. Le deuxième, secoué, c'est comme ça qu'on se blesse."
          }
        }
      }
    },
    "trick.backflip.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age and a club's rules come before this page. If they say not yet, it is not yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'âge et le règlement du club passent avant cette page. S'ils disent pas encore, c'est pas encore."
          }
        }
      }
    },
    "trick.frontflip.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frontflip"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frontflip"
          }
        }
      }
    },
    "trick.frontflip.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A forward flip. The face is what you risk. Same ladder as the backflip: trampoline with a coach, then water or airbag, then snow only with that coach. Harder to spot than a backflip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flip vers l'avant. C'est le visage que tu risques. Même échelle que le backflip : trampoline avec un coach, puis eau ou airbag, puis neige seulement avec ce coach. Plus dur à voir que le backflip."
          }
        }
      }
    },
    "trick.frontflip.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not learn this by 'throwing your head' on a park jump. That is how people land on their face or their neck. A parent or coach decides if you are in a program that teaches it. This page is the order, not a permission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'apprends pas ça en « jetant la tête » sur un saut de park. C'est comme ça qu'on se reçoit sur le visage ou la nuque. Un parent ou un coach décide si tu es dans un programme qui l'enseigne. Cette page est l'ordre, pas une autorisation."
          }
        }
      }
    },
    "trick.frontflip.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the trampoline the coach teaches the set: pop up, a small tuck, eyes finding the landing in front of you, not a dive at the mat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le trampoline le coach enseigne le set : pop vers le haut, un petit groupé, les yeux trouvent la réception devant toi, pas un plongeon vers le tapis."
          }
        }
      }
    },
    "trick.frontflip.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over-rotation onto the face is the usual mistake. The head does not lead. The pop does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sur-rotation sur le visage est l'erreur habituelle. La tête ne mène pas. Le pop mène."
          }
        }
      }
    },
    "trick.frontflip.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice the bail with the spotter: if you are late, you do not reach. You take it on a shoulder and roll, chin tucked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne l'abandon avec le pareur : si tu es en retard, tu ne tends pas les bras. Tu prends ça sur une épaule et tu roules, menton rentré."
          }
        }
      }
    },
    "trick.frontflip.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only move to water or an airbag when the trampoline flip is consistent and the bail is a choice, not a surprise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne passes à l'eau ou à l'airbag que quand le flip au trampoline est régulier et que l'abandon est un choix, pas une surprise."
          }
        }
      }
    },
    "trick.frontflip.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow is a jump you already straight-air, steep landing, coach watching, helmet on. The approach speed is the straight-air speed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La neige, c'est un saut que tu passes déjà droit, réception pentue, coach qui regarde, casque mis. La vitesse d'approche est celle du saut droit."
          }
        }
      }
    },
    "trick.frontflip.step.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the set does not feel there on the lip, you ride it straight. A half-committed frontflip is a face-first landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le set n'est pas là sur la lèvre, tu passes droit. Un frontflip à moitié engagé, c'est une réception sur le visage."
          }
        }
      }
    },
    "trick.frontflip.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cannot spot the landing on the trampoline, you are not ready for airbag, and you are nowhere near snow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne vois pas la réception au trampoline, tu n'es pas prêt pour l'airbag, et tu es très loin de la neige."
          }
        }
      }
    },
    "trick.frontflip.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One clean attempt does not mean five more. Fatigue makes the head dive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un essai propre ne veut pas dire cinq de plus. La fatigue fait plonger la tête."
          }
        }
      }
    },
    "trick.frontflip.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop if you are trying it to match a friend. Their airbag reps are not yours."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête si tu le tentes pour suivre un ami. Ses répétitions sur airbag ne sont pas les tiennes."
          }
        }
      }
    },
    "trick.cork-360.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cork 360"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cork 360"
          }
        }
      }
    },
    "trick.cork-360.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An off-axis 360: the body tilts so the head passes below the feet for a moment. It is not a full flip, and it is still an inversion. Basics of the axis only, with a coach, after clean 360s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 360 désaxé : le corps s'incline et la tête passe un instant sous les pieds. Ce n'est pas un flip complet, et c'est quand même un inversé. Seulement les bases de l'axe, avec un coach, après des 360 propres."
          }
        }
      }
    },
    "trick.cork-360.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cork is not a style you add because a clip looked good. Off-axis plus too little rotation is a shoulder or a neck. Doubles, cork 720s and rodeos are not in this app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cork n'est pas un style que tu ajoutes parce qu'un clip était beau. Désaxé plus pas assez de rotation, c'est une épaule ou une nuque. Les doubles, cork 720 et rodeos ne sont pas dans cette app."
          }
        }
      }
    },
    "trick.cork-360.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prerequisite: 360s you land without fighting, both directions, plus a stable grab. If the 360 is still a throw, you do not add cork."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-requis : des 360 que tu poses sans te battre, des deux côtés, plus un grab stable. Si le 360 est encore un jeté, tu n'ajoutes pas de cork."
          }
        }
      }
    },
    "trick.cork-360.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The axis is learned on a trampoline or an airbag with a coach, not by 'leaning back' on an XL in the park."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'axe s'apprend sur un trampoline ou un airbag avec un coach, pas en « se penchant en arrière » sur un XL du park."
          }
        }
      }
    },
    "trick.cork-360.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pop up first, like a 360. The tilt is small and set by the coach. More axis is not the goal of the first reps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pop vers le haut d'abord, comme un 360. L'inclinaison est petite et placée par le coach. Plus d'axe n'est pas le but des premières répétitions."
          }
        }
      }
    },
    "trick.cork-360.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot the landing. Under-rotation is the common injury: you come down on a shoulder or the upper back, sideways."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vois la réception. La sous-rotation est la blessure fréquente : tu arrives sur une épaule ou le haut du dos, de travers."
          }
        }
      }
    },
    "trick.cork-360.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bail: if you are not around, don't post an arm. Chin in, try to slide on the back, get off the line. If you felt late on the lip, you should have ridden straight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandon : si tu n'es pas autour, tu ne poses pas un bras. Menton rentré, tu essaies de glisser sur le dos, tu sors de la ligne. Si tu te sentais en retard sur la lèvre, tu aurais dû passer droit."
          }
        }
      }
    },
    "trick.cork-360.step.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow only on a small jump you 360 cleanly, with the same coach who saw the airbag reps, and with the landing steep and empty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La neige seulement sur un petit saut que tu 360 proprement, avec le même coach qui a vu les répétitions sur airbag, et une réception pentue et vide."
          }
        }
      }
    },
    "trick.cork-360.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the straight 360 is your proudest trick, keep it. The cork can wait a season."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le 360 droit est ton trick le plus propre, garde-le. Le cork peut attendre une saison."
          }
        }
      }
    },
    "trick.cork-360.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helmet and back protector are on before the first off-axis attempt, including on an airbag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casque et dorsale sont mis avant le premier essai désaxé, y compris sur un airbag."
          }
        }
      }
    }
  },
  "version": "1.0"
}
