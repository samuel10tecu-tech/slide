    "tracking.banner.lowpower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode can stall GPS. Turn it off for a full day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode économie d'énergie peut couper le GPS. Désactive-le pour une journée complète."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsporný režim může zastavit GPS. Vypni ho na celý den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stromsparmodus kann das GPS aussetzen. Schalte ihn für einen ganzen Tag aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de bajo consumo puede parar el GPS. Desactívalo para un día entero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risparmio energetico può fermare il GPS. Spegnilo per una giornata intera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モードはGPSを止めることがある。一日中滑るならオフに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저전력 모드가 GPS를 멈출 수 있어. 하루 종일 탈 때는 꺼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavstrømmodus kan stoppe GPS. Slå det av for en hel dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De energiebesparing kan gps pauzeren. Zet hem uit voor een hele dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb niskiego zużycia energii może wstrzymać GPS. Wyłącz go na cały dzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de poupança pode parar o GPS. Desliga-o para um dia inteiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lågenergiläge kan stoppa GPS. Stäng av det för en hel dag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低电量模式可能让GPS停住。滑一整天就把它关掉。"
          }
        }
      }
    },
    "tracking.banner.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS has gone quiet. Pull the phone out for a second, or wait for open sky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS ne répond plus. Sors le téléphone une seconde, ou attends le ciel ouvert."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS ztichlo. Vytáhni telefon na vteřinu, nebo počkej na volné nebe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das GPS ist still. Hol das Telefon kurz raus oder warte auf freien Himmel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El GPS se ha callado. Saca el teléfono un segundo o espera cielo abierto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il GPS tace. Tira fuori il telefono un secondo, o aspetta cielo aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPSが黙っている。一度出して、空が開けるのを待って。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS가 조용해졌어. 잠깐 꺼내거나 하늘이 트일 때까지 기다려."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS har blitt stille. Ta frem telefonen et sekund, eller vent på åpen himmel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gps is stil. Haal de telefoon een seconde tevoorschijn of wacht op open lucht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS zamilkł. Wyjmij telefon na sekundę albo poczekaj na otwarte niebo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O GPS calou-se. Tira o telemóvel um segundo ou espera céu aberto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS har tystnat. Ta fram telefonen en sekund eller vänta på öppen himmel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS没声音了。把手机拿出来一下，或者等到天空开阔。"
          }
        }
      }
    },
    "tracking.banner.accuracy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
