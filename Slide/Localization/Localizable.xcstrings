    "profile.language.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone permission popups follow the phone language. Everything inside Slide follows this switch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes iOS (position, mouvement) suivent la langue du téléphone. Tout l'intérieur de Slide suit ce choix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotazy iOS jdou jazykem telefonu. Všechno ve Slide jde podle tohoto přepínače."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iPhone-Abfragen folgen der Sprache des Telefons. Alles in Slide folgt diesem Schalter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos de iOS siguen el idioma del teléfono. Todo dentro de Slide sigue este ajuste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste di iOS seguono la lingua del telefono. Tutto dentro Slide segue questa scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの確認は電話の言語。Slideの中はこの切り替えに従う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 확인 창은 휴대폰 언어를 따라. Slide 안은 이 스위치를 따라."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-spørsmålene følger telefonens språk. Alt i Slide følger dette valget."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iOS-vragen volgen de taal van de telefoon. Alles in Slide volgt deze schakelaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytania iOS idą językiem telefonu. Wszystko w Slide idzie za tym przełącznikiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos do iOS seguem a língua do telemóvel. Tudo dentro do Slide segue esta escolha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-rutorna följer telefonens språk. Allt i Slide följer den här knappen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 的权限弹窗跟手机语言。Slide 里面跟这个开关。"
          }
        }
      }
    },
