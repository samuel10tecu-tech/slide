    "trick.frontflip.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A forward flip. The face is what you risk. Same ladder as the backflip: trampoline with a coach, then water or airbag, then snow only with that coach. Harder to spot than a backflip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flip vers l'avant. C'est le visage que tu risques. Même échelle que le backflip : trampoline avec un coach, puis eau ou airbag, puis neige seulement avec ce coach. Plus dur à voir que le backflip."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto vpřed. Riskuješ obličej. Stejný žebřík jako backflip: trampolína s trenérem, pak voda nebo airbag, pak sníh jen s tím trenérem. Hůř se vidí než backflip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorwärtssalto. Du riskierst das Gesicht. Dieselbe Leiter wie beim Backflip: Trampolin mit einem Coach, dann Wasser oder Airbag, dann Schnee nur mit diesem Coach. Schwerer zu sehen als ein Backflip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salto hacia delante. Arriesgas la cara. La misma escalera que el backflip: trampolín con un coach, luego agua o airbag, luego nieve solo con ese coach. Más difícil de ver que un backflip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salto in avanti. Rischi il viso. La stessa scala del backflip: trampolino con un coach, poi acqua o airbag, poi neve solo con quel coach. Più difficile da vedere di un backflip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前向きのフリップ。顔を危険にさらす。バックフリップと同じ階段。コーチとトランポリン、次に水かエアバッグ、雪はそのコーチとだけ。バックフリップより着地が見にくい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 도는 플립. 얼굴을 걸게 돼. 백플립과 같은 계단이야. 코치와 트램펄린, 그다음 물이나 에어백, 눈은 그 코치와만. 백플립보다 착지가 보기 어려워."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et hopp forover. Du risikerer ansiktet. Samme stige som backflippen: trampoline med en trener, så vann eller airbag, så snø bare med den treneren. Vanskeligere å se enn en backflip."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een salto voorover. Je riskeert je gezicht. Dezelfde ladder als de backflip: trampoline met een coach, dan water of airbag, dan sneeuw alleen met die coach. Moeilijker te zien dan een backflip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto w przód. Ryzykujesz twarz. Ta sama drabina co przy backflipie: trampolina z trenerem, potem woda albo airbag, potem śnieg tylko z tym trenerem. Trudniej zobaczyć niż backflip."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um salto para a frente. Arriscas a cara. A mesma escada do backflip: trampolim com um treinador, depois água ou airbag, depois neve só com esse treinador. Mais difícil de ver do que um backflip."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett hopp framåt. Du riskerar ansiktet. Samma stege som backflippen: studsmatta med en coach, sedan vatten eller airbag, sedan snö bara med den coachen. Svårare att se än en backflip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向前翻转。你拿脸去冒险。和后空翻同一级台阶：和教练上蹦床，然后水台或气垫，上雪只能和那位教练。比后空翻更难看清落点。"
          }
        }
      }
    },
    "trick.frontflip.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not learn this by 'throwing your head' on a park jump. That is how people land on their face or their neck. A parent or coach decides if you are in a program that teaches it. This page is the order, not a permission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'apprends pas ça en « jetant la tête » sur un saut de park. C'est comme ça qu'on se reçoit sur le visage ou la nuque. Un parent ou un coach décide si tu es dans un programme qui l'enseigne. Cette page est l'ordre, pas une autorisation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuč se to „házením hlavou” na skoku v parku. Tak se dopadá na obličej nebo na krk. Rodič nebo trenér rozhodne, jestli jsi v programu, který to učí. Tahle stránka je pořadí, ne povolení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lern das nicht, indem du auf einem Parksprung „den Kopf wirfst“. So landet man auf dem Gesicht oder dem Nacken. Ein Elternteil oder ein Coach entscheidet, ob du in einem Programm bist, das das lehrt. Diese Seite ist die Reihenfolge, keine Erlaubnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No lo aprendas «lanzando la cabeza» en un salto del park. Así se aterriza de cara o en el cuello. Un padre o un coach decide si estás en un programa que lo enseña. Esta página es el orden, no un permiso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non impararlo «lanciando la testa» su un salto del park. È così che ci si riceve sul viso o sulla nuca. Un genitore o un coach decide se sei in un programma che lo insegna. Questa pagina è l'ordine, non un permesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パークのジャンプで「頭を投げる」ことで覚えない。そうして顔や首に着地する。親かコーチが、それを教えるプログラムにいるかを決める。このページは順番であって、許可ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파크 점프에서 ‘머리를 던져’ 배우지 마. 그렇게 얼굴이나 목에 착지해. 부모나 코치가 이걸 가르치는 프로그램에 있는지를 정해. 이 페이지는 순서이지, 허가가 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke lær det ved å «kaste hodet» på et parkhopp. Slik lander man på ansiktet eller nakken. En forelder eller en trener avgjør om du er i et program som lærer det bort. Denne siden er rekkefølgen, ikke en tillatelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer dit niet door ‘je hoofd te gooien’ op een parkjump. Zo landt men op het gezicht of de nek. Een ouder of een coach beslist of je in een programma zit dat het leert. Deze pagina is de volgorde, geen toestemming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ucz się tego „rzucając głową” na skoku w parku. Tak ląduje się na twarz albo na kark. Rodzic albo trener decyduje, czy jesteś w programie, który tego uczy. Ta strona to kolejność, nie pozwolenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não aprendas isto «atirando a cabeça» num salto do park. É assim que se aterra de cara ou no pescoço. Um pai ou um treinador decide se estás num programa que o ensina. Esta página é a ordem, não uma autorização."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär dig det inte genom att ”kasta huvudet” på ett parkhopp. Så landar man på ansiktet eller nacken. En förälder eller en coach avgör om du är i ett program som lär ut det. Den här sidan är ordningen, inte ett tillstånd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要靠在公园跳台上“甩头”来学。人就是这样脸着地或脖子着地的。家长或教练决定你是不是在教这个的课程里。这一页是顺序，不是许可。"
          }
        }
      }
    },
    "trick.frontflip.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the trampoline the coach teaches the set: pop up, a small tuck, eyes finding the landing in front of you, not a dive at the mat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le trampoline le coach enseigne le set : pop vers le haut, un petit groupé, les yeux trouvent la réception devant toi, pas un plongeon vers le tapis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na trampolíně trenér učí set: pop nahoru, malé skrčení, oči najdou dopad před tebou, ne skok na žíněnku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Trampolin lehrt der Coach den Set: Pop nach oben, ein kleiner Tuck, die Augen finden die Landung vor dir, kein Kopfsprung auf die Matte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el trampolín el coach enseña el set: pop hacia arriba, un agrupado pequeño, los ojos encuentran la recepción delante de ti, no una zambullida a la colchoneta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul trampolino il coach insegna il set: pop in alto, un piccolo tuck, gli occhi trovano la ricezione davanti a te, non un tuffo sul materasso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランポリンでコーチがセットを教える。上へポップ、小さいタック、目は前の着地を見つける。マットへの飛び込みではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트램펄린에서 코치가 세트를 가르쳐. 위로 팝, 작은 턱, 눈은 앞의 착지를 찾아. 매트로 다이빙이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På trampolinen lærer treneren settet: popp opp, en liten tuck, øynene finner landingen foran deg, ikke et stup mot matten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de trampoline leert de coach de set: pop omhoog, een kleine tuck, de ogen vinden de landing voor je, geen duik naar de mat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na trampolinie trener uczy setu: pop w górę, mały tuck, oczy znajdują lądowanie przed tobą, nie skok na materac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No trampolim o treinador ensina o set: pop para cima, um agrupado pequeno, os olhos encontram a receção à tua frente, não um mergulho no colchão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På studsmattan lär coachen setten: pop uppåt, en liten tuck, ögonen hittar landningen framför dig, inte ett dyk mot mattan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在蹦床上教练教起跳姿态：向上起跳，小团身，眼睛找到你前面的落点，不是往垫子上扎。"
          }
        }
      }
    },
    "trick.frontflip.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over-rotation onto the face is the usual mistake. The head does not lead. The pop does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sur-rotation sur le visage est l'erreur habituelle. La tête ne mène pas. Le pop mène."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetočení na obličej je obvyklá chyba. Hlava nevede. Vede pop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überdrehen aufs Gesicht ist der übliche Fehler. Der Kopf führt nicht. Der Pop führt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasarte y caer de cara es el error habitual. La cabeza no manda. Manda el pop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sovra-rotazione sul viso è l'errore abituale. La testa non guida. Guida il pop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔への回りすぎがいつもの失敗。頭が先導しない。ポップが先導する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼굴로 더 도는 게 흔한 실수야. 머리가 이끌지 않아. 팝이 이끌어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å overrotere på ansiktet er den vanlige feilen. Hodet leder ikke. Poppen leder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overroteren op het gezicht is de gewone fout. Het hoofd leidt niet. De pop leidt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekręcenie na twarz to zwykły błąd. Głowa nie prowadzi. Prowadzi pop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar e cair de cara é o erro habitual. A cabeça não conduz. Conduz o pop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att överrotera på ansiktet är det vanliga misstaget. Huvudet leder inte. Poppen leder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转到脸上是常见错误。不是头在带。是起跳在带。"
          }
        }
      }
    },
    "trick.frontflip.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice the bail with the spotter: if you are late, you do not reach. You take it on a shoulder and roll, chin tucked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne l'abandon avec le pareur : si tu es en retard, tu ne tends pas les bras. Tu prends ça sur une épaule et tu roules, menton rentré."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénuj vzdání se spotterem: jsi-li pozdě, nesaháš. Vezmeš to na rameno a kutálíš se, brada uvnitř."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe den Abbruch mit dem Spotter: wenn du spät bist, greifst du nicht. Du nimmst es auf eine Schulter und rollst, Kinn eingezogen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica abortar con el spotter: si vas tarde, no estiras. Lo tomas en un hombro y ruedas, barbilla metida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati alla rinuncia con il paratore: se sei in ritardo, non allunghi. Lo prendi su una spalla e rotoli, mento dentro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポッターと放棄を練習する。遅ければ手を出さない。肩で受けて転がる。あごは引く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스포터와 포기를 연습해. 늦으면 손을 뻗지 마. 어깨로 받고 굴러. 턱은 넣어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv avbruddet med spotteren: er du sen, strekker du ikke. Du tar det på en skulder og ruller, haken inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen het afbreken met de spotter: ben je laat, dan reik je niet. Je neemt het op een schouder en rolt, kin in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz rezygnację ze spotterem: jeśli jesteś późno, nie sięgasz. Bierzesz to na ramię i się toczysz, broda w środku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treina desistir com o spotter: se estás atrasado, não esticas. Levas isso num ombro e rolas, queixo para dentro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öva avbrottet med spottern: är du sen sträcker du inte. Du tar det på en axel och rullar, hakan in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和保护者练放弃：晚了就不要伸手。用一边肩膀接住并翻滚，下巴收回。"
          }
        }
      }
    },
    "trick.frontflip.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only move to water or an airbag when the trampoline flip is consistent and the bail is a choice, not a surprise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne passes à l'eau ou à l'airbag que quand le flip au trampoline est régulier et que l'abandon est un choix, pas une surprise."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K vodě nebo airbagu až když je flip na trampolíně rovnoměrný a vzdání je volba, ne překvapení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh erst zu Wasser oder Airbag, wenn der Trampolin-Flip gleichmäßig ist und der Abbruch eine Wahl ist, keine Überraschung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa al agua o al airbag solo cuando el flip en el trampolín es regular y abortar es una elección, no una sorpresa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa all'acqua o all'airbag solo quando il flip sul trampolino è regolare e la rinuncia è una scelta, non una sorpresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランポリンのフリップが安定し、放棄が選択であって驚きでなくなってから、水かエアバッグへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트램펄린 플립이 고르고, 포기가 놀람이 아니라 선택일 때 물이나 에어백으로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til vann eller airbag først når flippen på trampolinen er jevn og avbruddet er et valg, ikke en overraskelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga pas naar water of airbag als de flip op de trampoline gelijkmatig is en afbreken een keuze is, geen verrassing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idź do wody albo airbaga dopiero, gdy flip na trampolinie jest równy, a rezygnacja jest wyborem, nie niespodzianką."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só passas à água ou ao airbag quando o flip no trampolim é regular e desistir é uma escolha, não uma surpresa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå till vatten eller airbag först när flippen på studsmattan är jämn och avbrottet är ett val, inte en överraskning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蹦床上的翻转稳定了，放弃是选择而不是意外，才去水台或气垫。"
          }
        }
      }
    },
    "trick.frontflip.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow is a jump you already straight-air, steep landing, coach watching, helmet on. The approach speed is the straight-air speed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La neige, c'est un saut que tu passes déjà droit, réception pentue, coach qui regarde, casque mis. La vitesse d'approche est celle du saut droit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sníh je skok, který už jedeš rovně, strmý dopad, trenér se dívá, helma na hlavě. Rychlost nájezdu je rychlost straight air."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnee ist ein Sprung, den du schon geradeaus fährst, steile Landung, ein Coach, der zuschaut, Helm auf. Das Anlauf-Tempo ist das Straight-Air-Tempo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nieve es un salto que ya haces recto, recepción empinada, coach mirando, casco puesto. La velocidad de aproximación es la del straight air."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La neve è un salto che già fai dritto, ricezione ripida, coach che guarda, casco messo. La velocità di avvicinamento è quella dello straight air."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪は、すでにまっすぐ通せるジャンプ、急な着地、見ているコーチ、ヘルメット。アプローチの速さはストレートエアの速さ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈은 이미 곧게 넘는 점프, 가파른 착지, 보는 코치, 헬멧. 진입 속도는 스트레이트 에어 속도야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snø er et hopp du allerede kjører rett, bratt landing, trener som ser på, hjelm på. Innkjøringsfarten er straight-air-farten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneeuw is een jump die je al rechtdoor rijdt, steile landing, coach die kijkt, helm op. De aanloopsnelheid is de straight-air-snelheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śnieg to skok, który już jedziesz prosto, strome lądowanie, trener patrzy, kask na głowie. Prędkość najazdu to prędkość straight air."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A neve é um salto que já fazes a direito, receção íngreme, treinador a ver, capacete posto. A velocidade de aproximação é a do straight air."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snö är ett hopp du redan åker rakt, brant landning, coach som tittar, hjälm på. Infartsfarten är straight-air-farten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪上是一个你已经能直跳的跳台，陡的落地区，教练看着，头盔戴上。接近速度就是直跳的速度。"
          }
        }
      }
    },
    "trick.frontflip.step.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the set does not feel there on the lip, you ride it straight. A half-committed frontflip is a face-first landing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le set n'est pas là sur la lèvre, tu passes droit. Un frontflip à moitié engagé, c'est une réception sur le visage."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není-li set na hraně, jedeš rovně. Frontflip napůl rozhodnutý je dopad na obličej."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Set an der Lippe nicht da ist, fährst du geradeaus. Ein halb entschiedener Frontflip ist eine Landung auf dem Gesicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el set no está en el labio, pasas recto. Un frontflip a medias es una recepción de cara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il set non c'è sul lip, passi dritto. Un frontflip mezzo deciso è una ricezione sul viso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リップでセットがなければまっすぐ抜ける。中途半端なフロントフリップは顔への着地。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "립에서 세트가 없으면 곧게 넘어가. 반만 결심한 프론트플립은 얼굴 착지야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er settet ikke der på lippen, kjører du rett. En halvt bestemt frontflip er en landing på ansiktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is de set er niet op de lip, dan rijd je rechtdoor. Een halfbesliste frontflip is een landing op je gezicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli setu nie ma na krawędzi, jedziesz prosto. Frontflip w połowie zdecydowany to lądowanie na twarz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o set não está no lábio, passas a direito. Um frontflip meio decidido é uma receção de cara."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finns setten inte på lippen åker du rakt. En halvt besluten frontflip är en landning på ansiktet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唇沿上没有那个起跳姿态，就直着滑过去。半心半意的前空翻是脸先着地。"
          }
        }
      }
    },
    "trick.frontflip.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cannot spot the landing on the trampoline, you are not ready for airbag, and you are nowhere near snow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne vois pas la réception au trampoline, tu n'es pas prêt pour l'airbag, et tu es très loin de la neige."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevidíš-li dopad na trampolíně, nejsi připravený na airbag a jsi daleko od sněhu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Landung auf dem Trampolin nicht siehst, bist du nicht bereit für den Airbag, und sehr weit von Schnee entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no ves la recepción en el trampolín, no estás listo para el airbag y estás muy lejos de la nieve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non vedi la ricezione sul trampolino, non sei pronto per l'airbag e sei molto lontano dalla neve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランポリンで着地が見えなければ、エアバッグの準備はできていない。雪からはずっと遠い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트램펄린에서 착지가 안 보이면 에어백 준비가 안 된 거야. 눈과는 훨씬 멀어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser du ikke landingen på trampolinen, er du ikke klar for airbagen og langt fra snø."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie je de landing niet op de trampoline, dan ben je niet klaar voor de airbag en ver van sneeuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nie widzisz lądowania na trampolinie, nie jesteś gotów na airbag i jesteś daleko od śniegu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não vês a receção no trampolim, não estás pronto para o airbag e estás muito longe da neve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser du inte landningen på studsmattan är du inte redo för airbagen och långt från snö."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在蹦床上看不见落点，你就没准备好气垫，离雪还很远。"
          }
        }
      }
    },
    "trick.frontflip.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One clean attempt does not mean five more. Fatigue makes the head dive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un essai propre ne veut pas dire cinq de plus. La fatigue fait plonger la tête."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden čistý pokus neznamená pět dalších. Únava nechá hlavu padat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sauberer Versuch heißt nicht fünf weitere. Müdigkeit lässt den Kopf abtauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un intento limpio no significa cinco más. El cansancio hace que la cabeza se zambulla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tentativo pulito non vuol dire altri cinque. La fatica fa tuffare la testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一回きれいにできたからといって、あと五回ではない。疲れは頭を潜らせる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 깨끗했다고 다섯 번 더가 아니야. 피로는 머리를 들이밀게 해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett rent forsøk betyr ikke fem til. Tretthet får hodet til å stupe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén schone poging betekent niet nog vijf. Vermoeidheid laat het hoofd duiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna czysta próba nie znaczy pięciu kolejnych. Zmęczenie każe głowie nurkować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tentativa limpa não significa mais cinco. O cansaço faz a cabeça mergulhar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett rent försök betyder inte fem till. Trötthet får huvudet att dyka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次干净不代表再做五次。疲劳会让头往下扎。"
          }
        }
      }
    },
    "trick.frontflip.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop if you are trying it to match a friend. Their airbag reps are not yours."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête si tu le tentes pour suivre un ami. Ses répétitions sur airbag ne sont pas les tiennes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přestaň, když to děláš, abys držel krok s kamarádem. Jeho opakování na airbagu nejsou tvoje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör auf, wenn du es tust, um mit einem Freund mitzuhalten. Seine Wiederholungen auf dem Airbag sind nicht deine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para si lo intentas para seguir a un amigo. Sus repeticiones en el airbag no son las tuyas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermati se lo fai per stare dietro a un amico. Le sue ripetizioni sull'airbag non sono le tue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達に合わせるためにやるならやめる。その人のエアバッグの本数は、あなたの本数ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구를 따라가려고 하면 멈춰. 그 사람의 에어백 반복은 네 것이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp hvis du gjør det for å følge en venn. Repsene deres på airbagen er ikke dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop als je het doet om een vriend bij te houden. Zijn herhalingen op de airbag zijn niet de jouwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestań, jeśli robisz to, żeby dorównać przyjacielowi. Jego powtórzenia na airbagu nie są twoje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pára se o fizeres para acompanhar um amigo. As repetições dele no airbag não são as tuas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluta om du gör det för att hänga med en vän. Hens airbag-reps är inte dina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是为了跟上朋友才试，就停。他在气垫上的次数不是你的。"
          }
        }
      }
    },
