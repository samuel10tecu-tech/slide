    "trick.straight-air.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air is the base of everything else: pop, quiet body, eyes far away."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le saut droit, c'est la base de tout le reste : pop, corps calme, regard loin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air je základ všeho: pop, klidné tělo, oči daleko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight Air ist die Basis für alles andere: Pop, ruhiger Körper, Blick weit weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El straight air es la base de todo lo demás: pop, cuerpo quieto, mirada lejos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo straight air è la base di tutto il resto: pop, corpo fermo, sguardo lontano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレートエアはすべての土台。ポップ、静かな体、遠くを見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트레이트 에어가 나머지 전부의 기초야. 팝, 차분한 몸, 먼 시선."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air er grunnlaget for alt annet: pop, rolig kropp, blikket langt unna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air is de basis van al het andere: pop, rustig lichaam, blik ver weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air to podstawa wszystkiego: pop, spokojne ciało, wzrok daleko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O straight air é a base de tudo o resto: pop, corpo calmo, olhar longe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air är grunden till allt annat: pop, lugn kropp, blicken långt bort."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直跳是其他一切的基础：起跳、身体安静、眼睛看远。"
          }
        }
      }
    },
    "trick.straight-air.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No violent pop on a jump you don't know. Roll it almost flat first, then add a little air."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de pop violent sur un kick que tu ne connais pas. D'abord tu le roules presque, ensuite tu ajoutes un peu d'air."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný tvrdý pop na skoku, který neznáš. Nejdřív ho skoro převal, pak přidej trochu vzduchu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein harter Pop auf einem Sprung, den du nicht kennst. Roll ihn zuerst fast flach, dann kommt ein bisschen Luft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de pop fuerte en un salto que no conoces. Primero lo ruedas casi plano y luego añades un poco de aire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente pop violento su un salto che non conosci. Prima lo rotoli quasi piatto, poi aggiungi un po' d'aria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知らないジャンプで強いポップはしない。まずほぼ滑って越え、それから少し浮く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모르는 점프에서 세게 팝하지 마. 먼저 거의 굴려 넘기고, 그다음 조금만 띄워."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen hard pop på et hopp du ikke kjenner. Rull det nesten flatt først, så litt luft."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen harde pop op een jump die je niet kent. Rol hem eerst bijna vlak, daarna een beetje lucht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez mocnego popu na skoku, którego nie znasz. Najpierw prawie go przetocz, potem dodaj trochę powietrza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de pop forte num salto que não conheces. Primeiro rolas quase plano e depois acrescentas um pouco de ar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen hård pop på ett hopp du inte kan. Rulla det nästan plant först, lägg sedan till lite luft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不熟悉的跳台不要猛起跳。先几乎贴着滑过去，再加一点高度。"
          }
        }
      }
    },
    "trick.straight-air.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive athletic: ankles, knees and hips a little bent, hands in front."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive en position athlétique : chevilles, genoux et hanches un peu fléchis, mains devant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přijeď v postoji: kotníky, kolena a boky trochu pokrčené, ruce vpředu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm sportlich an: Knöchel, Knie und Hüften etwas gebeugt, Hände vorn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega atlético: tobillos, rodillas y caderas un poco flexionados, manos delante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriva atletico: caviglie, ginocchia e anche un po' piegate, mani davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運動の姿勢で入る。足首・膝・腰を少し曲げ、手は前。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 자세로 들어와. 발목, 무릎, 엉덩이를 조금 굽히고 손은 앞에."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom atletisk: ankler, knær og hofter litt bøyd, hendene foran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom atletisch aan: enkels, knieën en heupen iets gebogen, handen voor je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dojeżdżaj sportowo: kostki, kolana i biodra lekko ugięte, ręce z przodu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chega atlético: tornozelos, joelhos e ancas um pouco fletidos, mãos à frente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom fram atletiskt: vrister, knän och höfter lite böjda, händerna framför."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以运动姿势进入：脚踝、膝盖和髋稍微弯曲，手在前面。"
          }
        }
      }
    },
    "trick.straight-air.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the end of the landing, not your tips."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde la fin de la réception, pas tes spatules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívej se na konec dopadu, ne na špičky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau auf das Ende der Landung, nicht auf die Spitzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el final de la recepción, no las puntas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la fine della ricezione, non le punte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着地の終わりを見る。板の先ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착지 끝을 봐. 스키 끝이 아니야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på slutten av landingen, ikke på tuppene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk naar het eind van de landing, niet naar je tips."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz na koniec lądowania, nie na dzioby."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha o fim da receção, não as pontas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta på slutet av landningen, inte på spetsarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看落地区的尽头，不要看板头。"
          }
        }
      }
    },
    "trick.straight-air.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the lip, push down (the pop) and let the skis come with you. Don't throw the shoulders back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la lèvre, tu pousses vers le bas (le pop) et tu laisses les skis monter avec toi. Tu ne jettes pas les épaules en arrière."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na hraně tlačíš dolů (pop) a necháš lyže jet s sebou. Neházej ramena dozadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der Lippe drückst du nach unten (der Pop) und lässt die Ski mitkommen. Wirf die Schultern nicht nach hinten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el labio empujas hacia abajo (el pop) y dejas que los esquís suban contigo. No eches los hombros atrás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul lip spingi in basso (il pop) e lasci salire gli sci con te. Non lanci le spalle indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リップで下へ押す（ポップ）。スキーは一緒に上がる。肩を後ろに投げない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "립에서 아래로 밀어(팝). 스키는 같이 올라오게. 어깨를 뒤로 던지지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På lippen trykker du ned (poppen) og lar skiene følge med. Ikke kast skuldrene bakover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de lip duw je omlaag (de pop) en laat je de ski’s meekomen. Gooi je schouders niet naar achteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na krawędzi pchasz w dół (pop) i pozwalasz nartom jechać z tobą. Nie rzucaj ramion do tyłu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No lábio empurras para baixo (o pop) e deixas os esquis subirem contigo. Não atiras os ombros para trás."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På lippen trycker du nedåt (poppen) och låter skidorna följa med. Kasta inte axlarna bakåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在唇沿向下推（pop），让雪板跟着你起来。不要把肩膀往后甩。"
          }
        }
      }
    },
    "trick.straight-air.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the air, soft knees, skis parallel, weight in the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En l'air, genoux souples, skis parallèles, poids au milieu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve vzduchu: měkká kolena, lyže rovnoběžně, váha uprostřed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Luft: weiche Knie, parallele Ski, Gewicht in der Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el aire: rodillas blandas, esquís paralelos, peso en el centro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In aria: ginocchia morbide, sci paralleli, peso al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空中は膝を柔らかく、スキーは平行、体重は真ん中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공중에서는 무릎을 부드럽게, 스키는 평행, 무게는 가운데."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I lufta: myke knær, ski parallelle, vekten i midten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de lucht: zachte knieën, ski’s parallel, gewicht in het midden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W powietrzu: miękkie kolana, narty równolegle, ciężar w środku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No ar: joelhos moles, esquis paralelos, peso no meio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I luften: mjuka knän, skidor parallella, vikten i mitten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空中：膝盖放松，雪板平行，重心在中间。"
          }
        }
      }
    },
    "trick.straight-air.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both skis touch first, then you flex to absorb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu touches en premier avec les deux skis, puis tu plies pour absorber."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív se dotknou obě lyže, pak pokrčíš, abys pohltil náraz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Ski berühren zuerst, dann beugst du, um abzufedern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero tocan los dos esquís y luego flexionas para absorber."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccano prima entrambi gli sci, poi pieghi per assorbire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に両方のスキーが着く。それから曲げて吸収する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 스키가 먼저 닿고, 그다음 굽혀서 흡수해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge skiene treffer først, så bøyer du for å ta imot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide ski’s raken eerst, daarna buig je om te absorberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dotykają obie narty, potem uginasz, żeby zamortyzować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois esquis tocam primeiro e depois fletes para absorver."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda skidorna tar först, sedan böjer du för att dämpa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两只雪板先着地，然后弯曲来缓冲。"
          }
        }
      }
    },
    "trick.straight-air.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you leave backwards, your eyes and hips stayed on the lip. Look far ahead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu pars en arrière, c'est souvent le regard et les hanches qui sont restés sur le kick. Regarde loin devant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když odjíždíš dozadu, oči a boky zůstaly na hraně. Dívej se daleko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du nach hinten weggehst, sind Blick und Hüften an der Lippe geblieben. Schau weit voraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sales hacia atrás, la mirada y las caderas se quedaron en el labio. Mira lejos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se parti all'indietro, sguardo e anche sono rimasti sul lip. Guarda lontano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろに抜けるときは、目と腰がリップに残っている。遠くを見て。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤로 빠지면 시선과 엉덩이가 립에 남은 거야. 멀리 봐."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du drar bakover, ble blikket og hoftene på lippen. Se langt frem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je achterover gaat, bleven blik en heupen op de lip. Kijk ver vooruit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli odjeżdżasz do tyłu, wzrok i biodra zostały na krawędzi. Patrz daleko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sais para trás, o olhar e as ancas ficaram no lábio. Olha longe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du lämnar bakåt stannade blicken och höfterna på lippen. Titta långt fram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果往后飞出去，是眼睛和髋还留在唇沿。看远一点。"
          }
        }
      }
    },
    "trick.straight-air.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Film yourself from the side. You'll see a broken waist immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme-toi de côté. Tu verras tout de suite si tu es cassé à la taille."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Natoč se ze strany. Zlomený pas uvidíš hned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Film dich von der Seite. Eine gebrochene Taille siehst du sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grábate de lado. Una cintura rota se ve al momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmati di lato. Una vita spezzata si vede subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横から撮る。腰が折れているのはすぐ分かる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆에서 찍어. 허리가 꺾인 건 바로 보여."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Film deg fra siden. En brukket midje synes med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Film jezelf van opzij. Een gebroken taille zie je meteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj się z boku. Złamana talia widać od razu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Filma-te de lado. Uma cintura partida vê-se logo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filma dig från sidan. En bruten midja syns direkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧面拍自己。腰折了会马上看见。"
          }
        }
      }
    },
    "trick.landing.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Landing"
          }
        },
        "fr": {
          "stringUnit": {
