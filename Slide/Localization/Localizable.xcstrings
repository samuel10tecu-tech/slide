          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen dag. Een speld verschijnt als je een spoor opslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze bez dnia. Pinezka pojawi się, gdy zapiszesz ślad."
