    "trick.three-sixty.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full turn. You land the way you left. It needs a clean 180 both ways."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour complet. Tu poses dans le sens de départ. Ça demande un 180 propre des deux côtés."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celá otáčka. Dopadneš tak, jak jsi vyjel. Potřebuješ čistou 180 na obě strany."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ganze Drehung. Du landest so, wie du gestartet bist. Dafür brauchst du eine saubere 180 in beide Richtungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giro completo. Aterrizas como saliste. Hace falta un 180 limpio en ambos sentidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giro intero. Atterri come sei partito. Serve un 180 pulito da entrambi i lati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一回転。出た向きで着く。両方向の180が決まっていることが条件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 바퀴. 나간 방향으로 착지해. 양쪽 180이 깨끗해야 해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En hel omdreining. Du lander som du dro. Det krever en ren 180 begge veier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hele draai. Je landt zoals je vertrok. Daarvoor moet de 180 beide kanten op schoon zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny obrót. Lądujesz tak, jak wyjechałeś. Potrzebujesz czystego 180 w obie strony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma volta inteira. Aterras como saíste. Precisas de um 180 limpo nos dois sentidos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett helt varv. Du landar som du lämnade. Det kräver en ren 180 åt båda hållen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转一整圈。按出发的方向落地。两个方向的 180 都要干净。"
          }
        }
      }
    },
    "trick.three-sixty.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No 360 on an M until the 360 on an S is calm, one direction, ten times in a row."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de 360 sur un M tant que le 360 sur un S est calme, dans un seul sens, dix fois de suite."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná 360 na M, dokud 360 na S není klidná, jeden směr, desetkrát za sebou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine 360 auf einem M, solange die 360 auf einem S nicht ruhig ist, eine Richtung, zehnmal hintereinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de 360 en un M hasta que la 360 en un S esté tranquila, un sentido, diez veces seguidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente 360 su un M finché la 360 su un S non è calma, un solo senso, dieci volte di fila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sで360が一方向に十回連続で落ち着くまで、Mではやらない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "S에서 360이 한 방향으로 열 번 연속 차분하기 전에는 M에서 하지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen 360 på et M før 360 på et S er rolig, én vei, ti ganger på rad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen 360 op een M tot de 360 op een S rustig is, één kant, tien keer achter elkaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadnego 360 na M, póki 360 na S nie jest spokojne, jeden kierunek, dziesięć razy z rzędu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de 360 num M enquanto a 360 num S não estiver calma, um sentido, dez vezes seguidas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen 360 på ett M förrän 360 på ett S är lugn, ett håll, tio gånger i rad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 S 上、一个方向、连续十次都平静之前，不要在 M 上做 360。"
          }
        }
      }
    },
    "trick.three-sixty.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small jump, straight-air speed, pop up before you spin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit kick, vitesse de saut droit, pop vers le haut avant de tourner."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malý skok, rychlost straight air, nejdřív pop nahoru, pak rotace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner Sprung, Tempo eines Straight Air, erst nach oben poppen, dann drehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto pequeño, velocidad de straight air, pop hacia arriba antes de girar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto piccolo, velocità da straight air, pop in alto prima di girare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さいジャンプ、ストレートエアの速さ。回る前に上へポップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 점프, 스트레이트 에어 속도. 돌기 전에 위로 팝."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lite hopp, straight-air-fart, popp opp før du spinner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine jump, snelheid van een straight air, eerst omhoog poppen, dan draaien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały skok, prędkość straight air, najpierw pop w górę, potem obrót."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto pequeno, velocidade de straight air, pop para cima antes de rodar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Litet hopp, straight-air-fart, poppa upp innan du snurrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小跳台，直跳的速度。先向上起跳，再转。"
          }
        }
      }
    },
    "trick.three-sixty.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head first, then shoulders, then hips. The skis follow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tête part en premier, puis les épaules, puis les hanches. Les skis suivent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív hlava, pak ramena, pak boky. Lyže jdou za nimi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst der Kopf, dann die Schultern, dann die Hüften. Die Ski folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero la cabeza, luego los hombros, luego las caderas. Los esquís siguen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima la testa, poi le spalle, poi le anche. Gli sci seguono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に頭、次に肩、その次に腰。スキーはついてくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 머리, 그다음 어깨, 그다음 엉덩이. 스키가 따라와."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Først hodet, så skuldrene, så hoftene. Skiene følger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst het hoofd, dan de schouders, dan de heupen. De ski’s volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw głowa, potem ramiona, potem biodra. Narty idą za nimi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro a cabeça, depois os ombros, depois as ancas. Os esquis seguem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Först huvudet, sedan axlarna, sedan höfterna. Skidorna följer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先头，再肩膀，再髋。雪板跟着。"
          }
        }
      }
    },
    "trick.three-sixty.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a spot on the landing and find it again at the end of the turn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère un point dans la réception et retrouve-le à la fin du tour."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber bod na dopadu a najdi ho znovu na konci otáčky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such dir einen Punkt auf der Landung und finde ihn am Ende der Drehung wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un punto en la recepción y encuéntralo al final del giro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un punto sulla ricezione e ritrovalo alla fine del giro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着地の一点を決めて、回転の終わりにそれを見つける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착지의 한 점을 정하고, 회전이 끝날 때 다시 찾아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et punkt i landingen og finn det igjen på slutten av omdreiningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een punt op de landing en vind het terug aan het eind van de draai."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz punkt na lądowaniu i znajdź go znowu na końcu obrotu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um ponto na receção e encontra-o no fim da volta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en punkt på landningen och hitta den igen i slutet av varvet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在落地区选一个点，转完再找到它。"
          }
        }
      }
    },
    "trick.three-sixty.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the skis together. A trailing ski kills the spin, or finishes it too early."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les skis groupés. Un ski qui traîne coupe la rotation… ou la finit trop tôt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drž lyže u sebe. Lyže, která táhne, zabije rotaci, nebo ji skončí moc brzy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt die Ski zusammen. Ein nachziehender Ski killt die Drehung oder beendet sie zu früh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén los esquís juntos. Un esquí que se queda atrás mata el giro o lo acaba demasiado pronto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni gli sci insieme. Uno sci che resta indietro uccide la rotazione, o la finisce troppo presto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーはそろえる。遅れるスキーは回転を殺すか、早く終わらせる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스키를 모아. 끌리는 스키는 회전을 죽이거나 너무 일찍 끝내."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold skiene sammen. En hengende ski dreper spinnet, eller avslutter det for tidlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de ski’s bij elkaar. Een achterblijvende ski doodt de draai of maakt hem te vroeg af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj narty razem. Narta, która zostaje, zabija obrót albo kończy go za wcześnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os esquis juntos. Um esqui que fica para trás mata a rotação ou acaba-a cedo demais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll skidorna ihop. En släpande skida dödar snurren eller avslutar den för tidigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪板靠在一起。拖在后面的那只雪板会杀掉旋转，或者让它结束得太早。"
          }
        }
      }
    },
    "trick.three-sixty.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block the upper body when you see the slope again, and land in the middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque le haut du corps quand tu revois la piste, et pose-toi au milieu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj trup, když znovu uvidíš svah, a dopadni uprostřed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Block den Oberkörper, wenn du die Piste wieder siehst, und lande in der Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el torso cuando vuelvas a ver la pista y aterriza en el centro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca il busto quando rivedi la pista e atterra al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "斜面がまた見えたら上半身を止め、真ん中で着く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬로프가 다시 보이면 상체를 막고, 가운데로 착지해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokker overkroppen når du ser løypa igjen, og land i midten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkeer het bovenlijf als je de piste weer ziet, en land in het midden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj tułów, gdy znowu widzisz stok, i ląduj na środku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o tronco quando vires a pista outra vez e aterra no meio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockera överkroppen när du ser pisten igen och landa i mitten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次看见坡面时锁住上身，落在中间。"
          }
        }
      }
    },
    "trick.three-sixty.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under-rotating is normal at first. Add the head, not a violent shoulder throw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-tourner est normal au début. Tu ajoutes la tête, pas un jeté d'épaule violent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedotočení je na začátku normální. Přidáš hlavu, ne prudký hod ramenem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterdrehen ist am Anfang normal. Du nimmst den Kopf dazu, keinen heftigen Schulterwurf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedarte corto es normal al principio. Añade la cabeza, no un lanzamiento violento de hombro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto-ruotare è normale all'inizio. Aggiungi la testa, non un lancio violento di spalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初は回転不足が普通。頭を足す。肩を強く投げない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음에는 덜 도는 게 정상이야. 머리를 더해. 어깨를 세게 던지지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å underrotere er normalt i starten. Legg til hodet, ikke et hardt skulderkast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderroteren is in het begin normaal. Voeg het hoofd toe, geen harde schouderworp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedokręcanie na początku jest normalne. Dodajesz głowę, nie gwałtowny rzut ramieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficar curto é normal no início. Acrescenta a cabeça, não um lançamento violento de ombro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att underrotera är normalt i början. Lägg till huvudet, inte ett hårt axelkast."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一开始转不够是正常的。加上头，不要猛甩肩膀。"
          }
        }
      }
    },
    "trick.three-sixty.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you over-rotate, you popped late and spun early. Pop first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu sur-tournes, tu as pop trop tard et tourné trop tôt. Pop d'abord."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přetočíš, pop byl pozdě a rotace brzy. Nejdřív pop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du überdrehst, hast du spät gepoppt und früh gedreht. Erst der Pop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te pasas, hiciste pop tarde y giraste pronto. Primero el pop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sovra-ruoti, hai fatto pop tardi e girato presto. Prima il pop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回りすぎるなら、ポップが遅く回転が早い。先にポップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 돌면 팝이 늦고 회전이 이른 거야. 팝이 먼저."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du overroterer, poppet du sent og spant tidlig. Poppen først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je overroteert, popte je laat en draaide je vroeg. Eerst de pop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli przekręcasz, pop był za późno, a obrót za wcześnie. Najpierw pop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se passas, fizeste pop tarde e rodaste cedo. Primeiro o pop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du överroterar poppade du sent och snurrade tidigt. Poppen först."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果转多了，是起跳晚、旋转早。先起跳。"
          }
        }
      }
    },
    "trick.nose-butter.name": {
      "extractionState": "manual",
      "localizations": {
