    "notice.file.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown file. Slide reads GPX, .slide, and older .glisse files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier inconnu. Slide lit le GPX, les .slide, et les anciens .glisse."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neznámý soubor. Slide čte GPX, .slide a starší .glisse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte Datei. Slide liest GPX, .slide und ältere .glisse-Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo desconocido. Slide lee GPX, .slide y los .glisse antiguos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File sconosciuto. Slide legge GPX, .slide e i vecchi .glisse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なファイル。SlideはGPX、.slide、古い.glisseを読む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 파일. Slide는 GPX, .slide, 예전 .glisse를 읽어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukjent fil. Slide leser GPX, .slide og eldre .glisse-filer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbekend bestand. Slide leest GPX, .slide en oudere .glisse-bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieznany plik. Slide czyta GPX, .slide i starsze .glisse."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiro desconhecido. O Slide lê GPX, .slide e os .glisse antigos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
