    "freestyle.pinned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before the park: the rules, the helmet, and how to fall. Read this once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant le park : les règles, le casque, et comment tomber. Lis ça une fois."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před parkem: pravidla, helma a jak padat. Přečti si to jednou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Park: Regeln, Helm und wie man fällt. Lies das einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes del park: las reglas, el casco y cómo caer. Léelo una vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima del park: le regole, il casco e come cadere. Leggilo una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パークの前に：ルール、ヘルメット、転び方。一度読んで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파크 전에: 규칙, 헬멧, 넘어지는 법. 한 번은 읽어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før parken: reglene, hjelmen og hvordan du faller. Les det én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vóór het park: de regels, de helm en hoe je valt. Lees dit één keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed parkiem: zasady, kask i jak upadać. Przeczytaj raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes do park: as regras, o capacete e como cair. Lê isto uma vez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Före parken: reglerna, hjälmen och hur du faller. Läs det en gång."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进公园之前：规则、头盔和怎么摔。读一遍。"
          }
        }
      }
