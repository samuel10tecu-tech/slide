    "trick.japan.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The japan: you grab the front tip, outside, and the knee opens a little. Pretty, and only after a stable mute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le japan : tu attrapes la spatule avant, côté extérieur, et le genou s'ouvre un peu. Joli, mais seulement si le mute est stable."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan: chytíš přední špičku zvenku a koleno se trochu otevře. Hezký, a až po stabilním mute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Japan: du greifst die vordere Spitze außen, und das Knie öffnet sich etwas. Schön, und erst nach einem stabilen Mute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El japan: agarras la punta delantera por fuera y la rodilla se abre un poco. Bonito, y solo después de un mute estable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il japan: prendi la punta davanti all'esterno e il ginocchio si apre un po'. Bello, e solo dopo un mute stabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャパンは前の先を外側でつかみ、膝が少し開く。きれいだが、安定したミュートのあと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재팬은 앞끝을 바깥에서 잡고 무릎이 조금 열려. 예쁘지만, 안정된 뮤트 다음이야."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan: du tar den fremre tuppen på utsiden og kneet åpner seg litt. Pent, og først etter en stabil mute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De japan: je pakt de voorste tip aan de buitenkant en de knie opent een beetje. Mooi, en pas na een stabiele mute."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan: łapiesz przedni dziób od zewnątrz, a kolano otwiera się trochę. Ładny, i dopiero po stabilnym mute."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O japan: agarras a ponta da frente por fora e o joelho abre-se um pouco. Bonito, e só depois de um mute estável."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan: du tar den främre spetsen på utsidan och knät öppnar sig lite. Snyggt, och först efter en stabil mute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan：抓住前板头的外侧，膝盖稍微打开。好看，但要在稳定的 mute 之后。"
          }
        }
      }
    },
    "trick.japan.safety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the japan puts you on the back edge, stop. Go back to the mute until your axis is neutral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le japan te met sur la carre arrière, arrête. Reviens au mute jusqu'à ce que l'axe soit neutre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když tě japan dá na zadní hranu, přestaň. Vrať se k mute, dokud osa není neutrální."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Japan dich auf die hintere Kante setzt, hör auf. Geh zurück zum Mute, bis deine Achse neutral ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el japan te pone en el canto trasero, para. Vuelve al mute hasta que el eje sea neutro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il japan ti mette sulla lamina dietro, fermati. Torna al mute finché l'asse è neutro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャパンで後ろのエッジに乗るならやめる。軸が中立に戻るまでミュートへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재팬이 뒷날에 서게 하면 멈춰. 축이 중립이 될 때까지 뮤트로 돌아가."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis japanen setter deg på bakkanten, stopp. Gå tilbake til muten til aksen er nøytral."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de japan je op de achterkant zet, stop. Ga terug naar de mute tot je as neutraal is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli japan stawia cię na tylnej krawędzi, przestań. Wróć do mute, aż oś będzie neutralna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o japan te põe na aresta de trás, pára. Volta ao mute até o eixo estar neutro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om japanen sätter dig på bakkanten, sluta. Gå tillbaka till muten tills axeln är neutral."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Japan 让你站到后刃上，就停。回到 mute，直到轴线回到中间。"
          }
        }
      }
    },
    "trick.japan.step.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, high calm pop. No spin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut droit, pop haut et calme. Pas de rotation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, vysoký klidný pop. Žádná rotace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight Air, hoher ruhiger Pop. Keine Drehung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, pop alto y tranquilo. Sin giro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, pop alto e calmo. Nessuna rotazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレートエア。高く静かなポップ。回転なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트레이트 에어. 높고 차분한 팝. 회전 없이."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, høy rolig pop. Ingen spinn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, hoge rustige pop. Geen draai."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, wysoki spokojny pop. Bez obrotu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, pop alto e calmo. Sem rotação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight air, hög lugn pop. Ingen snurr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直跳，高而安静的起跳。不转。"
          }
        }
      }
    },
    "trick.japan.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front hand finds the end of the front ski, on the outside."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La main avant va chercher le bout du ski avant, à l'extérieur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přední ruka najde konec přední lyže, zvenku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vordere Hand findet das Ende des vorderen Ski, außen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano delantera encuentra el final del esquí delantero, por fuera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano davanti trova la fine dello sci davanti, all'esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の手が前のスキーの端を外側で見つける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞손이 앞 스키 끝을 바깥에서 찾아."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fremre hånden finner enden av den fremre skien, på utsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voorhand vindt het eind van de voorste ski, aan de buitenkant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przednia ręka znajduje koniec przedniej narty, od zewnątrz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mão da frente encontra o fim do esqui da frente, por fora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den främre handen hittar slutet på den främre skidan, på utsidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前手在外侧找到前雪板的末端。"
          }
        }
      }
    },
    "trick.japan.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front knee opens slightly. The back ski stays close."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le genou avant s'écarte légèrement. Le ski arrière reste proche de l'autre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přední koleno se lehce otevře. Zadní lyže zůstane blízko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vordere Knie öffnet sich leicht. Der hintere Ski bleibt nah."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rodilla delantera se abre un poco. El esquí de atrás se queda cerca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ginocchio davanti si apre un po'. Lo sci dietro resta vicino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の膝が少し開く。後ろのスキーは近くに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞 무릎이 살짝 열려. 뒤 스키는 가까이."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fremre kneet åpner seg litt. Den bakre skien blir nær."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voorste knie opent licht. De achterste ski blijft dichtbij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przednie kolano otwiera się lekko. Tylna narta zostaje blisko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O joelho da frente abre-se um pouco. O esqui de trás fica perto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det främre knät öppnar sig lite. Den bakre skidan stannar nära."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前膝稍微打开。后雪板留在旁边。"
          }
        }
      }
    },
    "trick.japan.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't pull the ski behind you until you lose the horizon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne tires pas le ski dans le dos au point de perdre l'horizon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Netahej lyži za sebe tak, že ztratíš obzor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den Ski nicht so weit hinter dich, dass du den Horizont verlierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tires del esquí detrás de ti hasta perder el horizonte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tirare lo sci dietro di te fino a perdere l'orizzonte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水平線が見えなくなるまでスキーを背中へ引かない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지평선이 안 보일 때까지 스키를 뒤로 당기지 마."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke dra skien bak deg til du mister horisonten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek de ski niet zo ver achter je dat je de horizon kwijtraakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ciągnij narty za siebie tak, że tracisz horyzont."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não puxes o esqui para trás de ti até perderes o horizonte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra inte skidan bakom dig tills du tappar horisonten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把雪板拉到身后直到看不见地平线。"
          }
        }
      }
    },
    "trick.japan.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let go, parallel, land in the middle of the ski."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâche, parallèle, réception au milieu du ski."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusť, rovnoběžně, dopadni na střed lyže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass los, parallel, lande in der Mitte des Ski."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta, paralelo, aterriza en el centro del esquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molla, parallelo, atterra al centro dello sci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離して平行に、スキーの真ん中で着く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "놓고 평행하게, 스키 가운데로 착지해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp, parallelt, land i midten av skien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat los, parallel, land in het midden van de ski."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puść, równolegle, ląduj na środku narty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Larga, paralelo, aterra no meio do esqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp, parallellt, landa i mitten av skidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开，平行，落在雪板中间。"
          }
        }
      }
    },
    "trick.japan.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is a style grab, not a grab to 'go bigger'. The landing matters more than the photo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un grab de style, pas un grab pour « aller plus loin ». La réception compte plus que la photo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to stylový grab, ne grab, abys „šel větší”. Dopad je víc než fotka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Stil-Grab, kein Grab, um „größer zu gehen“. Die Landung zählt mehr als das Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un grab de estilo, no un grab para «ir más grande». La recepción importa más que la foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un grab di stile, non un grab per «andare più grande». La ricezione conta più della foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルのグラブ。「もっと大きく」のためのグラブではない。写真より着地。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일 그랩이야. ‘더 크게’ 가려는 그랩이 아니야. 사진보다 착지가 중요해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en stilgrab, ingen grab for å «gå større». Landingen teller mer enn bildet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is een stijlgrab, geen grab om ‘groter te gaan’. De landing telt meer dan de foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To grab stylu, nie grab, żeby „iść większy”. Lądowanie liczy się bardziej niż zdjęcie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É um grab de estilo, não um grab para «ir maior». A receção conta mais do que a foto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är en stilgrab, ingen grab för att ”gå större”. Landningen räknas mer än fotot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是风格抓板，不是为了“跳更大”。落地比照片重要。"
          }
        }
      }
    },
    "trick.japan.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the other hand low so you don't start a 180 by accident."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde l'autre main basse pour ne pas lancer un 180 sans le vouloir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drž druhou ruku nízko, ať omylem nespustíš 180."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt die andere Hand tief, damit du nicht aus Versehen eine 180 startest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la otra mano baja para no empezar un 180 sin querer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni l'altra mano bassa per non avviare un 180 senza volerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方の手は低く。うっかり180を始めないように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 손은 낮게. 실수로 180을 시작하지 않게."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold den andre hånden lav så du ikke starter en 180 ved et uhell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de andere hand laag zodat je niet per ongeluk een 180 start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj drugą rękę nisko, żeby przypadkiem nie zacząć 180."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a outra mão baixa para não começares um 180 sem querer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll den andra handen låg så du inte startar en 180 av misstag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一只手放低，免得不小心开始一个 180。"
          }
        }
      }
    },
