    "profile.screen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the screen on"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder l'écran allumé"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechat obrazovku zapnutou"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm anlassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar la pantalla encendida"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni lo schermo acceso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面をつけたまま"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 켜 두기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold skjermen på"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scherm aan laten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw ekran włączony"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter o ecrã ligado"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll skärmen tänd"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持屏幕常亮"
          }
        }
      }
    },
    "profile.screen.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while tracking. It drains the battery faster, especially in the cold."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le suivi seulement. Ça vide la batterie plus vite, surtout dans le froid."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen při záznamu. Baterie jde rychleji, hlavně v zimě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur während der Aufzeichnung. Das leert den Akku schneller, besonders in der Kälte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mientras grabas. Gasta la batería más rápido, sobre todo con frío."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo durante il tracciamento. Scarica la batteria più in fretta, soprattutto al freddo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録中だけ。電池は速く減る。寒さでは特に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 중에만. 배터리가 더 빨리 닳아. 추우면 더."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare under sporing. Det tømmer batteriet raskere, særlig i kulda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen tijdens het volgen. Het leegt de batterij sneller, zeker in de kou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko podczas nagrania. Bateria schodzi szybciej, zwłaszcza na mrozie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só durante o registo. Gasta a bateria mais depressa, sobretudo no frio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara under spårning. Det tömmer batteriet snabbare, särskilt i kylan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在记录时。电会掉得更快，冷的时候尤其。"
          }
        }
      }
    },
    "profile.location": {
      "extractionState": "manual",
