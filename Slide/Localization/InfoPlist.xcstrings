            "state": "translated",
            "value": "Slide potrzebuje lokalizacji przez cały wyjazd, także przy zablokowanym ekranie. Twoje dni zostają na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Slide precisa da tua localização durante toda a saída, também com o ecrã bloqueado. Os teus dias ficam neste telemóvel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide behöver din plats under hela åket, även med låst skärm. Dina dagar stannar på den här telefonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide 在整段记录里都需要定位，锁屏时也要。记录只留在这部手机上。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide uses the barometer for altitude and the accelerometer to estimate jump airtime."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide utilise le baromètre pour l'altitude et l'accéléromètre pour estimer le temps de vol des sauts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide používá barometr na výšku a akcelerometr na odhad času ve vzduchu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide nutzt das Barometer für die Höhe und den Beschleunigungssensor für die geschätzte Luftzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide usa el barómetro para la altitud y el acelerómetro para estimar el aire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide usa il barometro per la quota e l'accelerometro per stimare l'aria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Slideは高度に気圧計、ジャンプの滞空推定に加速度センサーを使う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide는 고도에 기압계, 점프 공중 시간 추정에 가속도계를 써."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide bruker barometeret for høyde og akselerometeret for anslått luft."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide gebruikt de barometer voor hoogte en de versnellingsmeter voor geschatte lucht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide używa barometru do wysokości i akcelerometru do szacowanego czasu w powietrzu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Slide usa o barómetro para a altitude e o acelerómetro para estimar o ar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide använder barometern för höjd och accelerometern för uppskattad luft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide 用气压计测高度，用加速度计估计跳跃滞空。"
          }
        }
      }
    },
    "NSSiriUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide answers Siri about today's speed, distance and runs, on this phone only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide répond à Siri sur la vitesse, la distance et les descentes d'aujourd'hui, seulement sur ce téléphone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide odpovídá Siri na rychlost, vzdálenost a sjezdy z dneška, jen v tomto telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide beantwortet Siri zu Tempo, Distanz und Abfahrten von heute, nur auf diesem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide responde a Siri sobre velocidad, distancia y bajadas de hoy, solo en este teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide risponde a Siri su velocità, distanza e discese di oggi, solo su questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Slideは今日の速度・距離・本数をSiriに答えます。この電話の中だけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide가 오늘의 속도, 거리, 활강을 Siri에 답해. 이 휴대폰 안에서만."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide svarer Siri om fart, distanse og nedfarter i dag, bare på denne telefonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide antwoordt Siri over snelheid, afstand en afdalingen van vandaag, alleen op deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide odpowiada Siri o prędkości, dystansie i zjazdach z dziś, tylko na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Slide responde à Siri sobre velocidade, distância e descidas de hoje, só neste telemóvel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide svarar Siri om fart, sträcka och åk idag, bara på den här telefonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide 会用 Siri 回答今天的速度、距离和滑降，只在这台手机上。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
