        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide a besoin de ta position pendant toute la sortie, même écran verrouillé. Tes journées restent dans ce téléphone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide potřebuje polohu po celou jízdu, i se zamčenou obrazovkou. Tvoje dny zůstávají v tomto telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide braucht deinen Ort für die ganze Ausfahrt, auch bei gesperrtem Bildschirm. Deine Tage bleiben auf diesem Telefon."
